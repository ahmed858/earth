                    ],
                },
                main: { // FBX_CAM/MAIN_CAMERA.fbx — the earlier street-level Day orbit (day-v2) — no scene uses it any more
                    fov: 48.0259, // vertical, degrees
                    positionkeys: [
                        [0, [16587.64, 477.72, -3921.79]],
