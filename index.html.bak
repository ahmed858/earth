            /* --------------------------------------- */



            /* The 3D overlay drawn over the renders (config.js UNITS_FBX: one mesh
               per floor or per unit, see FLOOR VOLUMES further down) and the building
               shell that masks it (OCCLUDER_FBX). Leave both empty and the whole 3D
               layer (overlay, 3D view, hide toggle) stays dormant. After replacing
               either file — or a render camera — re-bake the camera keys with
               node tools/bake-camera.js --write  (see README.md). */
            // The project's models (projects.js → models); config.js UNITS_FBX / OCCLUDER_FBX stand in for
            // a project entry that has no `models` at all.
            const THREE_ASSETS = {
                units: PROJECT.models && "units" in PROJECT.models ? PROJECT.models.units || "" : (window.MAAZAR_CONFIG && window.MAAZAR_CONFIG.UNITS_FBX) || "",
                occluder: PROJECT.models && "occluder" in PROJECT.models ? PROJECT.models.occluder || "" : (window.MAAZAR_CONFIG && window.MAAZAR_CONFIG.OCCLUDER_FBX) || "",
            };
            /* 3ds Max writes these files Z-up (GlobalSettings UpAxis = 2) and three's
               FBXLoader does not convert axes, so a Z-up root is turned into the Y-up
               world the baked camera keys live in: (x, y, z) -> (x, z, -y) — the same
               rotation tools/bake-camera.js applies to the camera. config.js
               MODELS_UP_AXIS says which export this is ("Z" or "Y").
               Units, likewise: the world is in centimetres, and the loader only notes
               the file's unit (GlobalSettings UnitScaleFactor — cm per unit: 1 for a
               cm export, 100 for metres) in userData, so a scene exported in metres
               is scaled up here; the bake tool converts the camera the same way. */
            const MODELS_UP_AXIS = String((window.MAAZAR_CONFIG && window.MAAZAR_CONFIG.MODELS_UP_AXIS) || "Y").toUpperCase();
            function applyModelUpAxis(obj) {
                if (MODELS_UP_AXIS === "Z") obj.rotation.x = -Math.PI / 2;
                const unit = Number(obj.userData && obj.userData.unitScaleFactor) || 1;
                if (unit !== 1) obj.scale.multiplyScalar(unit);
                obj.updateMatrixWorld(true);
            }

            let threeScene, threeCamera, threeRenderer;
            let ambientLight = null, dirLight = null;
            let unitsModel = null;
            let overlayHasFloors = false; // the overlay model carries floor volumes (see FLOOR VOLUMES)
            let unitsOverlayHidden = false; // "Hide Units" / "Hide Floors" button state
            let occluderModel = null;
            let occluderSettled = false; // the shell has loaded (or failed to): tidyUnitGeometry waits for it
            let threeReady = false;
            let threeRaycaster = null;
            let threeMouse = null;
            let hoveredUnitMesh = null;
            let unitFocusActive = false; // true while a hover "focus" (dim the rest) is animating

            /* Is the building shell drawn — as an invisible depth mask — under the photo overlay?
               · unit boxes: yes on the exterior orbits (it hides the far-side units), no on a
                 floor scene (the floor's units sit under it)
               · floor volumes: never. Together they are the building's whole mass and sort
                 themselves out (see setupFloorMesh); the one-box shell would only hide the
                 storeys that are set back inside it — the second floor and roof from the rear. */
            function shellMasksOverlay() {
                if (overlayHasFloors) return false;
                return !(SCENES[currentScene] && SCENES[currentScene].unitFloor);
            }

            // The camera the active scene's photos were rendered with (SCENES[*].camera).
            function bakedCamera() {
                const scene = SCENES[currentScene];
                const cam = BAKED_CAMERAS[scene && scene.camera] || BAKED_CAMERAS[Object.keys(BAKED_CAMERAS)[0]];
                if (!cam.byFrame) cam.byFrame = new Map(cam.positionkeys);
                return cam;
            }

            /* The floor volumes only sit on a scene's photos when drawn through the
               camera those photos were rendered with. A scene whose camera is not
               baked yet (no BAKED_CAMERAS entry — the bird's-eye Day until its FBX
               is exported) shows no overlay and ignores hover / click on the
               building; the 3D view, which has no photo to line up with, still works. */
            function sceneOverlayAligned(sceneKey = currentScene) {
                const scene = SCENES[sceneKey];
                return !!(scene && scene.showUnitsOverlay && BAKED_CAMERAS[scene.camera]);
            }
            // Whether the floor volumes are on screen right now (Hide Floors toggle, scene, 3D view).
            function floorsVisible() {
                return !unitsOverlayHidden && (is3DMode || sceneOverlayAligned());
            }
            function syncFloorsVisible() {
                if (unitsModel) unitsModel.visible = floorsVisible();
            }

            function getBackgroundCoverRect() {
                const viewer = document.getElementById("frameViewer");
                const img = document.getElementById("backgroundImage");

                const vw = viewer.clientWidth;
                const vh = viewer.clientHeight;

                // fallback لو الصورة لسه محملتش
                const iw = img.naturalWidth || 2048;
                const ih = img.naturalHeight || 909;

                const imageAspect = iw / ih;

                // نفس حساب object-fit: cover بالظبط
                const scale = Math.max(vw / iw, vh / ih);

                const width = iw * scale;
                const height = ih * scale;

                const left = (vw - width) / 2;
                const top = (vh - height) / 2;

                return {
                    left,
                    top,
                    width,
                    height,
                    aspect: imageAspect,
                };
            }


            /* =========================================================
               3D MODE STATE
            ========================================================= */
            let is3DMode = false;
            let pendingSceneLoad = false; // scene changed while in 3D; fetch on exit
            let orbitControls = null;
            let buildingCenter = null; // world centre of the shell, the orbit pivot

            // Where the camera should pivot: the centre of the occluder's bounding
            // box, dropped to roughly eye-level of the mass rather than its middle so
            // orbiting doesn't feel like circling a floating object.
            function getBuildingCenter() {
                if (buildingCenter) return buildingCenter;
                const source = occluderModel || unitsModel;
                if (!source) return new THREE.Vector3(0, 0, 0);
                const box = new THREE.Box3().setFromObject(source);
                buildingCenter = box.getCenter(new THREE.Vector3());
                buildingCenter.y = box.min.y + (box.max.y - box.min.y) * 0.35;
                return buildingCenter;
            }

            // Radius of the shell's bounding sphere, used to keep the camera outside
            // the building and to scale the zoom limits to whatever model is loaded.
            let _buildingRadius = 0;
            function getBuildingRadius() {
                if (_buildingRadius) return _buildingRadius;
                const source = occluderModel || unitsModel;
                if (!source) return 100;
                const sphere = new THREE.Box3()
                    .setFromObject(source)
                    .getBoundingSphere(new THREE.Sphere());
                _buildingRadius = sphere.radius;
                return _buildingRadius;
            }

            /* Careful: the OrbitControls constructor runs an update() immediately,
               and with its default target of (0,0,0) that update points the camera at
               the world origin -- wiping the baked pose before anyone can read it.
               Callers must therefore capture the camera's orientation BEFORE calling
               this, and hand it in as `target` so the pose can be restored. */
            function ensureOrbitControls(target) {
                if (orbitControls) return orbitControls;
                orbitControls = new THREE.OrbitControls(
                    threeCamera,
                    threeRenderer.domElement,
                );
                if (target) orbitControls.target.copy(target);
                orbitControls.enableDamping = true;
                orbitControls.dampingFactor = 0.08;
                orbitControls.rotateSpeed = 0.5;
                orbitControls.zoomSpeed = 0.9;
                orbitControls.panSpeed = 0.6;
                // Stop the camera dropping under the site; allow going high enough to
                // read the massing from above.
                orbitControls.maxPolarAngle = Math.PI * 0.495;
                orbitControls.enabled = false;
                return orbitControls;
            }

            /* Hand off from the photo orbit to the free camera.
      
               The whole effect depends on NOT moving the camera here: the baked pose
               for the current frame is already the exact pose the photo was rendered
               from, so if we just reveal the model in place, the photo appears to
               become 3D. Pointing OrbitControls' target down the camera's existing
               forward axis (rather than at the building centre) keeps that pose
               untouched -- setting target directly would swing the camera. */
            function enter3DMode() {
                if (is3DMode || !threeReady || !occluderModel) return;
                is3DMode = true;

                const center = getBuildingCenter();

                // Read the baked pose FIRST -- constructing OrbitControls below will
                // immediately re-aim the camera, so this is the last moment the photo's
                // own orientation is still readable.
                const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(
                    threeCamera.quaternion,
                );
                // A shifted lens (see applyLensShift) is level but looks BELOW its axis:
                // the image centre is the axis pitched down by atan(shift · 2·tan(fov/2)).
                // Aim the pivot through the image centre, so the free camera -- which
                // has no shift -- frames the same spot the photo did.
                if (lensShiftApplied) {
                    const pitch = Math.atan(lensShiftApplied * 2 * Math.tan((threeCamera.fov * Math.PI) / 360));
                    const upAxis = new THREE.Vector3(0, 1, 0).applyQuaternion(threeCamera.quaternion);
                    forward.multiplyScalar(Math.cos(pitch)).addScaledVector(upAxis, -Math.sin(pitch)).normalize();
                }
                const distance = threeCamera.position.distanceTo(center);
                // Pivot at the building centre, but projected onto the current view
                // direction so the camera keeps its exact position AND orientation.
                const target = threeCamera.position
                    .clone()
                    .addScaledVector(forward, distance);

                const controls = ensureOrbitControls(target);
                controls.target.copy(target); // also covers the re-entry case
                // The street-level camera looks almost level: let the controls keep
                // that pose instead of lifting the camera to their usual floor.
                controls.maxPolarAngle = Math.max(Math.PI * 0.495, Math.min(Math.PI * 0.4995, forward.angleTo(new THREE.Vector3(0, 1, 0)) + 0.0005));

                threeCamera.near = CAMERA_NEAR;
                threeCamera.far = CAMERA_FAR;
                threeCamera.updateProjectionMatrix();

                // Re-derived once the dolly-zoom lands (see dollyZoomTo).
                controls.minDistance = getBuildingRadius() * 1.1;
                controls.maxDistance = distance * 3;
                controls.enabled = true;
                controls.update();

                setShellMode(); // solid on the exterior, ghosted on a floor view
                applyThree3DTheme(); // match the day/night scene you came from
                applyThreeUnitsFromSheet(); // repaint at 3D-mode opacity
                occluderModel.visible = true; // ignore the per-floor hide from setScene
                syncFloorsVisible(); // the floors show in 3D even when the photo scene has no baked camera
                setPhotoVisible(false);
                applyLensShift(null); // the free camera looks straight down its axis
                // Hand off at the photo's own 20deg lens so the reveal is seamless,
                // then dolly-zoom to a navigable 45deg.
                dollyZoomTo(FREE_FOV);
                update3DModeButton();
            }

            // Clip planes. The FBX models and the baked camera keys are in
            // centimetres and the render camera orbits ~250 m out, so the far plane
            // has to reach kilometres; near stays well above zero so the depth mask
            // (shell vs units) keeps its precision.
            const CAMERA_NEAR = 10, CAMERA_FAR = 400000;
            /* How wide we open up to. This is a trade, not a taste call: holding the
               framing while the lens widens means the camera must travel inward, and
               the wider the target lens the further in it goes. The shell's bounding
               sphere is ~115 across a ~350 viewing distance, so 45deg would park the
               camera at ~149 -- inside the facade, looking at nothing. 30deg lands at
               ~230, safely outside, and still opens the perspective up noticeably. */
            const FREE_FOV = 30;

            /* The signature move. Widening the lens alone would just shrink the
               building and shove it off-centre -- so as the FOV opens, the camera
               also travels toward its target, holding `distance * tan(fov/2)`
               constant. The building stays exactly the same size on screen while the
               perspective deepens around it: you are physically moving in on the
               building without the frame appearing to change. (Hitchcock's vertigo
               shot, used here as the exterior->3D handoff.) */
            let _fovTween = null;
            function dollyZoomTo(targetFov, ms = 1100) {
                if (_fovTween) cancelAnimationFrame(_fovTween);

                const controls = ensureOrbitControls();
                const fromFov = threeCamera.fov;
                const fromDist = threeCamera.position.distanceTo(controls.target);
                // The framing constant we hold: half-height of the view at the target.
                const halfHeight = fromDist * Math.tan((fromFov * Math.PI) / 360);
                const axis = new THREE.Vector3()
                    .subVectors(threeCamera.position, controls.target)
                    .normalize();

                // Never let the inward travel put the camera inside the building. If
                // the requested lens would, ease off the framing constant instead --
                // the building growing slightly is far less broken than the camera
                // ending up in a wall.
                const minSafe = getBuildingRadius() * 1.35;

                const start = performance.now();
                const step = (now) => {
                    const t = Math.min((now - start) / ms, 1);
                    const eased = 1 - Math.pow(1 - t, 3); // ease-out cubic
                    const fov = fromFov + (targetFov - fromFov) * eased;

                    threeCamera.fov = fov;
                    threeCamera.updateProjectionMatrix();
                    // Distance that keeps the subject the same size at this new lens.
                    const dist = Math.max(
                        minSafe,
                        halfHeight / Math.tan((fov * Math.PI) / 360),
                    );
                    threeCamera.position
                        .copy(controls.target)
                        .addScaledVector(axis, dist);
                    controls.update();

                    if (t < 1) {
                        _fovTween = requestAnimationFrame(step);
                    } else {
                        _fovTween = null;
                        /* Re-derive the zoom limits from where we actually ended up.
                           OrbitControls measures distance from its target -- the building
                           CENTRE -- so any distance below the bounding radius is already
                           inside the mass. 1.1x keeps the camera just outside the skin.
                           Going further in needs the interior work (culling the volumes
                           you'd be standing in); until then it's a wash of one unit's
                           colour, so the limit stops short of it deliberately. Use pan to
                           bring a specific facade closer. */
                        controls.minDistance = getBuildingRadius() * 1.1;
                        controls.maxDistance = dist * 3;
                    }
                };
                _fovTween = requestAnimationFrame(step);
            }

            function exit3DMode() {
                if (!is3DMode) return;
                is3DMode = false;

                if (orbitControls) orbitControls.enabled = false;

                threeCamera.near = CAMERA_NEAR;
                threeCamera.far = CAMERA_FAR;
                threeCamera.updateProjectionMatrix();

                setShellMode("mask");
                applyThreeUnitsFromSheet(); // back to the photo-overlay opacity
                syncFloorsVisible(); // hidden again on a photo scene whose camera is not baked

                // Fetch the photos for whatever scene we ended up on (see setScene).
                if (pendingSceneLoad) {
                    pendingSceneLoad = false;
                    loadCurrentScene();
                }
                // Restore the shell's overlay role: a mask behind unit boxes on the
                // exterior views, hidden otherwise (see shellMasksOverlay).
                if (occluderModel) occluderModel.visible = shellMasksOverlay();
                setPhotoVisible(true);
                // The lens has to be back at the baked FOV BEFORE the pose is restored,
                // or the overlay won't line up with the photo it's sitting on.
                if (_fovTween) cancelAnimationFrame(_fovTween);
                _fovTween = null;
                threeCamera.fov = bakedCamera().fov; // the lens this scene's frames were rendered with
                threeCamera.updateProjectionMatrix();
                updateThreeByFrame(currentFrame); // snap back onto the photo's pose
                update3DModeButton();
            }

            function toggle3DMode() {
                is3DMode ? exit3DMode() : enter3DMode();
            }

            /* Small public handle on the 3D view. The camera/scene are script-scoped
               `let`s, so nothing outside this script can reach them otherwise -- and
               other scripts in this file already drive the viewer from outside (see
               the embed helpers near the bottom). Also the only practical way to
               inspect the scene from the console. */
            window.viewer3D = {
                enter: enter3DMode,
                exit: exit3DMode,
                toggle: toggle3DMode,
                get active() { return is3DMode; },
                get camera() { return threeCamera; },
                get scene() { return threeScene; },
                get controls() { return orbitControls; },
                get shell() { return occluderModel; },
                get units() { return unitsModel; },
                explode: (a) => setExplode(a),
                get explodeAmount() { return ex3dAmount; },
            };

            // Cross-fade the photo layer. The 3D canvas sits on top of it, so fading
            // the photo out is what reveals the model.
            function setPhotoVisible(visible) {
                const img = document.getElementById("backgroundImage");
                if (img) {
                    img.style.transition = "opacity 0.6s ease";
                    img.style.opacity = visible ? "1" : "0";
                }
                document.body.classList.toggle("mode-3d", !visible);
            }

            function update3DModeButton() {
                document.body.classList.toggle("is-3d", is3DMode);
                if (!is3DMode) {
                    if (_ex3dTween) { cancelAnimationFrame(_ex3dTween); _ex3dTween = null; }
                    setExplode(0); // collapse on exit
                }
                const btn = document.getElementById("mode3DToggle");
                if (!btn) return;
                btn.classList.toggle("active", is3DMode);
                const label = btn.querySelector("b");
                if (label) label.textContent = is3DMode ? "Exit 3D" : "3D View";
            }

            /* =========================================================
               3D MODE: WHITE MASSING MATERIALS
               The FBX carries no textures or UVs, so the look is built entirely from
               material response: matte white shell, tinted glass at the openings,
               slightly warmer slabs so floor lines read against the walls.
            ========================================================= */

            // Doors and elevator doors are the only openings modelled in the shell,
            // so they're what sells the building as glass-and-concrete rather than a
            // solid lump. Matched on name because there are no materials to key off.
            function isGlassMesh(name) {
                return /door/i.test(name || "");
            }
            function isSlabMesh(name) {
                return /slab/i.test(name || "");
            }

            /* Day / night palette for 3D mode.
      
               "Dark mode" in this app isn't a CSS theme -- it's the `night` scene
               (the sun/moon View Mode buttons just switch scenes). So the 3D view
               follows the same signal: whenever the active scene is the night orbit,
               the model renders dark to match the photo you toggled away from.
      
               The unit colours are deliberately NOT themed. Green/amber/red are the
               availability legend; re-tinting them by time of day would break the one
               thing the model exists to communicate. They're MeshBasic (unlit), so
               they keep full saturation and simply pop harder against a dark shell. */
            const THREE_THEME = {
                day: {
                    wall: 0xf4f2ee,
                    slab: 0xe8e2d9,
                    glass: 0x9fc4d8,
                    ambient: 1.1,
                    dir: 1.2,
                    env: 1.0,
                    exposure: 1.0,
                },
                /* Tuned by eye against the render, not derived: pushed darker than this
                   and the roofs crush to flat black silhouettes with no form at all.
                   The albedo stays a mid taupe (--brand-600 / --brand-700 of the
                   stylesheet) rather than a true dark so the massing still catches
                   enough light to show its shape. */
                night: {
                    wall: 0x625447,
                    slab: 0x4d4238,
                    glass: 0x5f86bd,
                    ambient: 0.55,
                    dir: 0.8,
                    env: 0.55,
                    exposure: 0.95,
                },
            };

            /* Day/Night is a sticky preference, not a property of the active scene.
               Only `exterior` and `night` carry a time of day -- floor scenes are
               neither -- so keying the theme off currentScene would snap the model
               back to daylight the moment you picked a floor. setScene updates this
               only when you actually choose an exterior view. */
            let viewModePref = "exterior";
            function is3DNight() {
                return viewModePref === "night";
            }
            function three3DTheme() {
                return is3DNight() ? THREE_THEME.night : THREE_THEME.day;
            }

            /* The shell is OPAQUE and writes depth. That's what makes the model read
               as a building instead of a transparent jumble: without it, every far
               unit and every interior edge shows through the near faces at once.
               It plays exactly the role it already plays in photo mode -- hiding
               what's behind it -- except here it's also drawn rather than invisible.
      
               polygonOffset pushes the shell very slightly away from the camera in
               depth. The occluder's own per-floor volumes are coincident with the
               unit meshes, so without the nudge the two z-fight and the facade
               flickers between white and unit colour. The offset makes the units
               reliably win on shared surfaces. */
            function makeShellMaterial(name) {
                const theme = three3DTheme();
                if (isGlassMesh(name)) {
                    return new THREE.MeshPhysicalMaterial({
                        color: theme.glass,
                        metalness: 0.0,
                        roughness: 0.08,
                        ior: 1.45,
                        transmission: 0.6,
                        thickness: 4,
                        transparent: true,
                        opacity: 0.75,
                        side: THREE.DoubleSide,
                    });
                }
                const slab = isSlabMesh(name);
                return new THREE.MeshStandardMaterial({
                    color: slab ? theme.slab : theme.wall,
                    metalness: 0.0,
                    roughness: slab ? 0.95 : 0.8,
                    side: THREE.DoubleSide, // FBX normals are unreliable from inside
                    polygonOffset: true,
                    polygonOffsetFactor: 1,
                    polygonOffsetUnits: 1,
                });
            }

            /* The "ghost" shell: translucent and depth-neutral, for 3D floor views.
               A solid shell is right for the exterior, but on a single floor it
               swallows the very units you selected the floor to see -- which is why
               photo mode hides the shell outright on floor views. Ghosting keeps the
               building's outline as context instead of throwing it away. */
            function makeShellGhostMaterial(name) {
                const theme = three3DTheme();
                const slab = isSlabMesh(name);
                return new THREE.MeshStandardMaterial({
                    color: slab ? theme.slab : theme.wall,
                    metalness: 0.0,
                    roughness: slab ? 0.95 : 0.8,
                    transparent: true,
                    opacity: slab ? 0.5 : 0.22,
                    depthWrite: false,
                    side: THREE.DoubleSide,
                });
            }

            /* Pick the shell's look:
                 mask  – invisible depth-only writer, for the photo overlay
                 solid – opaque white massing, for the 3D exterior
                 ghost – translucent, for a 3D floor view
               Passing no mode re-derives the right one for the current state, so
               callers that change scene don't have to know the rules. */
            function setShellMode(mode) {
                if (!occluderModel) return;
                if (!mode) {
                    mode = !is3DMode
                        ? "mask"
                        : SCENES[currentScene] && SCENES[currentScene].unitFloor
                            ? "ghost"
                            : "solid";
                }
                occluderModel.traverse((child) => {
                    if (!child.isMesh || !child.userData.maskMaterial) return;
                    if (mode === "solid") {
                        child.material = child.userData.solidMaterial;
                    } else if (mode === "ghost") {
                        child.userData.ghostMaterial =
                            child.userData.ghostMaterial || makeShellGhostMaterial(child.name);
                        child.material = child.userData.ghostMaterial;
                    } else {
                        child.material = child.userData.maskMaterial;
                    }
                });
            }

            /* Re-tint the 3D view for the active scene's time of day.
      
               The shell materials are built once per mesh and cached, so switching
               Day/Night while already in 3D has to repaint those cached materials in
               place -- rebuilding them here would drop the cache and re-upload every
               material to the GPU on every toggle. Lights, IBL strength and exposure
               move together with the colours; darkening the albedo alone would just
               look like grey plastic under a midday sun. */
            function applyThree3DTheme() {
                if (!threeRenderer || !threeScene) return;
                const theme = three3DTheme();

                if (occluderModel) {
                    occluderModel.traverse((child) => {
                        if (!child.isMesh) return;
                        const slab = isSlabMesh(child.name);
                        const glass = isGlassMesh(child.name);
                        const tint = glass ? theme.glass : slab ? theme.slab : theme.wall;
                        const solid = child.userData.solidMaterial;
                        const ghost = child.userData.ghostMaterial;
                        if (solid && solid.color) solid.color.setHex(tint);
                        if (ghost && ghost.color) ghost.color.setHex(tint);
                    });
                }

                if (ambientLight) ambientLight.intensity = theme.ambient;
                if (dirLight) dirLight.intensity = theme.dir;
                threeScene.environmentIntensity = theme.env;
                threeRenderer.toneMappingExposure = theme.exposure;

                // Drives the viewer backdrop behind the model (see body.mode-3d CSS).
                document.body.classList.toggle("mode-3d-night", is3DNight());
            }

            const HAS_3D_MODELS = !!(THREE_ASSETS.units && THREE_ASSETS.occluder);
            /* The overlay model — floor volumes or unit boxes — is loaded once per file and
               kept: a scene can draw its own (SCENES[*].units, the ground floor's unit boxes)
               instead of config.js UNITS_FBX, and setScene swaps them with useOverlayModel.
               A slow load never installs a model the visitor has already left. */
            let threeLoader = null;     // the FBXLoader, once three is up
            let overlayWanted = "";     // the file the current scene asked for
            const overlayModels = {};   // file → Promise<Group>
            function loadOverlayModel(file) {
                if (!overlayModels[file]) overlayModels[file] = new Promise((resolve, reject) => {
                    threeLoader.load(file, (loaded) => {
                        // A file whose only top-level node is a group (boxes under a ROOF dummy) comes back as
                        // that group itself — with its own transform, and without the file's unit (three unwraps
                        // it). So the axis conversion goes on a wrapper of our own, never on the loaded object;
                        // a metres export of that shape still draws 100× too small — fix-fbx.js --to-cm fixes it.
                        if (loaded.userData.unitScaleFactor == null) console.info("[3d] " + file + ": the file's unit is not known (a lone top-level group hides it) — taken as cm; if it was exported in metres, run tools/fix-fbx.js --to-cm");
                        const obj = new THREE.Group();
                        obj.name = "UNITS";
                        obj.userData.unitScaleFactor = loaded.userData.unitScaleFactor;
                        obj.add(loaded);
                        applyModelUpAxis(obj);
                        // Collected first: the floor set-up adds child meshes, which a
                        // traverse() still in progress would walk into.
                        const overlayMeshes = [];
                        obj.traverse((child) => { if (child.isMesh) overlayMeshes.push(child); });
                        overlayMeshes.forEach((child) => {
                            child.renderOrder = 1;
                            child.userData.isUnit = true;

                            // One mesh per floor (GROUND_SELECT, FIRST_SELECT, …) or one per unit.
                            const floorKey = floorKeyFromMeshName(child.name);
                            if (floorKey) {
                                child.userData.floorKey = floorKey;
                                setupFloorMesh(child);
                                return;
                            }

                            child.material = new THREE.MeshBasicMaterial({
                                color: 0x22c55e,
                                transparent: true,
                                opacity: FLOOR_LOOK.units.rest,
                                depthWrite: false,
                                depthTest: true,
                                side: THREE.DoubleSide,
                                // push the faces back a hair so the box's own outline wins
                                polygonOffset: true,
                                polygonOffsetFactor: 1,
                                polygonOffsetUnits: 1,
                            });

                            // Optional outline (UNIT_OUTLINES). Off by default: the
                            // 8 cm gap between boxes (tidyUnitGeometry) already keeps
                            // neighbours apart, and the lines cluttered the photo.
                            if (UNIT_OUTLINES) {
                                const edgeLine = new THREE.LineSegments(
                                    new THREE.EdgesGeometry(child.geometry, 20),
                                    new THREE.LineBasicMaterial({
                                        color: 0xffffff,
                                        transparent: true,
                                        opacity: FLOOR_LOOK.units.edge,
                                        depthTest: true,
                                        depthWrite: false,
                                    }),
                                );
                                edgeLine.renderOrder = 2;
                                edgeLine.userData.isUnitEdge = true;
                                child.add(edgeLine);
                                child.userData.edgeLine = edgeLine;
                            }
                        });
                        obj.userData.hasFloors = overlayMeshes.some((m) => m.userData.floorKey);
                        resolve(obj);
                    }, undefined, (err) => { console.error("Units FBX load error", file, err); reject(err); });
                });
                return overlayModels[file];
            }
            function useOverlayModel(file) {
                overlayWanted = file;
                if (!threeLoader || !threeScene) return; // three is not up yet: initThreeOverlay picks overlayWanted up
                if (!file) { if (unitsModel) { threeScene.remove(unitsModel); unitsModel = null; } return; }
                loadOverlayModel(file).then((obj) => {
                    if (overlayWanted !== file || unitsModel === obj) return; // the visitor moved on, or nothing to do
                    if (unitsModel) threeScene.remove(unitsModel);
                    if (typeof resetHoveredUnit === "function") resetHoveredUnit();
                    unitsModel = obj;
                    overlayHasFloors = !!obj.userData.hasFloors;
                    syncOverlayToggleLabel();
                    if (occluderModel && !is3DMode) occluderModel.visible = shellMasksOverlay();
                    threeScene.add(unitsModel);
                    // مهم: أول ما الـ FBX يتحمل، طبّق ألوان الشيت والفلاتر عليه
                    applyThreeUnitsFromSheet();
                    syncFloorsVisible(); // the Hide Units toggle, and only on a scene whose camera is baked
                    scheduleThreeFrame(currentFrame);
                }).catch(() => { /* logged by the loader */ });
            }

            function initThreeOverlay() {
                const holder = document.getElementById("threeOverlay");
                if (!HAS_3D_MODELS) {
                    console.info("[3d] no unit/occluder models configured — 3D layer disabled");
                    document.body.classList.add("no-3d");
                    if (holder) holder.style.display = "none";
                    return;
                }
                if (!holder || !window.THREE || !THREE.FBXLoader) {
                    console.error("Three.js or FBXLoader not loaded");
                    return;
                }

                threeScene = new THREE.Scene();

                const coverRect = getBackgroundCoverRect();

                threeCamera = new THREE.PerspectiveCamera(
                    bakedCamera().fov,
                    coverRect.aspect,
                    CAMERA_NEAR,
                    CAMERA_FAR
                );
                threeCamera.up.set(0, 1, 0);

                threeRenderer = new THREE.WebGLRenderer({
                    alpha: true,
                    antialias: true,
                    powerPreference: "high-performance",
                });
                threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
                threeRenderer.setSize(
                    Math.round(coverRect.width),
                    Math.round(coverRect.height),
                    false
                );
                threeRenderer.setClearColor(0x000000, 0);
                // r152+ renamed outputEncoding -> outputColorSpace. ACES tone mapping is
                // what stops the white massing model from blowing out to flat paper in
                // 3D mode; it costs nothing in overlay mode where everything is unlit.
                threeRenderer.outputColorSpace = THREE.SRGBColorSpace;
                threeRenderer.toneMapping = THREE.ACESFilmicToneMapping;
                threeRenderer.toneMappingExposure = 1.0;
                holder.appendChild(threeRenderer.domElement);
                resizeThreeOverlay();
                // Kept on refs so the day/night palette can re-tune them (see
                // applyThree3DTheme). Both are unused while the units are MeshBasic.
                ambientLight = new THREE.AmbientLight(0xffffff, 1.1);
                threeScene.add(ambientLight);
                dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
                dirLight.position.set(200, 500, 300);
                threeScene.add(dirLight);

                // Image-based lighting for 3D mode. RoomEnvironment is generated in
                // code (no HDR to download) and is what gives the untextured white
                // massing its soft gradients instead of a flat matte silhouette.
                const pmrem = new THREE.PMREMGenerator(threeRenderer);
                threeScene.environment = pmrem.fromScene(
                    new THREE.RoomEnvironment(),
                    0.04,
                ).texture;
                pmrem.dispose();

                threeRaycaster = new THREE.Raycaster();
                threeMouse = new THREE.Vector2();

                const loader = new THREE.FBXLoader();

                loader.load(THREE_ASSETS.occluder, (obj) => {
                    occluderModel = obj;
                    occluderModel.name = "OCCLUDER";
                    applyModelUpAxis(occluderModel);
                    occluderModel.traverse((child) => {
                        if (child.isMesh) {
                            child.renderOrder = 0;
                            // Two materials per shell mesh, swapped by setShellMode():
                            //  · "mask"  – the original depth-only writer. Invisible, but it
                            //              fills the depth buffer so units behind a wall stay
                            //              hidden while the photo is what you actually see.
                            //  · "solid" – the white massing look for 3D mode.
                            // Kept side by side (not rebuilt on toggle) so switching modes is
                            // instant and can't drop the depth mask mid-render.
                            child.userData.maskMaterial = new THREE.MeshBasicMaterial({
                                color: 0x000000,
                                colorWrite: false,
                                depthWrite: true,
                                depthTest: true,
                            });
                            child.userData.solidMaterial = makeShellMaterial(child.name);
                            child.material = child.userData.maskMaterial;
                        }
                    });
                    threeScene.add(occluderModel);

                    // Masks the overlay only where that helps (see shellMasksOverlay).
                    occluderModel.visible = shellMasksOverlay();
                    scheduleThreeFrame(currentFrame);
                    occluderSettled = true;
                    applyThreeUnitsFromSheet(); // the floor volumes were waiting for the shell's height
                }, undefined, (err) => {
                    console.error("Occluder FBX load error", err);
                    occluderSettled = true;
                    applyThreeUnitsFromSheet();
                });

                // The overlay model the current scene wants (its own, or config.js UNITS_FBX) — see useOverlayModel.
                threeLoader = loader;
                useOverlayModel(overlayWanted || THREE_ASSETS.units);

                holder.addEventListener("mousemove", onThreeMouseMove);
                holder.addEventListener("mouseleave", resetHoveredUnit);
                holder.addEventListener("click", onThreeClick);
                // Distinguish an orbit drag from a unit click (see onOrbitPointerDown).
                holder.addEventListener("pointerdown", onOrbitPointerDown);
                window.addEventListener("pointermove", onOrbitPointerMove);
                window.addEventListener("pointerup", onOrbitPointerUp);

                window.addEventListener("resize", resizeThreeOverlay);

                threeReady = true;
                updateThreeByFrame(currentFrame);
                renderThreeLoop();
            }

            function resizeThreeOverlay() {
                if (!threeCamera || !threeRenderer) return;

                const holder = document.getElementById("threeOverlay");

                // Note: this cover rect is used in 3D mode too. object-fit:cover guarantees
                // it's at least as large as the viewer in both axes, so it already fills the
                // screen -- and keeping one aspect across both modes is what stops the view
                // from jumping at the moment of handoff.
                const rect = getBackgroundCoverRect();

                // نخلي الـ Three overlay واخد نفس حجم ومكان الصورة بعد object-fit: cover
                holder.style.left = `${rect.left}px`;
                holder.style.top = `${rect.top}px`;
                holder.style.width = `${rect.width}px`;
                holder.style.height = `${rect.height}px`;

                // مهم جدًا: ما تستخدمش aspect الشاشة
                // استخدم aspect الصورة الأصلية اللي الكاميرا اتعملت عليها
                threeCamera.aspect = rect.aspect;
                threeCamera.updateProjectionMatrix();

                threeRenderer.setSize(
                    Math.round(rect.width),
                    Math.round(rect.height),
                    false
                );
            }

            function updateThreeByFrame(frame) {
                if (!threeReady || !threeCamera) return;
                // In 3D mode the user owns the camera; baked frame poses would fight
                // OrbitControls and snap the view back on every scene/frame update.
                if (is3DMode) return;

                const safeFrame = normalizeFrame(frame);
                const cam = bakedCamera();
                const pos = cam.byFrame.get(safeFrame) || cam.byFrame.get(0);

                if (pos) {
                    threeCamera.position.set(pos[0], pos[1], pos[2]);
                }

                const q = cam.rotation_XYZW, qIndex = Math.min(safeFrame, q.length / 4 - 1) * 4; // a still camera has one key
                if (q.length >= qIndex + 4) {
                    threeCamera.quaternion.set(q[qIndex], q[qIndex + 1], q[qIndex + 2], q[qIndex + 3]);
                }

                // Day and Night were shot through different lenses.
                if (threeCamera.fov !== cam.fov) {
                    threeCamera.fov = cam.fov;
                    threeCamera.updateProjectionMatrix();
                }
                applyLensShift(cam);

                threeCamera.updateMatrixWorld(true);
            }

            /* A render made with the renderer's vertical tilt correction (Corona /
               V-Ray "auto vertical tilt") is shot through a LEVEL camera whose lens is
               shifted down, so verticals stay vertical — a tilted camera cannot
               reproduce it (it fits one strip of the image and drifts elsewhere).
               Such a camera is baked level (the pitch removed) with `shift`: the
               fraction of the frame height the image is shifted up by. Drawn here as
               an off-centre projection (three's view offset); the raycaster reads the
               projection matrix, so hover and click follow. */
            let lensShiftApplied = null;
            function applyLensShift(cam) {
                const shift = cam && Number(cam.shift) ? Number(cam.shift) : 0;
                if (shift === lensShiftApplied) return;
                lensShiftApplied = shift;
                if (shift) {
                    const h = 1000, w = threeCamera.aspect * h; // ratios are all that matter; fullWidth/fullHeight keeps the aspect
                    threeCamera.setViewOffset(w, h, 0, shift * h, w, h);
                } else {
                    threeCamera.clearViewOffset();
                }
            }

            let _pendingThreeFrame = null;

            function scheduleThreeFrame(frame) {
                _pendingThreeFrame = frame;
            }

            /* =========================================================
               EXPLODED FLOOR VIEW
               Fans the unit volumes apart along world-up, one step per floor, so
               each level reads as its own plate. The prototype highlight painted by
               applyThreeUnitsFromSheet carries straight through — that is the point
               of the view: you see where Admin / Commercial / Clinic sit on every
               floor at once.
      
               Mechanics: unit meshes are re-parented (Object3D.attach, which
               preserves world transforms) into one Group per floor. The groups are
               children of unitsModel, so traversal, the Hide-Units toggle and
               raycasting all keep working untouched. Offsets are authored in WORLD
               space and converted into unitsModel's local space, because the FBX
               root carries its own axis/scale conversion.
            ========================================================= */
            const EX3D_FLOOR_ORDER = ["LG", "GF", "1", "2", "3", "RF"];
            let ex3dGroups = null;      // [{ key, group, label }] bottom -> top
            let ex3dAmount = 0;         // 0 = collapsed, 1 = fully spread
            let ex3dGap = 0;            // world units between adjacent floors at amount 1

            function ex3dFloorRank(key) {
                const i = EX3D_FLOOR_ORDER.indexOf(String(key));
                return i === -1 ? EX3D_FLOOR_ORDER.length : i;
            }

            function buildFloorGroups() {
                if (ex3dGroups || !unitsModel || (!overlayHasFloors && !allUnits?.length)) return ex3dGroups;

                const byFloor = new Map();
                forEachUnitMesh((mesh) => {
                    const unit = mesh.userData.floorKey ? null : findUnitFromMesh(mesh);
                    if (!unit && !mesh.userData.floorKey) return;
                    const key = mesh.userData.floorKey || String(unit.floor || "");
                    if (!byFloor.has(key)) byFloor.set(key, []);
                    byFloor.get(key).push(mesh);
                });
                if (byFloor.size < 2) return null; // nothing to explode

                unitsModel.updateWorldMatrix(true, false);
                ex3dGroups = [...byFloor.keys()]
                    .sort((a, b) => ex3dFloorRank(a) - ex3dFloorRank(b))
                    .map((key) => {
                        const group = new THREE.Group();
                        group.name = "FLOOR_" + key;
                        unitsModel.add(group);
                        // attach() keeps each mesh exactly where it already is in the world
                        byFloor.get(key).forEach((mesh) => group.attach(mesh));
                        return { key, group };
                    });

                // One floor-height-ish step, derived from the model rather than guessed.
                ex3dGap = Math.max(6, getBuildingRadius() * 0.22);
                return ex3dGroups;
            }

            /* World-space Y displacement expressed in unitsModel's local space. */
            function ex3dLocalOffset(worldY, out) {
                unitsModel.updateWorldMatrix(true, false);
                const inv = new THREE.Matrix4().copy(unitsModel.matrixWorld).invert();
                const origin = new THREE.Vector3(0, 0, 0).applyMatrix4(inv);
                return (out || new THREE.Vector3())
                    .set(0, worldY, 0)
                    .applyMatrix4(inv)
                    .sub(origin);
            }

            function setExplode(amount) {
                amount = Math.max(0, Math.min(1, Number(amount) || 0));
                if (!buildFloorGroups()) return;
                ex3dAmount = amount;

                const off = new THREE.Vector3();
                ex3dGroups.forEach((f, i) => {
                    ex3dLocalOffset(i * ex3dGap * amount, off);
                    f.group.position.copy(off);
                });

                // The shell would swallow the floors the moment they move, so it steps
                // aside while exploded and comes back when they close up. Only while
                // 3D is open: outside it the shell's visibility is scene-driven
                // (mask on exterior, hidden on a floor view) and not ours to set.
                if (occluderModel && is3DMode) occluderModel.visible = amount <= 0.001;
                document.body.classList.toggle("is-exploded", amount > 0.001);

                const range = document.getElementById("ex3dRange");
                if (range && Math.abs(+range.value / 100 - amount) > 0.005) range.value = Math.round(amount * 100);
                const btn = document.getElementById("ex3dToggle");
                if (btn) {
                    const on = amount > 0.001;
                    btn.setAttribute("aria-pressed", on ? "true" : "false");
                    const lbl = document.getElementById("ex3dToggleLabel");
                    if (lbl && lbl.dataset.i18nSkip !== "1") lbl.textContent = on ? "Collapse" : "Exploded view";
                }
                ex3dSyncLabels();
            }

            /* The toggle animates; the slider is direct. Fanning five plates apart
               instantly reads as a glitch rather than a section coming apart. */
            let _ex3dTween = null;
            function animateExplode(to, ms) {
                if (_ex3dTween) cancelAnimationFrame(_ex3dTween);
                const from = ex3dAmount, t0 = performance.now();
                ms = ms || 520;
                (function step(now) {
                    const k = Math.min(1, (now - t0) / ms);
                    // easeInOutCubic
                    const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
                    setExplode(from + (to - from) * e);
                    if (k < 1) _ex3dTween = requestAnimationFrame(step);
                    else _ex3dTween = null;
                })(t0);
            }

            (function wireExplodeBar() {
                const btn = document.getElementById("ex3dToggle");
                const range = document.getElementById("ex3dRange");
                if (btn) btn.addEventListener("click", function () {
                    animateExplode(ex3dAmount > 0.05 ? 0 : 0.6);
                });
                if (range) range.addEventListener("input", function () {
                    if (_ex3dTween) { cancelAnimationFrame(_ex3dTween); _ex3dTween = null; }
                    setExplode(+range.value / 100);
                });
            })();

            /* Floor labels: HTML over the canvas, projected from each group's centre.
               Cheaper and sharper than sprites, and they inherit the site's type. */
            function ex3dLabelLayer() {
                let el = document.getElementById("ex3dLabels");
                if (!el) {
                    el = document.createElement("div");
                    el.id = "ex3dLabels";
                    el.className = "ex3d-labels";
                    (document.getElementById("threeOverlay") || document.body).appendChild(el);
                }
                return el;
            }

            const EX3D_FLOOR_TEXT = { LG: "Lower Ground", GF: "Ground", "1": "First", "2": "Second", "3": "Third", RF: "Roof" };
            /* Built on first use, never at load: window.THREE is assigned by the
               type="module" block above, which runs AFTER every classic script, so
               anything constructed at top level here would throw and take the whole
               script down with it. */
            let _ex3dBox = null, _ex3dPt = null;

            function ex3dSyncLabels() {
                if (!_ex3dBox) { _ex3dBox = new THREE.Box3(); _ex3dPt = new THREE.Vector3(); }
                const layer = ex3dLabelLayer();
                const rotated = document.body.classList.contains("ui-rotated");
                if (!ex3dGroups || ex3dAmount < 0.05 || !is3DMode || rotated) {
                    layer.innerHTML = ""; layer._built = 0; return;
                }

                if (layer._built !== ex3dGroups.length) {
                    layer.innerHTML = ex3dGroups
                        .map((f) => '<span class="ex3d-label">' + (EX3D_FLOOR_TEXT[f.key] || f.key) + "</span>")
                        .join("");
                    layer._built = ex3dGroups.length;
                }
                const rect = threeRenderer.domElement.getBoundingClientRect();
                const nodes = layer.children;
                ex3dGroups.forEach((f, i) => {
                    const node = nodes[i];
                    if (!node) return;
                    _ex3dBox.setFromObject(f.group);
                    if (_ex3dBox.isEmpty()) { node.style.opacity = "0"; return; }
                    _ex3dBox.getCenter(_ex3dPt);
                    _ex3dPt.x = _ex3dBox.min.x; // pin to the left edge of the plate
                    _ex3dPt.project(threeCamera);
                    if (_ex3dPt.z > 1) { node.style.opacity = "0"; return; }
                    node.style.opacity = "1";
                    node.style.left = ((_ex3dPt.x * 0.5 + 0.5) * rect.width) + "px";
                    node.style.top = ((-_ex3dPt.y * 0.5 + 0.5) * rect.height) + "px";
                });
            }

            function renderThreeLoop() {
                requestAnimationFrame(renderThreeLoop);
                if (_pendingThreeFrame !== null) {
                    updateThreeByFrame(_pendingThreeFrame);
                    _pendingThreeFrame = null;
                }
                if (unitFocusActive) stepUnitFocus();
                // Damping means the controls keep easing for a few frames after the
                // pointer stops, so this has to run every frame, not just on input.
                if (is3DMode && orbitControls) orbitControls.update();
                if (ex3dAmount > 0.05 && is3DMode) ex3dSyncLabels();
                if (threeRenderer && threeScene && threeCamera) {
                    threeRenderer.render(threeScene, threeCamera);
                }
            }

            // Hover "focus" effect: ease the hovered unit (hoveredUnitMesh) up to full
            // opacity while every other unit fades to a dim value, so the one under the
            // cursor pops. With nothing hovered, all units ease back to their resting
            // opacity; the animation self-stops once that fade-back has settled.
            const UNIT_FOCUS = { ease: 0.2 }; // the lift / dim of a unit box come from the dashboard (FLOOR_LOOK.units)
            function stepUnitFocus() {
                if (!unitsModel) { unitFocusActive = false; return; }
                const focus = hoveredUnitMesh;
                let moving = false;
                forEachUnitMesh((mesh) => {
                    if (!mesh.material || !mesh.visible) return;
                    const rest = mesh.userData.restOpacity ?? FLOOR_LOOK.units.rest;
                    const restE = mesh.userData.restEdgeOpacity ?? FLOOR_LOOK.units.edge;
                    // A floor covers a whole storey of the photo, so it lifts (and the
                    // others fade) far less than a single unit box does.
                    const onPhoto = mesh.userData.floorKey && !is3DMode;
                    const lift = onPhoto ? FLOOR_LOOK.lift : FLOOR_LOOK.units.lift;
                    const dim = onPhoto ? FLOOR_LOOK.dim : FLOOR_LOOK.units.dim;
                    let tgt, tgtE;
                    if (!focus) {                // easing back to the resting look
                        tgt = rest; tgtE = restE;
                    } else if (mesh === focus) { // the hovered unit / floor lifts up
                        tgt = Math.max(rest, lift); tgtE = (onPhoto ? FLOOR_LOOK.edge : FLOOR_LOOK.units.edge) > 0 ? 1 : 0; // outlines set to 0 stay off on hover too
                    } else {                     // every other one fades back
                        tgt = Math.min(rest, dim); tgtE = Math.min(restE, onPhoto ? FLOOR_LOOK.edgeDim : FLOOR_LOOK.units.edgeDim);
                    }
                    const o = mesh.material.opacity;
                    mesh.material.opacity = o + (tgt - o) * UNIT_FOCUS.ease;
                    if (Math.abs(tgt - mesh.material.opacity) > 0.004) moving = true;
                    const edge = mesh.userData.edgeLine;
                    if (edge && edge.material) {
                        edge.material.opacity += (tgtE - edge.material.opacity) * UNIT_FOCUS.ease;
                    }
                });
                // Once nothing is hovered and the fade-back has finished, stop animating.
                if (!focus && !moving) unitFocusActive = false;
            }

            // Convert a client (screen) point to Three.js NDC for the units canvas.
            // When body.ui-rotated is set, the whole app is CSS-rotated 90deg
            // (transform: rotate(90deg) translateY(-100%)), so getBoundingClientRect()
            // reports an axis-aligned box while the canvas pixels are turned 90deg.
            // Remap the pointer into the canvas's local space, otherwise clicks/hover
            // would hit the wrong units.
            function clientToUnitsNDC(clientX, clientY, out) {
                const rect = threeRenderer.domElement.getBoundingClientRect();
                out = out || new THREE.Vector2();
                if (document.body.classList.contains("ui-rotated")) {
                    out.x = ((clientY - rect.top) / rect.height) * 2 - 1;
                    out.y = ((clientX - rect.left) / rect.width) * 2 - 1;
                } else {
                    out.x = ((clientX - rect.left) / rect.width) * 2 - 1;
                    out.y = -((clientY - rect.top) / rect.height) * 2 + 1;
                }
                return out;
            }

            function onThreeMouseMove(event) {
                // Skip expensive raycasting while the user is rotating frames.
                // Using a JS flag (not CSS pointer-events) so mouseup/click still reach the canvas.
                if (typeof hasDraggedFrame !== "undefined" && hasDraggedFrame) return;
                if (!floorsVisible()) return; // hidden, or a photo scene whose camera is not baked
                if (!unitsModel || !threeCamera || !threeRaycaster) return;

                clientToUnitsNDC(event.clientX, event.clientY, threeMouse);

                threeRaycaster.setFromCamera(threeMouse, threeCamera);

                // Meshes only: a box's outline (LineSegments) is hit first when a plan is seen from below (the basement's
                // camera), and as the hovered object it would be neither focused nor opened.
                const hits = threeRaycaster
                    .intersectObject(unitsModel, true)
                    .filter((hit) => hit.object.isMesh && hit.object.visible && !hit.object.userData.ghosted);

                if (!hits.length) {
                    resetHoveredUnit();
                    hideUnitHoverCard();
                    return;
                }

                const mesh = hits[0].object;

                // A floor volume stands for its whole floor.
                if (mesh.userData.floorKey) {
                    if (hoveredUnitMesh !== mesh) {
                        hoveredUnitMesh = mesh;
                        unitFocusActive = true;
                        document.body.style.cursor = "pointer";
                    }
                    showFloorHoverCard(mesh.userData.floorKey, event);
                    return;
                }

                const unit = findUnitFromMesh(mesh);

                if (!unit) {
                    resetHoveredUnit();
                    hideUnitHoverCard();
                    return;
                }

                if (hoveredUnitMesh !== mesh) {
                    // Focus this unit: the render loop eases it up to full opacity and fades
                    // every other unit down so the hovered one clearly stands out.
                    hoveredUnitMesh = mesh;
                    unitFocusActive = true;
                    document.body.style.cursor = "pointer";
                }

                showUnitHoverCard(unit, event);
            }

            function resetHoveredUnit() {
                // Release focus; the render loop eases every unit back to its resting opacity
                // (unitFocusActive stays on until that fade-back has settled).
                if (hoveredUnitMesh) unitFocusActive = true;
                hoveredUnitMesh = null;
                document.body.style.cursor = "";
                hideFloorHoverCard();
            }

            /* In 3D mode the frame-scrubber's own drag guard (blockClickAfterDrag) never
               arms, because canDragFrame() bows out to OrbitControls. Without this, every
               orbit of the camera ends in a click and pops open whichever unit happened to
               be under the cursor. Track the pointer travel and treat anything past a few
               pixels as a drag, not a click. */
            let orbitPointerStart = null;
            let orbitDidDrag = false;
            const ORBIT_CLICK_SLOP = 5; // px

            function onOrbitPointerDown(event) {
                orbitPointerStart = { x: event.clientX, y: event.clientY };
                orbitDidDrag = false;
            }

            function onOrbitPointerMove(event) {
                if (!orbitPointerStart) return;
                const dx = event.clientX - orbitPointerStart.x;
                const dy = event.clientY - orbitPointerStart.y;
                if (Math.hypot(dx, dy) > ORBIT_CLICK_SLOP) orbitDidDrag = true;
            }

            function onOrbitPointerUp() {
                orbitPointerStart = null;
            }

            function onThreeClick(event) {
                if (typeof blockClickAfterDrag !== "undefined" && blockClickAfterDrag) return;
                if (is3DMode && orbitDidDrag) return;
                if (!floorsVisible()) return; // hidden, or a photo scene whose camera is not baked

                let mesh = hoveredUnitMesh;

                // Touch / mobile: no mousemove before tap so hoveredUnitMesh is null.
                // Raycast directly at the click/tap position instead.
                if (!mesh && threeRaycaster && threeCamera && unitsModel && event) {
                    const cx = (event.changedTouches ? event.changedTouches[0] : event).clientX;
                    const cy = (event.changedTouches ? event.changedTouches[0] : event).clientY;
                    const clickPt = clientToUnitsNDC(cx, cy);
                    threeRaycaster.setFromCamera(clickPt, threeCamera);
                    const hits = threeRaycaster
                        .intersectObject(unitsModel, true)
                        .filter(h => h.object.isMesh && h.object.visible && !h.object.userData.ghosted); // meshes only (see onThreeMouseMove)
                    if (hits.length) mesh = hits[0].object;
                }

                if (!mesh) return;

                if (mesh.userData.floorKey) {
                    const floorScene = floorSceneFor(mesh.userData.floorKey); // a floor with a render of its own opens it
                    if (floorScene) { if (typeof closeUnitsTable === "function") closeUnitsTable(); setScene(floorScene); }
                    else selectFloorFromOverlay(mesh.userData.floorKey);
                    return;
                }

                const unit = findUnitFromMesh(mesh);

                if (unit) {
                    highlightUnitInThree(unit);
                    openUnit(unit);
                } else {
                    console.log(
                        "Clicked mesh — no matching sheet unit:",
                        mesh.name || mesh.parent?.name,
                        mesh
                    );
                }
            }

            function normalizeFrame(frame) {
                return (frame + TOTAL_FRAMES) % TOTAL_FRAMES;
            }

            function showFrame(frame) {
                const normalized = sceneIsStill() ? 0 : snapToUsed(frame); // a still scene has the one frame
                currentFrame = normalized;

                scheduleThreeFrame(currentFrame);

                const cachedImg = frameImages[currentFrame];

                if (cachedImg && cachedImg.complete && cachedImg.naturalWidth > 0) {
                    imageElement.classList.remove("loading-frame");
                    imageElement.src = cachedImg.src;
                    return;
                }

                imageElement.classList.add("loading-frame");

                const img = new Image();

                img.onload = () => {
                    frameImages[normalized] = img;
                    hiresLoaded[normalized] = true; // this fetched the hi-res file
                    lowresLoaded[normalized] = true;

                    if (currentFrame === normalized) {
                        imageElement.src = img.src;

                        requestAnimationFrame(() => {
                            imageElement.classList.remove("loading-frame");
                        });
                    }
                };

                img.onerror = () => {
                    console.warn(`Image load error frame ${normalized}`);
                    imageElement.classList.remove("loading-frame");
                };

                img.src = `${IMAGE_FOLDER}/${normalized}.${FRAME_EXT}${FRAME_QS}`;
            }



            function setButtonsDisabled(disabled) {
                // No buttons now. Keep this function to avoid changing moveSmooth logic.
            }

            function showInteractiveContent() {
                interactiveContent.classList.remove("hidden");
                isInteractiveVisible = true;

                document
                    .querySelectorAll("#interactiveContent video")
                    .forEach((video) => {
                        video.play().catch(() => { });
                    });
            }

            function hideInteractiveContent() {
                hideUnitHoverCard();
                closeUnitSideMenu();
                interactiveContent.classList.add("hidden");
                isInteractiveVisible = false;

                document.getElementById("floorOverlay")?.classList.remove("show");
                document.getElementById("unitModal")?.classList.remove("show");
                document.getElementById("mediaModal")?.classList.remove("show");

                const mediaBody = document.getElementById("mediaBody");
                if (mediaBody) mediaBody.innerHTML = "";

                document
                    .querySelectorAll("#interactiveContent video")
                    .forEach((video) => {
                        video.pause();
                    });

                if (currentHotspot) {
                    currentHotspot.classList.remove("active");
                    currentHotspot = null;
                }
            }

            function moveSmooth(direction) {
                if (!imageElement.src) return;
                if (isAnimating || sceneIsStill()) return;

                // أول ما أتحرك من مكان فيه المحتوى، أخفيه
                if (isInteractiveVisible) {
                    hideInteractiveContent();
                }

                isAnimating = true;
                setButtonsDisabled(true);

                let movedFrames = 0;

                animationTimer = setInterval(() => {
                    movedFrames++;

                    showFrame(currentFrame + direction * FRAME_STEP);

                    if (movedFrames >= BUTTON_STEP) {
                        clearInterval(animationTimer);
                        animationTimer = null;

                        isAnimating = false;
                        setButtonsDisabled(false);

                        // يظهر كل مرة الحركة تخلص وتقف على frame 30
                        if (currentFrame === BUTTON_STEP) {
                            showInteractiveContent();
                        }
                    }
                }, ANIMATION_SPEED);
            }
            function goNext() {
                moveSmooth(1);
            }

            function goPrev() {
                moveSmooth(-1);
            }

            /* =========================================================
       DRAG / SWIPE TO ROTATE FRAMES
    ========================================================= */

            /* =========================================================
               FAST DRAG / SWIPE TO ROTATE FRAMES
            ========================================================= */

            let isDraggingFrame = false;
            let dragLastX = 0;
            let dragLastY = 0;
            let dragAccumulator = 0;
            let blockClickAfterDrag = false;
            let hasDraggedFrame = false;

            const PIXELS_PER_FRAME = 18; // قلل الرقم لو عايزه أسرع: 2 سريع جدًا

            function canDragFrame(event) {
                const target = event.target;

                // In 3D mode the drag belongs to OrbitControls; scrubbing frames would fight
                // it and change the photo nobody is looking at.
                if (is3DMode) return false;

                if (
                    target.closest(".oc-header") ||
                    target.closest(".usp") ||
                    target.closest(".ulp") ||
                    target.closest(".compare-drawer") ||
                    target.closest(".ex3d-bar") ||
                    target.closest("#galleryOverlay") ||
                    target.closest(".wa-panel") ||
                    target.closest(".units-table-drawer") ||
                    target.closest(".units-table-toggle") ||
                    target.closest(".units-table-resize-handle") ||
                    target.closest(".unit-side-menu") ||
                    target.closest(".unit-side-backdrop") ||
                    target.closest(".media-modal") ||
                    target.closest(".unit-modal") ||
                    target.closest(".overlay") ||
                    target.closest("button") ||
                    target.closest("input") ||
                    target.closest("select") ||
                    target.closest("textarea")
                ) {
                    return false;
                }

                return true;
            }

            function updateInteractiveByFrame() {
                if (currentFrame === BUTTON_STEP) {
                    showInteractiveContent();
                } else if (isInteractiveVisible) {
                    hideInteractiveContent();
                }
            }

            function moveFrameFast(deltaX) {
                dragAccumulator += deltaX;

                // One "used" frame spans FRAME_STEP captured frames, so require proportionally
                // more drag distance per step. This keeps the rotation speed identical to when
                // all 120 frames were used.
                const pxPerUsedFrame = PIXELS_PER_FRAME * FRAME_STEP;
                const framesToMove = Math.trunc(Math.abs(dragAccumulator) / pxPerUsedFrame);
                if (framesToMove <= 0) return;

                // Only block clicks once we are sure this is a real drag (a frame actually moved)
                hasDraggedFrame = true;
                blockClickAfterDrag = true;
                document.body.classList.add("is-frame-dragging");

                // سحب شمال = قدام / سحب يمين = ورا
                const direction = dragAccumulator < 0 ? 1 : -1;

                // Step through the USED frames so we never land on a frame we didn't load.
                const usedIndex = Math.round(currentFrame / FRAME_STEP);
                const nextUsedIndex =
                    (((usedIndex + direction * framesToMove) % USED_COUNT) + USED_COUNT) %
                    USED_COUNT;
                const nextFrame = USED_FRAMES[nextUsedIndex];

                // مهم: showFrame تشتغل حتى لو الصورة مش محملة
                showFrame(nextFrame);

                if (typeof updateInteractiveByFrame === "function") {
                    updateInteractiveByFrame();
                }

                dragAccumulator -=
                    Math.sign(dragAccumulator) * framesToMove * pxPerUsedFrame;
            }

            function onFrameDragStart(event) {
                if (sceneIsStill() || loadedCount < sceneUsedCount()) return; // nothing to drag on a still scene
                if (!canDragFrame(event)) return;

                const point = event.touches ? event.touches[0] : event;
                if (!point) return;

                isDraggingFrame = true;
                dragLastX = point.clientX;
                dragLastY = point.clientY;
                dragAccumulator = 0;
                hasDraggedFrame = false;

                // Sync the Three.js canvas size to the current viewport before any drag movement.
                // Handles cases where the layout changed (mobile drawer resize, orientation, etc.)
                // since the last resize event.
                if (typeof resizeThreeOverlay === "function") resizeThreeOverlay();
            }

            function onFrameDragMove(event) {
                if (!isDraggingFrame) return;

                const point = event.touches ? event.touches[0] : event;

                let deltaX = point.clientX - dragLastX;
                let deltaY = point.clientY - dragLastY;

                // When the app is CSS-rotated 90deg for landscape mode, on-screen axes are
                // swapped relative to what the user sees. Remap the deltas so a horizontal
                // swipe (in the rotated view) still spins the panorama and a vertical swipe
                // is still treated as vertical. (Flip the signs if spin feels reversed.)
                if (document.body.classList.contains("ui-rotated")) {
                    const screenDeltaX = deltaX;
                    deltaX = deltaY;
                    deltaY = -screenDeltaX;
                }

                if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > 8) {
                    dragLastX = point.clientX;
                    dragLastY = point.clientY;
                    return;
                }

                if (Math.abs(deltaX) > 1) {
                    if (typeof hideUnitHoverCard === "function") hideUnitHoverCard();
                    if (typeof resetHoveredUnit === "function") resetHoveredUnit();

                    moveFrameFast(deltaX);
                }

                dragLastX = point.clientX;
                dragLastY = point.clientY;

                if (event.cancelable) {
                    event.preventDefault();
                }
            }

            function onFrameDragEnd() {
                const didDragFrame = hasDraggedFrame;

                isDraggingFrame = false;
                dragAccumulator = 0;
                hasDraggedFrame = false;

                document.body.classList.remove("is-frame-dragging");

                if (didDragFrame) {
                    // User stopped on a frame: load its hi-res first, then nearest frames outward.
                    reprioritizeHiresAround(currentFrame);
                }

                // Resync overlay size/position, then let the fade-in CSS transition show it
                requestAnimationFrame(() => {
                    if (typeof resizeThreeOverlay === "function") resizeThreeOverlay();
                    scheduleThreeFrame(currentFrame);
                });

                setTimeout(() => {
                    blockClickAfterDrag = false;
                }, 100);
            }

            window.addEventListener("mousedown", onFrameDragStart);
            window.addEventListener("mousemove", onFrameDragMove);
            window.addEventListener("mouseup", onFrameDragEnd);

            window.addEventListener("touchstart", onFrameDragStart, { passive: false });
            window.addEventListener("touchmove", onFrameDragMove, { passive: false });
            window.addEventListener("touchend", onFrameDragEnd);
            window.addEventListener("touchcancel", onFrameDragEnd);
            /* function preloadFrames() {
              loadedCount = 0;
            
              // حمل أول صورة بس عشان نبدأ الموقع بسرعة
              const firstImg = new Image();
            
              firstImg.onload = () => {
                frameImages[0] = firstImg;
            
                imageElement.src = firstImg.src;
                imageElement.classList.add("frame-ready");
                imageElement.classList.remove("loading-next-frame");
            
                mainLoader.style.display = "none";
                showFrame(0);
            
                // بعد أول صورة، حمل باقي الصور في الخلفية
                preloadRemainingFrames();
              };
            
              firstImg.onerror = () => {
                console.error(`First image load error: ${IMAGE_FOLDER}/0.${FRAME_EXT}${FRAME_QS}`);
            
                mainLoader.style.display = "none";
            
                // حتى لو أول صورة فشلت، حاول تكمل تحميل الباقي
                preloadRemainingFrames();
              };
            
              firstImg.src = `${IMAGE_FOLDER}/0.${FRAME_EXT}${FRAME_QS}`;
            }
             */
            /* function preloadRemainingFrames() {
              for (let i = 1; i < TOTAL_FRAMES; i++) {
                const img = new Image();
            
                img.onload = () => {
                  loadedCount++;
            
                  const percent = Math.round((loadedCount / (TOTAL_FRAMES - 1)) * 100);
                  loadingText.textContent = `Loading ${percent}%`;
            
                  frameImages[i] = img;
                };
            
                img.onerror = () => {
                  loadedCount++;
                  console.warn(`Image load error frame ${i}: ${IMAGE_FOLDER}/${i}.${FRAME_EXT}${FRAME_QS}`);
                };
            
                img.src = `${IMAGE_FOLDER}/${i}.${FRAME_EXT}${FRAME_QS}`;
                frameImages[i] = img;
              }
            }
             */
            /* =========================================================
               PROGRESSIVE LOADING  –  lowres first, hires in background
            ========================================================= */

            const HIRES_CONCURRENT = 4;           // max simultaneous background hi-res fetches

            // These point at the ACTIVE scene's cache (swapped by activateSceneFrameCache).
            let hiresLoaded = new Array(TOTAL_FRAMES).fill(false);
            let lowresLoaded = new Array(TOTAL_FRAMES).fill(false);
            let _hiresImages = new Array(TOTAL_FRAMES).fill(null); // in-flight hi-res Image objects
            let _lowresImages = [];               // in-flight low-res Image objects (for cancellation)
            let _hiresQueue = [];               // ordered list of frame indices to load
            let _hiresActive = 0;                // how many are currently in-flight

            /* ── Per-scene frame cache ──────────────────────────────────────────────
               Every scene keeps its own loaded images + low/hi-res flags, so once a
               floor is downloaded it is NEVER fetched again when you return to it. */
            const sceneFrameCache = {};

            function getSceneFrameCache(key) {
                if (!sceneFrameCache[key]) {
                    sceneFrameCache[key] = {
                        frameImages: new Array(TOTAL_FRAMES).fill(undefined),
                        hiresLoaded: new Array(TOTAL_FRAMES).fill(false),
                        lowresLoaded: new Array(TOTAL_FRAMES).fill(false),
                    };
                }
                return sceneFrameCache[key];
            }

            // Point the live globals at a scene's persistent cache + reset its transient trackers.
            function activateSceneFrameCache(key) {
                const c = getSceneFrameCache(key);
                frameImages = c.frameImages;
                hiresLoaded = c.hiresLoaded;
                lowresLoaded = c.lowresLoaded;
                _hiresImages = new Array(TOTAL_FRAMES).fill(null);
                _lowresImages = [];
                _hiresQueue = [];
                _hiresActive = 0;
                loadedCount = lowresLoaded.reduce((n, v) => n + (v ? 1 : 0), 0);
            }

            // Circular distance between two frame indices on the 120-frame loop.
            function circularFrameDist(a, b) {
                const d = Math.abs(a - b);
                return Math.min(d, TOTAL_FRAMES - d);
            }

            /* Load the ACTIVE scene's frames progressively, fetching ONLY what is not
               already cached for this scene (so a floor never re-downloads on return):
                 1) low-res first — current angle first — loader shown until all are in,
                 2) then hi-res in the background (throttled), current frame first.
               opts.initial uses the full-screen loader for the very first paint. */
            function loadCurrentScene(opts) {
                const initial = !!(opts && opts.initial);
                const token = sceneToken;

                const showLoader = (show) => {
                    if (initial) {
                        if (mainLoader) mainLoader.style.display = show ? "flex" : "none";
                    } else {
                        showSceneLoader(show);
                    }
                };
                const setPct = (pct) => {
                    if (initial) {
                        if (loadingText) loadingText.textContent = `Loading ${pct}%`;
                    } else {
                        setSceneLoaderPct(pct);
                    }
                };

                // Show the current angle straight away if it is already cached for this scene.
                if (frameImages[currentFrame]) showFrame(currentFrame);

                // Which low-res frames are still missing for this scene?
                const missingLow = [];
                for (let i = 0; i < TOTAL_FRAMES; i++) {
                    if (!USED_SET.has(i) || i >= sceneFrames()) continue; // skip frames we deliberately don't load (a still has one)
                    if (!lowresLoaded[i]) missingLow.push(i);
                }

                if (missingLow.length === 0) {
                    // Fully cached — nothing to download, just display + top up any hi-res gaps.
                    showLoader(false);
                    imageElement.classList.remove("loading-frame");
                    showFrame(currentFrame);
                    _enqueueAllHires(); // queue is empty if hi-res is also complete
                    return;
                }

                // Request the frame the user is on (and its neighbours) first.
                missingLow.sort(
                    (a, b) => circularFrameDist(a, currentFrame) - circularFrameDist(b, currentFrame),
                );

                imageElement.classList.add("loading-frame");
                showLoader(true);
                setPct(Math.round((loadedCount / sceneUsedCount()) * 100));

                let pending = missingLow.length;
                let fails = 0;

                missingLow.forEach((i) => {
                    const img = new Image();
                    _lowresImages.push(img);

                    const settle = () => {
                        if (token !== sceneToken) return; // a newer scene took over — stop
                        pending--;
                        loadedCount = lowresLoaded.reduce((n, v) => n + (v ? 1 : 0), 0);
                        setPct(Math.round((loadedCount / sceneUsedCount()) * 100));

                        if (pending === 0) {
                            showLoader(false); // all low-res in → dragging enabled
                            imageElement.classList.remove("loading-frame");
                            showFrame(currentFrame);
                            if (fails < missingLow.length) _enqueueAllHires(); // hi-res in background
                        }
                    };

                    img.onload = () => {
                        if (token !== sceneToken) return;
                        lowresLoaded[i] = true;
                        if (!hiresLoaded[i]) {
                            frameImages[i] = img;
                            if (i === currentFrame) {
                                imageElement.src = img.src;
                                imageElement.classList.remove("loading-frame");
                            }
                        }
                        settle();
                    };

                    img.onerror = () => {
                        if (token !== sceneToken) return;
                        fails++;
                        settle();
                    };

                    img.src = `${LOWRES_FOLDER}/${i}.${FRAME_EXT}${FRAME_QS}`;
                });
            }

            // Initial first-paint load of the default scene (full-screen loader).
            function preloadFrames() {
                activateSceneFrameCache(currentScene);
                loadCurrentScene({ initial: true });
            }

            // ── Phase 2: throttled background hi-res queue ───────────────────────────────

            function _enqueueAllHires() {
                // Build queue: start from frame after current so visible area loads first
                _hiresQueue = [];
                for (let offset = 0; offset < TOTAL_FRAMES; offset++) {
                    const idx = (currentFrame + offset) % TOTAL_FRAMES;
                    if (!USED_SET.has(idx) || idx >= sceneFrames()) continue; // only background-load the frames we use
                    if (!hiresLoaded[idx]) _hiresQueue.push(idx);
                }
                _pumpHiresQueue();
            }

            function _pumpHiresQueue() {
                while (_hiresActive < HIRES_CONCURRENT && _hiresQueue.length > 0) {
                    const frameIdx = _hiresQueue.shift();
                    if (hiresLoaded[frameIdx] || _hiresImages[frameIdx]) continue; // skip if done or in-flight

                    _hiresActive++;
                    const img = new Image();
                    _hiresImages[frameIdx] = img;
                    const token = sceneToken; // capture: ignore this load if the scene changes

                    const onDone = () => {
                        _hiresActive--;
                        _hiresImages[frameIdx] = null;
                        _pumpHiresQueue(); // pull next from queue
                    };

                    img.onload = () => {
                        if (token !== sceneToken) return onDone(); // stale scene, discard
                        hiresLoaded[frameIdx] = true;
                        frameImages[frameIdx] = img;
                        if (frameIdx === currentFrame) imageElement.src = img.src;
                        onDone();
                    };

                    img.onerror = onDone;
                    img.src = `${IMAGE_FOLDER}/${frameIdx}.${FRAME_EXT}${FRAME_QS}`;
                }
            }

            // Called on drag-end: move this frame to the front of the queue (or start it now)
            function prioritizeHiresFrame(frameIdx) {
                if (hiresLoaded[frameIdx]) return;               // already hi-res, nothing to do

                if (_hiresImages[frameIdx]) return;              // already in-flight, let it finish

                // Remove from wherever it is in the queue and push to front
                _hiresQueue = _hiresQueue.filter(i => i !== frameIdx);
                _hiresQueue.unshift(frameIdx);
                _pumpHiresQueue();
            }

            // Called when the user STAYS on a frame (drag stops): rebuild the remaining
            // hi-res queue so the current frame loads first, then its neighbours outward.
            // This makes "the frame you're looking at" sharpen first, then the rest.
            function reprioritizeHiresAround(centerFrame) {
                const remaining = [];
                for (let i = 0; i < TOTAL_FRAMES; i++) {
                    if (!USED_SET.has(i)) continue;
                    if (!hiresLoaded[i] && !_hiresImages[i]) remaining.push(i);
                }

                const circularDist = (a) => {
                    const d = Math.abs(a - centerFrame);
                    return Math.min(d, TOTAL_FRAMES - d);
                };

                remaining.sort((a, b) => circularDist(a) - circularDist(b));
                _hiresQueue = remaining; // current frame (dist 0) is now first
                _pumpHiresQueue();
            }

            /* =========================================================
               SCENE / FLOOR SWITCHING
            ========================================================= */

            function showSceneLoader(show) {
                const el = document.getElementById("sceneLoader");
                if (el) el.classList.toggle("show", show);
            }

            function setSceneLoaderPct(pct) {
                const t = document.getElementById("sceneLoaderText");
                if (t) t.textContent = `Loading ${pct}%`;
            }

            // Pause (cancel) downloads still running for the scene we're LEAVING, without
            // discarding what it already fetched — its cache survives in sceneFrameCache,
            // so returning to it never re-downloads finished frames. This also frees the
            // network so the scene we're switching to gets full bandwidth immediately.
            function pauseSceneDownloads() {
                for (const img of _lowresImages) {
                    if (img && !img.complete) {
                        img.onload = null;
                        img.onerror = null;
                        img.src = ""; // aborts the pending download in browsers
                    }
                }
                _lowresImages = [];

                for (let i = 0; i < _hiresImages.length; i++) {
                    const img = _hiresImages[i];
                    if (img && !img.complete) {
                        img.onload = null;
                        img.onerror = null;
                        img.src = "";
                    }
                    _hiresImages[i] = null;
                }

                _hiresQueue = [];
                _hiresActive = 0;
            }

            // Switch the visible 360° set + filter the units to that floor.
            function setScene(sceneKey) {
                const scene = SCENES[sceneKey];
                if (!scene) return;

                // A still scene has no 3D view: leave it first (exit3DMode restores the scene we are leaving).
                if (scene.still && is3DMode) exit3DMode();
                pauseSceneDownloads(); // pause (don't discard) the scene we're leaving
                currentScene = sceneKey;
                if (scene.still) currentFrame = 0; // the one frame
                ["mode3DToggle", "och3D"].forEach((id) => { const b = document.getElementById(id); if (b) b.style.display = scene.still ? "none" : ""; });
                const backBtn = document.getElementById("sceneBackBtn"); if (backBtn) backBtn.hidden = !scene.still; // a floor screen offers the way back
                useOverlayModel(scene.units || THREE_ASSETS.units); // the scene's own overlay model, or the floors
                // Remember the time of day so it survives a trip through the floor scenes.
                if (sceneKey === "exterior" || sceneKey === "night") viewModePref = sceneKey;
                sceneToken++; // invalidate any stale in-flight callbacks

                IMAGE_FOLDER = `${STORAGE_PUBLIC_BASE}/${scene.path}/high`;
                LOWRES_FOLDER = `${STORAGE_PUBLIC_BASE}/${scene.path}/low`;

                activateSceneFrameCache(sceneKey); // point the globals at this scene's cache
                // In 3D mode the photos aren't on screen, so downloading a whole 60-frame
                // orbit (and showing its loading overlay over the model) is pure waste.
                // Defer it; exit3DMode fetches whatever the final scene needs.
                if (is3DMode) {
                    pendingSceneLoad = true;
                } else {
                    loadCurrentScene(); // fetch only what's missing (instant if fully cached)
                }

                // 3D unit model: keep it visible; the floor filter limits it to this floor.
                // (The floor volumes themselves only show on a scene whose camera is baked — floorsVisible.)
                const overlay = document.getElementById("threeOverlay");
                if (overlay) {
                    overlay.style.display = scene.showUnitsOverlay ? "" : "none";
                    if (scene.showUnitsOverlay) {
                        requestAnimationFrame(() => {
                            if (typeof resizeThreeOverlay === "function") resizeThreeOverlay();
                            scheduleThreeFrame(currentFrame);
                        });
                    }
                }
                syncFloorsVisible();
                if (!is3DMode && !sceneOverlayAligned()) {
                    if (typeof resetHoveredUnit === "function") resetHoveredUnit();
                    if (typeof hideUnitHoverCard === "function") hideUnitHoverCard();
                }

                // The building shell masks unit boxes on the exterior/night orbits only (see
                // shellMasksOverlay): on a floor view it is hidden so units sitting under the
                // building still light up (the floor filter already hides the other floors).
                // In 3D mode the shell IS the view, so it stays visible whatever floor is
                // picked -- but it ghosts on a floor view so it doesn't swallow the units.
                if (occluderModel) {
                    if (is3DMode) {
                        occluderModel.visible = true;
                        setShellMode();
                        applyThree3DTheme(); // Day/Night buttons are scene switches, so retint
                    } else {
                        occluderModel.visible = shellMasksOverlay();
                    }
                }

                applySceneFloorFilter(scene.unitFloor);

                // Note: selecting a floor only filters the units (table + 3D overlay above);
                // it does NOT auto-open the units table. The user opens it via its toggle.

                updateFloorMenuActive();
            }

            // Drive the existing table/3D filters from the active scene's floor.
            // A floor scene (unitFloor set) pins the filter to its floor. An exterior
            // orbit only clears a floor that a previous floor scene pinned — a floor the
            // visitor picked in Unit Search / the table survives Day ⇄ Night switches.
            let sceneFloorFilter = "";
            function applySceneFloorFilter(floorKey) {
                if (typeof TABLE_FILTERS !== "undefined") {
                    if (floorKey) {
                        TABLE_FILTERS.floor = floorKey;
                        sceneFloorFilter = floorKey;
                    } else if (sceneFloorFilter && TABLE_FILTERS.floor === sceneFloorFilter) {
                        TABLE_FILTERS.floor = "";
                        sceneFloorFilter = "";
                    } else {
                        sceneFloorFilter = "";
                    }
                }

                const sel = document.getElementById("tableFloorFilter");
                if (sel && typeof TABLE_FILTERS !== "undefined") sel.value = TABLE_FILTERS.floor || "";

                if (typeof renderUnitsTable === "function") renderUnitsTable();
                if (typeof applyThreeUnitsFromSheet === "function") applyThreeUnitsFromSheet();
            }

            function buildFloorMenu() {
                const menu = document.getElementById("floorMenu");
                if (!menu) return;

                menu.innerHTML = MENU_ORDER.map(
                    (key) =>
                        `<button type="button" class="floor-menu-btn" data-scene="${key}">${SCENES[key].label}</button>`,
                ).join("");
                menu.classList.toggle("one-scene", MENU_ORDER.length < 2); // a project with one orbit has nothing to switch between

                menu.querySelectorAll(".floor-menu-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        // Choosing a floor from the top menu should NOT open (or keep open) the
                        // units table — close it so the floor is visible in 3D.
                        if (typeof closeUnitsTable === "function") closeUnitsTable();
                        setScene(btn.dataset.scene);
                    });
                });

                // The building view a floor screen goes back to (Day or Night, remembered in setScene) — the Back
                // button, and the Unit Search chips / table floor select when they lead off a floor plan.
                window.buildingScene = () => viewModePref || "exterior";
                document.getElementById("sceneBackBtn")?.addEventListener("click", () => {
                    if (typeof closeUnitsTable === "function") closeUnitsTable();
                    setScene(window.buildingScene());
                });

                updateFloorMenuActive();
            }

            function updateFloorMenuActive() {
                document.querySelectorAll("#floorMenu .floor-menu-btn").forEach((btn) => {
                    btn.classList.toggle("active", btn.dataset.scene === currentScene);
                });
            }

            // three now arrives via a deferred module, so wait for it. The frame
            // preloader and the floor menu don't touch three and start immediately.
            window.threeLibReady.then(initThreeOverlay);
            preloadFrames();
            buildFloorMenu();

            /* Hide / show ALL units (the whole 3D overlay group). Hiding the group
               also disables hover/click on units via the guards in the raycast handlers. */
            function setUnitsOverlayHidden(hidden) {
                unitsOverlayHidden = hidden;
                syncFloorsVisible();
                if (hidden) {
                    if (typeof resetHoveredUnit === "function") resetHoveredUnit();
                    if (typeof hideUnitHoverCard === "function") hideUnitHoverCard();
                }
                const btn = document.getElementById("hideUnitsToggle");
                if (btn) {
                    // .is-hidden swaps the eye / eye-off SVG icons via CSS.
                    btn.classList.toggle("is-hidden", hidden);
                    const label = btn.querySelector("b");
                    if (label) label.textContent = overlayToggleLabel(hidden);
                }
            }
            // "Units" or "Floors", after what the overlay model actually carries.
            function overlayToggleLabel(hidden) {
                return (hidden ? "Show " : "Hide ") + (overlayHasFloors ? "Floors" : "Units");
            }
            function syncOverlayToggleLabel() {
                const btn = document.getElementById("hideUnitsToggle");
                if (!btn) return;
                const label = btn.querySelector("b");
                if (label) label.textContent = overlayToggleLabel(unitsOverlayHidden);
                btn.dataset.noun = overlayHasFloors ? "floors" : "units"; // the header button mirrors this
            }
            document
                .getElementById("hideUnitsToggle")
                ?.addEventListener("click", () => setUnitsOverlayHidden(!unitsOverlayHidden));

            document
                .getElementById("mode3DToggle")
                ?.addEventListener("click", () => toggle3DMode());

            /* =========================================================
         PART 2: INTERACTIVE FLOORS + GOOGLE SHEET
      ========================================================= */

            const SHEET_ID = "1ZTlMYzdvSB_Hpv15T94J0gFBOE7YzZ5rJyprOKmXuWo";
            const SHEET_GID = "0";
            https://docs.google.com/spreadsheets/d/1ZTlMYzdvSB_Hpv15T94J0gFBOE7YzZ5rJyprOKmXuWo/export?format=csv&gid=0
            const CSV_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv&gid=${SHEET_GID}`;
            const GVIZ_CSV_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&gid=${SHEET_GID}`;
            const GVIZ_JSON_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?gid=${SHEET_GID}`;

            let allUnits = [];
            let activeFloor = "";
            let activeFloorRaw = "";
            let activeVideo = "";
            let currentHotspot = null;
            let filters = {
                available: true,
                reserved: true,
                sold: true,
            };

            let currentUnit = null;
            let currentMediaTab = "img";
            let lastSheetHash = "";
            let sheetRefreshTimer = null;

            const SHEET_REFRESH_INTERVAL = 15000;

            const $ = (selector) => document.querySelector(selector);
            const $$ = (selector) => [...document.querySelectorAll(selector)];

            function normalizeHeader(h) {
                return String(h || "")
                    .toLowerCase()
                    .trim()
                    .replace(/\s+/g, "")
                    .replace(/[()_\-\/]/g, "");
            }

            function getVal(row, keys) {
                for (const key of keys) {
                    if (row[key] !== undefined && row[key] !== "") return row[key];
                }

                return "";
            }

            function normalizeFloor(v) {
                let original = String(v || "")
                    .trim()
                    .toUpperCase();

                let f = original
                    .replace(/\./g, "")
                    .replace(/-/g, "")
                    .replace(/_/g, "")
                    .replace(/\s+/g, "");

                const exactMap = {
                    LOWERGROUND: "LG",
                    LOWERGROUNDFLOOR: "LG",
                    BASEMENT: "LG",
                    B1: "LG",
                    LG: "LG",

                    GROUND: "GF",
                    GROUNDFLOOR: "GF",
                    G: "GF",
                    G0: "GF",
                    0: "GF",
                    GF: "GF",

                    1: "1",
                    "01": "1",
                    "1ST": "1",
                    FIRST: "1",
                    FIRSTFLOOR: "1",
                    FLOOR1: "1",
                    LEVEL1: "1",
                    L1: "1",
                    F1: "1",
                    FL1: "1",

                    2: "2",
                    "02": "2",
                    "2ND": "2",
                    SECOND: "2",
                    SECONDFLOOR: "2",
                    FLOOR2: "2",
                    LEVEL2: "2",
                    L2: "2",
                    F2: "2",
                    FL2: "2",

                    3: "3",
                    "03": "3",
                    "3RD": "3",
                    THIRD: "3",
                    THIRDFLOOR: "3",
                    FLOOR3: "3",
                    LEVEL3: "3",
                    L3: "3",
                    F3: "3",
                    FL3: "3",

                    // upper floors (Khawalid Tower 2: G + 9) and its townhouse level
                    4: "4", "4TH": "4", FOURTH: "4",
                    5: "5", "5TH": "5", FIFTH: "5",
                    6: "6", "6TH": "6", SIXTH: "6",
                    7: "7", "7TH": "7", SEVENTH: "7",
                    8: "8", "8TH": "8", EIGHTH: "8",
                    9: "9", "9TH": "9", NINTH: "9",
                    TOWNHOUSE: "TH",
                    TOWNHOUSES: "TH",
                    TH: "TH",

                    ROOF: "RF",
                    ROOFTOP: "RF",
                    R: "RF",
                    RF: "RF",
                };

                if (exactMap[f]) return exactMap[f];

                f = f.replace(/FLOOR/g, "").replace(/LEVEL/g, "");
                if (exactMap[f]) return exactMap[f];

                f = f.replace(/(ST|ND|RD|TH)$/, "");
                if (exactMap[f]) return exactMap[f];

                f = f.replace(/^(FL|F|L)/, "");
                f = f.replace(/(ST|ND|RD|TH)$/, "");

                return exactMap[f] || f;
            }

            function statusKey(v) {
                const s = String(v || "available")
                    .toLowerCase()
                    .trim();

                if (s.includes("sold") || s.includes("مباع")) return "sold";
                if (
                    s.includes("reserve") ||
                    s.includes("reserved") ||
                    s.includes("حجز")
                )
                    return "reserved";

                return "available";
            }

            function formatPrice(v) {
                const raw = String(v || "")
                    .replace(/,/g, "")
                    .trim();
                const n = Number(raw);

                if (!raw) return "—";
                if (Number.isFinite(n)) return n.toLocaleString("en-US") + " SAR";

                return v;
            }

            function escapeHtml(value) {
                return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function normalizeUnitName(value) {
                return String(value || "")
                    .toLowerCase()
                    .trim()
                    .replace(/\s+/g, "")
                    .replace(/[-_./]/g, "");
            }

            function findUnitByName(name) {
                const target = normalizeUnitName(name);

                if (!target) return null;

                return allUnits.find((unit) => {
                    return normalizeUnitName(unit.name) === target;
                });
            }

            function findUnitFromMesh(mesh) {
                if (!mesh) return null;

                const names = [
                    mesh.name,
                    mesh.parent?.name,
                    mesh.parent?.parent?.name,
                ].filter(Boolean);

                for (const name of names) {
                    const found = findUnitByName(name);
                    if (found) return found;
                }

                return null;
            }



            /* =========================================================
           THREE UNITS STATUS COLORS + FILTER + HIGHLIGHT
        ========================================================= */

            const THREE_STATUS_COLORS = {
                available: 0x22c55e, // green
                reserved: 0xf59e0b, // yellow/orange
                sold: 0xef4444,     // red
            };
            // Draw an outline around every unit box? false = plain fills.
            const UNIT_OUTLINES = true;
            // Outline colour: a hex colour (0xffffff = thin white lines), or null for a
            // dark shade of the unit's own status colour (THREE_STATUS_EDGE_COLORS).
            // WebGL draws lines 1 px wide whatever the material says, so they stay thin.
            const UNIT_OUTLINE_COLOR = 0xffffff;
            // Outline = a dark shade of the same hue (the "700" step of each colour), so a
            // green unit gets a dark-green border, a red one a dark-red border, and so on.
            const THREE_STATUS_EDGE_COLORS = {
                available: 0x15803d,
                reserved: 0xb45309,
                sold: 0xb91c1c,
            };
            const THREE_GHOST_EDGE_COLOR = 0x475569; // dark slate for the grey ghost massing

            let highlightedUnitId = null;
            let highlightedMesh = null;

            function getUnitColor(unit) {
                return THREE_STATUS_COLORS[unit?.status] || THREE_STATUS_COLORS.available;
            }
            function getUnitEdgeColor(unit) {
                const c = THREE_STATUS_EDGE_COLORS[unit?.status];
                if (c !== undefined) return c;
                // Unknown status: darken its fill colour instead of falling back to white.
                return new THREE.Color(getUnitColor(unit)).multiplyScalar(0.6).getHex();
            }

            function getUnitMeshKey(mesh) {
                const unit = findUnitFromMesh(mesh);
                return unit?.id || normalizeUnitName(mesh?.name || mesh?.parent?.name || "");
            }

            /* The exported unit boxes reach ~35 cm past their own floor slab at the top
               and the bottom, so consecutive floors overlap by ~70 cm and neighbours share
               faces — in 3D mode the boxes visibly cut through each other. Once per load:
                 · trim every unit to the mid-plane of the overlap with the floor above /
                   below (floors come from the sheet, ordered by EX3D_FLOOR_ORDER)
                 · shrink each footprint by UNIT_GAP so adjacent boxes stay apart
                 · rebuild the outline geometry to match
               Works in world space (the FBX root carries the axis rotation). */
            const UNIT_GAP = 8; // cm between neighbouring boxes (4 cm off each side)
            // (the once-only flag lives on the model — unitsModel.userData.tidied — because a scene can swap the overlay model)
            function tidyUnitGeometry() {
                if (!unitsModel || unitsModel.userData.tidied || typeof THREE === "undefined") return;
                // Unit boxes learn their floor from the sheet; floor volumes carry it in their name.
                if (!overlayHasFloors && !allUnits?.length) return;
                // Floor volumes are also capped at the building shell (step 2b) — wait until it is in.
                if (overlayHasFloors && THREE_ASSETS.occluder && !occluderSettled) return;
                unitsModel.updateMatrixWorld(true);

                // 1. world-space extents per mesh + per floor
                const info = new Map(); // mesh -> { floor, minY, maxY, cx, cz, sx, sz }
                const floors = new Map(); // floor key -> { bottom, top }
                const v = new THREE.Vector3();
                forEachUnitMesh((mesh) => {
                    const floorKey = mesh.userData.floorKey || "";
                    const unit = floorKey ? null : findUnitFromMesh(mesh);
                    const pos = mesh.geometry && mesh.geometry.attributes && mesh.geometry.attributes.position;
                    if ((!unit && !floorKey) || !pos) return;
                    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity, minZ = Infinity, maxZ = -Infinity;
                    for (let i = 0; i < pos.count; i++) {
                        v.fromBufferAttribute(pos, i).applyMatrix4(mesh.matrixWorld);
                        if (v.x < minX) minX = v.x; if (v.x > maxX) maxX = v.x;
                        if (v.y < minY) minY = v.y; if (v.y > maxY) maxY = v.y;
                        if (v.z < minZ) minZ = v.z; if (v.z > maxZ) maxZ = v.z;
                    }
                    const floor = floorKey || String(unit.floor || "");
                    // gap: a floor volume meets its neighbours exactly (one shared outline); boxes keep UNIT_GAP between them
                    info.set(mesh, { floor, gap: floorKey ? 0 : UNIT_GAP, minY, maxY, cx: (minX + maxX) / 2, cz: (minZ + maxZ) / 2, sx: maxX - minX, sz: maxZ - minZ });
                    const f = floors.get(floor) || { bottom: Infinity, top: -Infinity };
                    f.bottom = Math.min(f.bottom, minY); f.top = Math.max(f.top, maxY);
                    floors.set(floor, f);
                });
                if (!info.size) return;

                // 2. one boundary plane between each pair of consecutive floors (mid-overlap;
                //    if the floors already clear each other, nothing moves)
                const order = EX3D_FLOOR_ORDER.filter((k) => floors.has(k)).concat([...floors.keys()].filter((k) => !EX3D_FLOOR_ORDER.includes(k)));
                const below = new Map(), above = new Map(); // floor key -> boundary y
                for (let i = 0; i + 1 < order.length; i++) {
                    const lo = floors.get(order[i]), hi = floors.get(order[i + 1]);
                    if (lo.top > hi.bottom) { const y = (lo.top + hi.bottom) / 2; above.set(order[i], y); below.set(order[i + 1], y); }
                }

                // 2b. no floor volume rises above the building shell. The selection volumes are a
                //     full storey tall whatever the roof does, and over the photo the extra metre
                //     on the top floor would tint a strip of sky.
                const shellTop = occluderModel ? new THREE.Box3().setFromObject(occluderModel).max.y : Infinity;
                // 2c. the project's own fit of the floor volumes to what the renders show (projects.js → models.floorFit, cm):
                //     `grow` widens every floor's footprint by that much on each side (facade fins that project past the
                //     structural volume the boxes were modelled from), `groundLevel` lifts the lowest floor's bottom to the
                //     plinth the building stands on, `roofLevel` caps the top floor at the penthouse roof. Measured against the
                //     renders (README section 5); absent = the boxes as delivered.
                const fit = (PROJECT.models && PROJECT.models.floorFit) || {};
                const growCm = Number(fit.grow) || 0, groundLevel = Number(fit.groundLevel), roofLevel = Number(fit.roofLevel);
                const lowestFloor = order[0], highestFloor = order[order.length - 1];

                // 3. move the vertices: top / bottom planes onto the boundaries, footprint inset
                const inv = new THREE.Matrix4();
                const EPS = 1.5;
                info.forEach((d, mesh) => {
                    const pos = mesh.geometry.attributes.position;
                    inv.copy(mesh.matrixWorld).invert();
                    let yBottom = below.has(d.floor) ? Math.max(d.minY, below.get(d.floor) + d.gap / 2) : d.minY;
                    let yTop = above.has(d.floor) ? Math.min(d.maxY, above.get(d.floor) - d.gap / 2) : d.maxY;
                    if (!d.gap && shellTop > yBottom + 100) yTop = Math.min(yTop, shellTop); // floor volumes only (2b)
                    if (!d.gap && d.floor === lowestFloor && Number.isFinite(groundLevel) && groundLevel < yTop - 100) yBottom = Math.max(yBottom, groundLevel); // 2c
                    if (!d.gap && d.floor === highestFloor && Number.isFinite(roofLevel) && roofLevel > yBottom + 100) yTop = Math.min(yTop, roofLevel); // 2c
                    let kx = d.gap && d.sx > d.gap * 4 ? (d.sx - d.gap) / d.sx : 1;
                    let kz = d.gap && d.sz > d.gap * 4 ? (d.sz - d.gap) / d.sz : 1;
                    if (!d.gap && growCm) { kx = (d.sx + 2 * growCm) / d.sx; kz = (d.sz + 2 * growCm) / d.sz; } // 2c
                    for (let i = 0; i < pos.count; i++) {
                        v.fromBufferAttribute(pos, i).applyMatrix4(mesh.matrixWorld);
                        if (Math.abs(v.y - d.maxY) < EPS) v.y = yTop;
                        else if (Math.abs(v.y - d.minY) < EPS) v.y = yBottom;
                        v.x = d.cx + (v.x - d.cx) * kx;
                        v.z = d.cz + (v.z - d.cz) * kz;
                        v.applyMatrix4(inv);
                        pos.setXYZ(i, v.x, v.y, v.z);
                    }
                    pos.needsUpdate = true;
                    mesh.geometry.computeBoundingBox();
                    mesh.geometry.computeBoundingSphere();
                    const edge = mesh.userData.edgeLine;
                    if (edge) { const old = edge.geometry; edge.geometry = mesh.userData.floorKey ? floorOutlineGeometry(mesh) : new THREE.EdgesGeometry(mesh.geometry, 20); if (old) old.dispose(); }
                });
                unitsModel.userData.tidied = true;
                console.info(`[3d] overlay tidied: ${info.size} ${overlayHasFloors ? "floor volumes" : "boxes"}, floor boundaries at ${[...above.values()].map((y) => Math.round(y)).join(" / ")} cm${overlayHasFloors ? "" : ", gap " + UNIT_GAP + " cm"}${growCm || Number.isFinite(groundLevel) || Number.isFinite(roofLevel) ? ` — floorFit: grow ${growCm} cm, ground ${Number.isFinite(groundLevel) ? groundLevel : "–"}, roof ${Number.isFinite(roofLevel) ? roofLevel : "–"}` : ""}`);
            }

            function forEachUnitMesh(callback) {
                if (!unitsModel) return;

                unitsModel.traverse((child) => {
                    if (child.isMesh && child.userData.isUnit) {
                        callback(child);
                    }
                });
            }

            function getFilteredUnitIdsForThree() {
                /*
                  نفس فلاتر الجدول بالظبط:
                  search + floor + status + price + area
                */
                if (typeof getFilteredTableUnits !== "function") {
                    return new Set(allUnits.map((unit) => unit.id));
                }

                return new Set(getFilteredTableUnits().map((unit) => unit.id));
            }

            /* The prototype (type) filter reads differently from the others in 3D.
               Hiding every non-Admin unit leaves a building with holes in it — you lose
               the massing that makes the highlight meaningful. So units excluded ONLY by
               the prototype filter are ghosted rather than hidden: the chosen prototype
               keeps its availability colours at full strength and the rest fall back to a
               faint grey. Every other filter (floor, status, price, area) still hides. */
            function getThreeUnitSets() {
                const visible = getFilteredUnitIdsForThree();
                const ghost = new Set();

                const types = (typeof TABLE_FILTERS !== "undefined" && TABLE_FILTERS.types) || [];
                if (types.length && typeof getFilteredTableUnits === "function") {
                    TABLE_FILTERS.types = [];
                    try {
                        getFilteredTableUnits().forEach((u) => {
                            if (!visible.has(u.id)) ghost.add(u.id);
                        });
                    } finally {
                        TABLE_FILTERS.types = types; // restore before anything else can read it
                    }
                }
                return { visible, ghost };
            }

            function paintUnitMesh(mesh, unit, options = {}) {
                if (!mesh || !mesh.material) return;

                const { highlighted = false, visible = true, ghosted = false } = options;

                mesh.visible = visible || ghosted;
                // Ghosts are context, not targets — hover and click skip them.
                mesh.userData.ghosted = ghosted && !visible;

                mesh.material.transparent = true;
                // Overlay: see-through fills over the photo, so no depth writes (boxes
                // blend). 3D mode: the fills are solid, so they must occlude the boxes and
                // outlines behind them — without this every edge showed through every box.
                mesh.material.depthWrite = !!(is3DMode && visible);
                mesh.material.depthTest = true;

                const edge = mesh.userData.edgeLine;
                if (edge) edge.visible = visible || ghosted;

                if (!visible && !ghosted) {
                    mesh.material.opacity = 0;
                    mesh.userData.restOpacity = 0;
                    return;
                }

                if (!visible) {
                    // Faint grey massing: enough to read the building's shape, not enough to
                    // compete with the prototype being shown.
                    mesh.material.color.set(0x8d97a3);
                    const ghostRest = is3DMode ? 0.16 : 0.09;
                    mesh.material.opacity = ghostRest;
                    mesh.userData.restOpacity = ghostRest;
                    if (edge) {
                        edge.material.color.set(UNIT_OUTLINE_COLOR ?? THREE_GHOST_EDGE_COLOR);
                        const ghostEdge = is3DMode ? 0.22 : 0.16;
                        edge.material.opacity = ghostEdge;
                        mesh.userData.restEdgeOpacity = ghostEdge;
                    }
                    return;
                }

                if (highlighted) {
                    mesh.material.color.set(0xffffff);
                    mesh.material.opacity = 0.95;
                    mesh.userData.restOpacity = 0.95;
                    if (edge) {
                        // dark outline in the unit's own hue so the border still reads on the
                        // white highlight fill
                        edge.material.color.set(getUnitEdgeColor(unit));
                        edge.material.opacity = 1;
                        mesh.userData.restEdgeOpacity = 1;
                    }
                    return;
                }

                mesh.material.color.set(getUnitColor(unit));
                /* Over a photo the fill is the dashboard's "units at rest" (45 % by default: the render
                   shows through and supplies the detail). In 3D mode the units ARE the building (the
                   shell is the same volumes plus slabs), so at 0.45 the massing dissolves into a haze
                   of overlapping edges. Solid reads as architecture; ghosted reads as noise. */
                const rest = is3DMode ? 1 : FLOOR_LOOK.units.rest;
                mesh.material.opacity = rest;
                mesh.userData.restOpacity = rest;
                if (edge) {
                    edge.material.color.set(UNIT_OUTLINE_COLOR ?? getUnitEdgeColor(unit));
                    // Soft enough not to clutter the photo; in 3D mode the fill is solid, so
                    // the lines read at a lower value still.
                    const edgeRest = is3DMode ? 0.45 : FLOOR_LOOK.units.edge; // the dashboard's "unit outlines"
                    edge.material.opacity = edgeRest;
                    mesh.userData.restEdgeOpacity = edgeRest;
                }
            }

            function applyThreeUnitsFromSheet() {
                if (!unitsModel) return;
                if (!overlayHasFloors && !allUnits?.length) return; // unit boxes are nothing without their rows
                tidyUnitGeometry(); // no-op after the first pass

                const { visible: filteredIds, ghost: ghostIds } = getThreeUnitSets();
                const floorSets = overlayHasFloors ? getThreeFloorSets() : null;

                forEachUnitMesh((mesh) => {
                    if (mesh.userData.floorKey) {
                        paintFloorMesh(mesh, floorSets);
                        return;
                    }

                    const unit = findUnitFromMesh(mesh);

                    // لو مفيش unit matching في الشيت اخفيه عشان ميظهرش غلط
                    if (!unit) {
                        mesh.visible = false;
                        if (mesh.userData.edgeLine) mesh.userData.edgeLine.visible = false;
                        return;
                    }

                    const isVisibleByFilter = filteredIds.has(unit.id);
                    const isHighlighted = highlightedUnitId && unit.id === highlightedUnitId;

                    mesh.userData.unitId = unit.id;
                    mesh.userData.status = unit.status;

                    paintUnitMesh(mesh, unit, {
                        visible: isVisibleByFilter,
                        ghosted: ghostIds.has(unit.id),
                        highlighted: isHighlighted,
                    });
                });
            }

            function clearThreeHighlight() {
                highlightedUnitId = null;
                highlightedMesh = null;
                applyThreeUnitsFromSheet();
            }

            function highlightUnitInThree(unit) {
                if (!unit || !unitsModel) return;

                highlightedUnitId = unit.id;
                highlightedMesh = null;

                forEachUnitMesh((mesh) => {
                    const meshUnit = findUnitFromMesh(mesh);

                    if (meshUnit?.id === unit.id) {
                        highlightedMesh = mesh;
                    }
                });

                applyThreeUnitsFromSheet();
            }

            function showUnitHoverCard(unit, event) {
                if (!unit) return;

                const card = document.getElementById("unitHoverCard");
                const imgBox = document.getElementById("unitHoverImg");
                const name = document.getElementById("unitHoverName");
                const type = document.getElementById("unitHoverType");
                const status = document.getElementById("unitHoverStatus");
                const floor = document.getElementById("unitHoverFloor");
                const area = document.getElementById("unitHoverArea");
                const price = document.getElementById("unitHoverPrice");

                if (!card) return;

                const amenity = typeof isAmenityUnit === "function" && isAmenityUnit(unit); // a shared space: no type line, no price row
                name.textContent = unit.name || "Unit";
                type.textContent = unit.type || "—";
                type.style.display = amenity ? "none" : "";

                status.className = `unit-hover-status ${unit.status}`;
                status.textContent = unit.availability || unit.status || "Available";

                floor.textContent = unit.floorRaw || unit.floor || "—";
                area.textContent = unit.area || "—";
                price.textContent = unit.price || "—";
                const priceRow = price.closest(".unit-hover-row");
                if (priceRow) priceRow.style.display = amenity ? "none" : "";

                // The floor plan, not the photo: that is what a box on a floor screen stands for (the photo when a unit has none).
                const plan = planUrls(unit)[0] || "";
                const hoverSrc = plan || String(unit.imgSource || "").trim();
                imgBox.classList.toggle("plan", !!plan);
                if (hoverSrc) {
                    imgBox.innerHTML = `
      <img 
        src="${escapeHtml(hoverSrc)}"
        alt="${escapeHtml(unit.name)}"
        onerror="this.parentElement.innerHTML='<div class=&quot;unit-hover-no-img&quot;>Image failed to load</div>'"
      />
    `;
                } else {
                    imgBox.innerHTML = `<div class="unit-hover-no-img">No image available</div>`;
                }

                moveUnitHoverCard(event);
                card.classList.add("show");
            }

            function moveUnitHoverCard(event, card) {
                card = card || document.getElementById("unitHoverCard");
                if (!card || !event) return;

                const padding = 14;
                const offsetX = 18;
                const offsetY = 18;

                let x = event.clientX + offsetX;
                let y = event.clientY + offsetY;

                const rect = card.getBoundingClientRect();

                if (x + rect.width > window.innerWidth - padding) {
                    x = event.clientX - rect.width - offsetX;
                }

                if (y + rect.height > window.innerHeight - padding) {
                    y = event.clientY - rect.height - offsetY;
                }

                x = Math.max(padding, x);
                y = Math.max(padding, y);

                card.style.left = x + "px";
                card.style.top = y + "px";
            }

            function hideUnitHoverCard() {
                hideFloorHoverCard();
                const card = document.getElementById("unitHoverCard");
                if (!card) return;

                card.classList.remove("show");
            }

            /* =========================================================
               FLOOR VOLUMES
               The overlay model can carry one mesh per FLOOR instead of one per unit
               (FBX_CAM/FLOORS_SELECT.fbx: GROUND_SELECT, FIRST_SELECT, …). A floor
               mesh stands for every unit on its floor: it takes the colour of the best
               availability there, shows the floor's summary under the pointer, and a
               click opens that floor's units in Unit Search.
            ========================================================= */

            /* Opacity and colour of a floor over the photo. In the 3D view floors are solid, like unit boxes.
               Everything here comes from the dashboard — Settings → Building overlay, i.e. the
               site_settings rows floors_rest / floors_hover / floors_outline (0–100) and, per floor,
               an optional floor_color_<key> ("#rrggbb"; without one a floor is coloured by its
               availability, THREE_STATUS_COLORS). The HOME SCREEN script fetches that table and
               publishes it as the "site:settings" event; every other shade is derived here. */
            const FLOOR_LOOK_DEFAULTS = { floors_rest: 0, floors_hover: 30, floors_outline: 55, units_rest: 45, units_hover: 92, units_outline: 70 };
            const FLOOR_LOOK = {};
            function setFloorLook(settings) {
                const pct = (key) => { const v = parseFloat(settings && settings[key]); return Math.min(100, Math.max(0, isNaN(v) ? FLOOR_LOOK_DEFAULTS[key] : v)) / 100; };
                const rest = pct("floors_rest"), lift = pct("floors_hover"), edge = pct("floors_outline");
                Object.assign(FLOOR_LOOK, {
                    rest,                                  // every floor that has units to show
                    selected: Math.max(rest, lift * 0.8),  // the floor picked in Unit Search, or the floor of the unit that is open
                    lift,                                  // under the pointer
                    dim: rest * 0.45,                      // the other floors while one is under the pointer
                    ghost: rest * 0.6,                     // a floor none of whose units pass the filters (grey, not clickable)
                    edge, edgeSelected: edge > 0 ? Math.min(1, edge + 0.4) : 0, edgeDim: edge * 0.36, edgeGhost: edge * 0.33, // 0 = no outlines in any state
                    colors: {},                            // floor key → fixed colour (hex number), only the floors that have one
                });
                for (const key of ["LG", "GF", "1", "2", "3", "RF"]) { // the keys of FLOOR_TITLES (declared further down)
                    const m = String((settings && settings["floor_color_" + key]) || "").trim().match(/^#?([0-9a-f]{6})$/i);
                    if (m) FLOOR_LOOK.colors[key] = parseInt(m[1], 16);
                }
                // The unit boxes of the floor screens (ground / roof): units_rest / units_hover / units_outline.
                const uRest = pct("units_rest"), uLift = pct("units_hover"), uEdge = pct("units_outline");
                FLOOR_LOOK.units = { rest: uRest, lift: Math.max(uRest, uLift), dim: uRest * 0.27, edge: uEdge, edgeDim: uEdge * 0.13 };
            }
            // A darker shade of a hex colour (the storey edges of a fixed-coloured floor in the 3D view).
            const darkenHex = (hex, f) => (Math.round(((hex >> 16) & 255) * f) << 16) | (Math.round(((hex >> 8) & 255) * f) << 8) | Math.round((hex & 255) * f);
            setFloorLook(window.siteSettings);
            // A change saved in the dashboard repaints the floors that are on screen.
            document.addEventListener("site:settings", (e) => { setFloorLook(e.detail); if (typeof applyThreeUnitsFromSheet === "function") applyThreeUnitsFromSheet(); });
            const FLOOR_TITLES = { LG: "Basement", GF: "Ground Floor", "1": "First Floor", "2": "Second Floor", "3": "Third Floor", RF: "Roof" };

            // "GROUND_SELECT" → "GF", "SECOND _ SELECT" → "2", "ROOF" → "RF"; "" when the mesh is not a floor
            // (tools/bake-camera.js reads the names the same way). A box may also carry the floor's name as
            // units.floor stores it — "1st Floor", "Townhouse" (Tower 2's FBX_CAM/TOWER2_FLOORS.fbx) — which goes
            // through the same normaliser as the units, accepted when it is one of this project's floors.
            const FLOOR_MESH_WORDS = { LOWERGROUND: "LG", BASEMENT: "LG", GROUND: "GF", FIRST: "1", SECOND: "2", THIRD: "3", ROOF: "RF" };
            function floorKeyFromMeshName(name) {
                const word = String(name || "").toUpperCase().replace(/SELECT(ION)?|FLOOR/g, "").replace(/[^A-Z]/g, "");
                if (FLOOR_MESH_WORDS[word]) return FLOOR_MESH_WORDS[word];
                const key = normalizeFloor(String(name || "").replace(/SELECT(ION)?/gi, ""));
                return (PROJECT.floors || []).some((f) => String(f.key) === key) ? key : "";
            }

            /* A floor's outline: the top and bottom loops of its volume. The vertical edge
               at every jog of the footprint is left out — four floors of those hatch the
               whole facade. */
            /* The footprint of a DETAILED volume — many boxes unioned in one mesh (Tower 2: the top level, the penthouse with its
               terraces and parapets, ~900 triangles): the boundary of the union of its faces seen from above (all of them, or only
               those at one level when tol is finite), traced on a 10 cm grid. Every box has its own loop and the roof faces are
               islands with gaps, so neither the edges nor a per-level union make one outline; the whole-volume footprint does.
               The building is axis-aligned in the world, so the boundary comes out as straight segments (a rotated one would step
               by the cell). Returns world segments [x1, z1, x2, z2]; footprintAt() places them at a height. */
            function unionFootprint(mesh, yLevel, tol) {
                const g = mesh.geometry, pos = g.attributes.position, idx = g.index;
                const v = [new THREE.Vector3(), new THREE.Vector3(), new THREE.Vector3()];
                const tris = []; const n = idx ? idx.count : pos.count;
                let minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
                for (let i = 0; i + 2 < n; i += 3) {
                    for (let k = 0; k < 3; k++) v[k].fromBufferAttribute(pos, idx ? idx.getX(i + k) : i + k).applyMatrix4(mesh.matrixWorld);
                    if (Number.isFinite(tol) && v.some((p) => Math.abs(p.y - yLevel) > tol)) continue; // not a face at this level
                    if (Math.abs((v[1].x - v[0].x) * (v[2].z - v[0].z) - (v[2].x - v[0].x) * (v[1].z - v[0].z)) < 1) continue; // a vertical face has no footprint
                    tris.push([v[0].x, v[0].z, v[1].x, v[1].z, v[2].x, v[2].z]);
                    for (const p of v) { minX = Math.min(minX, p.x); maxX = Math.max(maxX, p.x); minZ = Math.min(minZ, p.z); maxZ = Math.max(maxZ, p.z); }
                }
                if (!tris.length) return [];
                const cell = 10, x0 = minX - cell, z0 = minZ - cell;
                const W = Math.ceil((maxX - minX) / cell) + 3, H = Math.ceil((maxZ - minZ) / cell) + 3;
                const grid = new Uint8Array(W * H);
                for (const [ax, az, bx, bz, cx, cz] of tris) {
                    const i0 = Math.max(0, Math.floor((Math.min(ax, bx, cx) - x0) / cell)), i1 = Math.min(W - 1, Math.ceil((Math.max(ax, bx, cx) - x0) / cell));
                    const j0 = Math.max(0, Math.floor((Math.min(az, bz, cz) - z0) / cell)), j1 = Math.min(H - 1, Math.ceil((Math.max(az, bz, cz) - z0) / cell));
                    for (let j = j0; j <= j1; j++) for (let i = i0; i <= i1; i++) {
                        const px = x0 + (i + 0.5) * cell, pz = z0 + (j + 0.5) * cell; // the cell centre inside the triangle?
                        const d1 = (px - bx) * (az - bz) - (ax - bx) * (pz - bz), d2 = (px - cx) * (bz - cz) - (bx - cx) * (pz - cz), d3 = (px - ax) * (cz - az) - (cx - ax) * (pz - az);
                        if (!((d1 < 0 || d2 < 0 || d3 < 0) && (d1 > 0 || d2 > 0 || d3 > 0))) grid[j * W + i] = 1;
                    }
                }
                // the exterior = what a flood from the margin reaches; holes inside the outline (the core, which the boxes do not cover)
                // and islands in them are not exterior, so only the outer boundary is traced
                const ext = new Uint8Array(W * H), stack = [];
                for (let i = 0; i < W; i++) stack.push(i, 0, i, H - 1);
                for (let j = 0; j < H; j++) stack.push(0, j, W - 1, j);
                while (stack.length) { const j = stack.pop(), i = stack.pop(); if (i < 0 || j < 0 || i >= W || j >= H) continue; const k = j * W + i; if (ext[k] || grid[k]) continue; ext[k] = 1; stack.push(i + 1, j, i - 1, j, i, j + 1, i, j - 1); }
                const at = (i, j) => (i < 0 || j < 0 || i >= W || j >= H ? 0 : ext[j * W + i] ? 0 : 1); // 1 = building (or a hole in it)
                const segs = []; // world [x1, z1, x2, z2], boundary cell sides merged into runs
                for (let j = 0; j <= H; j++) { let run = -1; for (let i = 0; i <= W; i++) { const b = i < W && at(i, j) !== at(i, j - 1); if (b && run < 0) run = i; if (!b && run >= 0) { segs.push([x0 + run * cell, z0 + j * cell, x0 + i * cell, z0 + j * cell]); run = -1; } } }
                for (let i = 0; i <= W; i++) { let run = -1; for (let j = 0; j <= H; j++) { const b = j < H && at(i, j) !== at(i - 1, j); if (b && run < 0) run = j; if (!b && run >= 0) { segs.push([x0 + i * cell, z0 + run * cell, x0 + i * cell, z0 + j * cell]); run = -1; } } }
                return segs;
            }
            // the footprint segments (world x / z) placed at a world height, in the local space of the mesh (what the outline geometry holds)
            function footprintAt(mesh, segs, y) {
                const inv = new THREE.Matrix4().copy(mesh.matrixWorld).invert(), out = [], p = new THREE.Vector3();
                for (const [x1, z1, x2, z2] of segs) { p.set(x1, y, z1).applyMatrix4(inv); out.push(p.x, p.y, p.z); p.set(x2, y, z2).applyMatrix4(inv); out.push(p.x, p.y, p.z); }
                return out;
            }

            function floorOutlineGeometry(mesh) {
                const edges = new THREE.EdgesGeometry(mesh.geometry, 20);
                const pos = edges.attributes.position, keep = [];
                const a = new THREE.Vector3(), b = new THREE.Vector3(), wa = new THREE.Vector3(), wb = new THREE.Vector3();
                mesh.updateWorldMatrix(true, false);
                // A detailed volume (Tower 2: the top level — the penthouse, terraces and parapets as many boxes in one mesh, ~900
                // triangles, where the other floors are ~100-triangle prisms) would hatch the roof with every box of its own loop:
                // it gets the outline of its whole footprint at its bottom and its top instead (unionFootprint). Prisms are unaffected.
                const g = mesh.geometry, tris = g.index ? g.index.count / 3 : g.attributes.position.count / 3;
                const detailed = tris > 300;
                if (detailed) {
                    g.computeBoundingBox(); const bb = g.boundingBox.clone().applyMatrix4(mesh.matrixWorld);
                    const fp = unionFootprint(mesh, 0, Infinity); // the whole volume seen from above: one loop at the bottom and at the top, like the other floors
                    keep.push(...footprintAt(mesh, fp, bb.min.y), ...footprintAt(mesh, fp, bb.max.y));
                } else {
                    for (let i = 0; i + 1 < pos.count; i += 2) {
                        a.fromBufferAttribute(pos, i); b.fromBufferAttribute(pos, i + 1);
                        wa.copy(a).applyMatrix4(mesh.matrixWorld); wb.copy(b).applyMatrix4(mesh.matrixWorld);
                        if (Math.abs(wa.y - wb.y) < 1) keep.push(a.x, a.y, a.z, b.x, b.y, b.z); // level in the world = part of a loop
                    }
                }
                edges.dispose();
                const outline = new THREE.BufferGeometry();
                outline.setAttribute("position", new THREE.Float32BufferAttribute(keep, 3));
                return outline;
            }

            /* Materials for one floor volume.
               The volumes are closed and overlap in view (a wing in front of a courtyard
               wall, one floor behind another), so see-through fills would stack up into
               darker patches. Two things keep it to exactly one layer per pixel:
                 · only the faces turned to the camera are drawn (FrontSide)
                 · a depth-only copy is drawn first, so of those faces only the nearest
                   survives the depth test — whichever floor it belongs to
               Both use the same polygon offset, which also lets the outline sit on top. */
            function setupFloorMesh(mesh) {
                const offset = { polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1 };
                mesh.material = new THREE.MeshBasicMaterial(Object.assign({
                    color: THREE_STATUS_COLORS.available,
                    transparent: true,
                    opacity: FLOOR_LOOK.rest,
                    depthWrite: false,
                    depthTest: true,
                    side: THREE.FrontSide,
                }, offset));
                mesh.userData.restOpacity = FLOOR_LOOK.rest;

                const depth = new THREE.Mesh(mesh.geometry, new THREE.MeshBasicMaterial(Object.assign({
                    colorWrite: false,
                    depthWrite: true,
                    depthTest: true,
                    side: THREE.FrontSide,
                }, offset)));
                depth.renderOrder = 0.5; // after the building shell (0), before the fills (1)
                depth.raycast = function () { }; // the pointer is for the floor itself
                mesh.add(depth);

                if (UNIT_OUTLINES) {
                    const edgeLine = new THREE.LineSegments(
                        floorOutlineGeometry(mesh),
                        new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: FLOOR_LOOK.edge, depthTest: true, depthWrite: false }),
                    );
                    edgeLine.renderOrder = 2;
                    edgeLine.userData.isUnitEdge = true;
                    edgeLine.raycast = function () { };
                    mesh.add(edgeLine);
                    mesh.userData.edgeLine = edgeLine;
                    mesh.userData.restEdgeOpacity = FLOOR_LOOK.edge;
                }
            }

            /* What the floors need to know from the sheet: every floor's units, those of
               them that pass the filters — all filters EXCEPT the floor one, or picking a
               floor would make the other floors unpickable — and which floor is selected. */
            function getThreeFloorSets() {
                const group = (rows) => {
                    const map = new Map();
                    rows.forEach((u) => { if (!map.has(u.floor)) map.set(u.floor, []); map.get(u.floor).push(u); });
                    return map;
                };
                const units = allUnits || [];
                let rows = units, picked = "";
                if (typeof getFilteredTableUnits === "function") {
                    picked = TABLE_FILTERS.floor || "";
                    TABLE_FILTERS.floor = "";
                    try { rows = getFilteredTableUnits(); } finally { TABLE_FILTERS.floor = picked; } // restore before anything else can read it
                }
                const open = highlightedUnitId ? units.find((u) => u.id === highlightedUnitId) : null;
                return { all: group(units), matching: group(rows), picked, opened: open ? open.floor : "" };
            }

            // A floor is as available as its best unit.
            function floorStatus(units) {
                if (!units.length || units.some((u) => u.status === "available")) return "available";
                return units.some((u) => u.status === "reserved") ? "reserved" : "sold";
            }

            function paintFloorMesh(mesh, sets) {
                if (!mesh.material) return;
                const key = mesh.userData.floorKey;
                const units = sets.matching.get(key) || [];
                // Once the sheet is in: a floor with nothing to show goes grey and stops answering the pointer.
                const ghost = sets.all.size > 0 && !units.length;
                const selected = !ghost && (key === sets.picked || key === sets.opened);
                const edge = mesh.userData.edgeLine;

                mesh.visible = true;
                mesh.userData.ghosted = ghost;
                mesh.userData.status = floorStatus(units);
                // Overlay: see-through over the photo. 3D view: solid, so it must occlude what is behind it.
                mesh.material.depthWrite = !!(is3DMode && !ghost);

                const rest = ghost ? (is3DMode ? 0.16 : FLOOR_LOOK.ghost) : is3DMode ? 1 : selected ? FLOOR_LOOK.selected : FLOOR_LOOK.rest;
                const own = FLOOR_LOOK.colors && FLOOR_LOOK.colors[key]; // the fixed colour picked for this floor in the dashboard, if any
                mesh.material.color.set(ghost ? 0x8d97a3 : own != null ? own : THREE_STATUS_COLORS[mesh.userData.status]);
                mesh.material.opacity = rest;
                mesh.userData.restOpacity = rest;
                if (edge) {
                    const edgeRest = ghost ? FLOOR_LOOK.edgeGhost : is3DMode ? 0.9 : selected ? FLOOR_LOOK.edgeSelected : FLOOR_LOOK.edge;
                    edge.visible = true;
                    // Over the photo a white line reads on anything. On the solid plates of the 3D
                    // view it is a dark shade of the floor's own colour that separates the storeys.
                    const darkEdge = own != null ? darkenHex(own, 0.6) : THREE_STATUS_EDGE_COLORS[mesh.userData.status];
                    edge.material.color.set(is3DMode && !ghost ? darkEdge : (UNIT_OUTLINE_COLOR ?? darkEdge));
                    edge.material.opacity = edgeRest;
                    mesh.userData.restEdgeOpacity = edgeRest;
                }
            }

            // The floor's summary, next to the pointer. Rebuilt only when another floor comes under it.
            let floorCardKey = "";
            function showFloorHoverCard(floorKey, event) {
                const card = document.getElementById("floorHoverCard");
                if (!card) return;
                document.getElementById("unitHoverCard")?.classList.remove("show");

                if (floorCardKey !== floorKey) {
                    floorCardKey = floorKey;
                    const units = getThreeFloorSets().matching.get(floorKey) || [];
                    const count = (status) => units.filter((u) => u.status === status).length;

                    // the floor's title: the project's own name when it is a full title ("3rd Floor", projects.js → floors), else the
                    // classic names (Khawalid 20 names its floors "Ground", "First" — those stay "Ground Floor", "First Floor"), else the name
                    const ownFloorName = ((PROJECT.floors || []).find((f) => String(f.key) === floorKey) || {}).name || "";
                    document.getElementById("floorHoverName").textContent = (/floor/i.test(ownFloorName) ? ownFloorName : "") || FLOOR_TITLES[floorKey] || ownFloorName || floorKey;
                    document.getElementById("floorHoverCount").textContent = units.length + (units.length === 1 ? " apartment" : " apartments");
                    document.getElementById("floorHoverStats").innerHTML = [["available", "Available"], ["reserved", "Reserved"], ["sold", "Sold"]]
                        .filter(([status]) => count(status))
                        .map(([status, label]) => `<span class="floor-hover-stat ${status}"><b>${count(status)}</b><span>${label}</span></span>`)
                        .join("");

                    // one row per apartment type, then the span of areas and prices on the floor
                    const types = new Map();
                    units.forEach((u) => { const t = String(u.type || "").trim(); if (t && t !== "—") types.set(t, (types.get(t) || 0) + 1); });
                    const rows = [...types.entries()]
                        .sort((a, b) => (parseInt(a[0], 10) || 0) - (parseInt(b[0], 10) || 0) || a[0].localeCompare(b[0]))
                        .map(([type, n]) => [type, n + (n === 1 ? " unit" : " units")]);
                    const span = (values, format) => {
                        const lo = Math.min(...values), hi = Math.max(...values);
                        return lo === hi ? format(lo) : format(lo) + " – " + format(hi);
                    };
                    const areas = units.map(getAreaNumber).filter((v) => v > 0);
                    const prices = units.map((u) => Number(u.priceRaw) || 0).filter((v) => v > 0);
                    if (areas.length) rows.push(["Area", span(areas, (v) => String(Math.round(v))) + " m²"]);
                    if (prices.length) rows.push(["Price", span(prices, formatPriceShort) + " SAR"]);
                    document.getElementById("floorHoverInfo").innerHTML = rows
                        .map(([label, value]) => `<div class="unit-hover-row"><span>${escapeHtml(label)}</span><b>${escapeHtml(value)}</b></div>`)
                        .join("");
                }

                moveUnitHoverCard(event, card);
                card.classList.add("show");
            }

            function hideFloorHoverCard() {
                document.getElementById("floorHoverCard")?.classList.remove("show");
                floorCardKey = ""; // the numbers may have changed by the next hover
            }

            // A click on a floor: pick it and show its units.
            function selectFloorFromOverlay(floorKey) {
                hideUnitHoverCard();
                if (typeof window.showFloorUnits === "function") { window.showFloorUnits(floorKey); return; }
                // no Unit Search panel on the page: the table drawer does the same job
                TABLE_FILTERS.floor = floorKey;
                openUnitsTable();
            }

            function parseCSV(text) {
                const rows = [];
                let row = [];
                let cur = "";
                let quote = false;

                for (let i = 0; i < text.length; i++) {
                    const c = text[i];
                    const n = text[i + 1];

                    if (c === '"' && quote && n === '"') {
                        cur += '"';
                        i++;
                        continue;
                    }

                    if (c === '"') {
                        quote = !quote;
                        continue;
                    }

                    if (c === "," && !quote) {
                        row.push(cur);
                        cur = "";
                        continue;
                    }

                    if ((c === "\n" || c === "\r") && !quote) {
                        if (c === "\r" && n === "\n") i++;
                        row.push(cur);
                        rows.push(row);
                        row = [];
                        cur = "";
                        continue;
                    }

                    cur += c;
                }

                row.push(cur);
                rows.push(row);

                return rows.filter((r) => r.some((c) => String(c).trim() !== ""));
            }

            function findHeaderRow(rows) {
                return rows.findIndex(
                    (r) =>
                        r.some((c) => /row name|unit|name/i.test(c)) &&
                        r.some((c) => /floor/i.test(c)),
                );
            }

            function parseSheetRows(rows) {
                let headerIndex = findHeaderRow(rows);
                if (headerIndex < 0) headerIndex = 0;

                const headers = rows[headerIndex].map(normalizeHeader);

                return rows
                    .slice(headerIndex + 1)
                    .map((cols, index) => {
                        const row = {};

                        headers.forEach((header, i) => {
                            if (header) row[header] = String(cols[i] || "").trim();
                        });

                        const name = getVal(row, [
                            "rowname",
                            "name",
                            "unit",
                            "unitname",
                            "unitnumber",
                            "code",
                        ]);
                        const floorRaw = getVal(row, ["floor", "floornumber", "level"]);

                        if (!name || !floorRaw) return null;

                        const priceRaw = getVal(row, ["price", "totalprice", "unitprice"]);
                        const areaRaw = getVal(row, ["indoorarea", "area", "sqm", "m2"]);
                        const availability = getVal(row, [
                            "availability",
                            "available",
                            "status",
                        ]);
                        const type = getVal(row, ["type", "unittype"]);

                        const imgSource = getVal(row, [
                            "imgsource",
                            "image",
                            "imagesource",
                            "img",
                            "unitimage",
                        ]);
                        const brochure = getVal(row, [
                            "brochure",
                            "brochureurl",
                            "brochurelink",
                            "pdf",
                        ]);
                        const tour = getVal(row, [
                            "apartmenttour",
                            "tour",
                            "virtualtour",
                            "toururl",
                            "apttour",
                        ]);
                        const view3d = getVal(row, [
                            "apartment3dview",
                            "3dview",
                            "3d",
                            "threedview",
                            "threed",
                        ]);
                        const balcony = getVal(row, [
                            "balconyview",
                            "balcony",
                            "balconyurl",
                        ]);
                        const plans = getVal(row, [
                            "plans",
                            "plan",
                            "floorplan",
                            "planurl",
                            "floorplanurl",
                        ]);

                        return {
                            id: name + "-" + index,
                            name,
                            floorRaw,
                            floor: normalizeFloor(floorRaw),
                            area: areaRaw ? areaRaw + " m²" : "—",
                            price: formatPrice(priceRaw),
                            priceRaw: Number(String(priceRaw).replace(/,/g, "")) || 0,
                            status: statusKey(availability),
                            availability: availability || "Available",
                            type: type || "—",

                            points: getVal(row, [
                                "points",
                                "polygon",
                                "coords",
                                "coordinates",
                            ]),
                            x: Number(getVal(row, ["x", "left"])) || null,
                            y: Number(getVal(row, ["y", "top"])) || null,
                            w: Number(getVal(row, ["w", "width"])) || null,
                            h: Number(getVal(row, ["h", "height"])) || null,

                            imgSource,
                            brochure,
                            tour,
                            view3d,
                            balcony,
                            plans,
                        };
                    })
                    .filter(Boolean);
            }

            function parseSheet(text) {
                return parseSheetRows(parseCSV(text));
            }

            function cacheBustUrl(url) {
                const separator = url.includes("?") ? "&" : "?";
                return `${url}${separator}t=${Date.now()}`;
            }

            function assertSheetText(text, sourceName) {
                const trimmed = String(text || "").trim();

                if (!trimmed) {
                    throw new Error(`${sourceName} returned an empty response`);
                }

                if (trimmed.startsWith("<")) {
                    throw new Error(
                        `${sourceName} returned HTML instead of sheet data`,
                    );
                }

                return text;
            }

            async function fetchSheetCsv() {
                const urls = [
                    { name: "Google Visualization CSV", url: GVIZ_CSV_URL },
                    { name: "Google CSV export", url: CSV_URL },
                ];
                const errors = [];

                for (const source of urls) {
                    try {
                        const res = await fetch(cacheBustUrl(source.url), {
                            cache: "no-store",
                        });

                        if (!res.ok) {
                            throw new Error(`HTTP ${res.status} ${res.statusText}`.trim());
                        }

                        return assertSheetText(await res.text(), source.name);
                    } catch (error) {
                        errors.push(`${source.name}: ${error.message}`);
                    }
                }

                throw new Error(errors.join(" | "));
            }

            function googleTableToRows(table) {
                if (!table || !Array.isArray(table.cols) || !Array.isArray(table.rows)) {
                    throw new Error("Google Visualization returned no table data");
                }

                const headers = table.cols.map((col) => col?.label || col?.id || "");
                const rows = table.rows.map((row) =>
                    headers.map((_, index) => {
                        const cell = row.c?.[index];
                        const value = cell?.f ?? cell?.v ?? "";

                        return value == null ? "" : String(value);
                    }),
                );

                return [headers, ...rows];
            }

            function fetchSheetRowsJsonp() {
                return new Promise((resolve, reject) => {
                    const callbackName = `__sheetJsonp_${Date.now()}_${Math.random()
                        .toString(36)
                        .slice(2)}`;
                    const script = document.createElement("script");
                    const timeout = setTimeout(() => {
                        cleanup();
                        reject(new Error("Google Visualization JSONP timed out"));
                    }, 12000);

                    function cleanup() {
                        clearTimeout(timeout);
                        delete window[callbackName];
                        script.remove();
                    }

                    window[callbackName] = (response) => {
                        cleanup();

                        if (response?.status === "error") {
                            const message =
                                response.errors
                                    ?.map(
                                        (error) =>
                                            error.detailed_message || error.message || error.reason,
                                    )
                                    .filter(Boolean)
                                    .join("; ") || "Google Visualization returned an error";

                            reject(new Error(message));
                            return;
                        }

                        try {
                            resolve(googleTableToRows(response?.table));
                        } catch (error) {
                            reject(error);
                        }
                    };

                    script.onerror = () => {
                        cleanup();
                        reject(new Error("Google Visualization JSONP script failed"));
                    };

                    const tqx = encodeURIComponent(
                        `out:json;responseHandler:${callbackName}`,
                    );
                    script.src = cacheBustUrl(`${GVIZ_JSON_URL}&tqx=${tqx}`);
                    document.head.appendChild(script);
                });
            }

            /* =========================================================
               UNITS DATA SOURCE — Supabase `units` table (REST)
            ========================================================= */
            const UNITS_TABLE = "units";
            // This project's rows only (projects.js; the `project` column of SQL section 8). A database that
            // has not run that section has no such column: the default project then reads the whole table
            // (its rows), any other project nothing — readSheetUnits falls back.
            const UNITS_REST_URL = `${SUPABASE_URL}/rest/v1/${UNITS_TABLE}?select=*&project=eq.${encodeURIComponent(PROJECT_ID)}`;
            const UNITS_REST_URL_LEGACY = `${SUPABASE_URL}/rest/v1/${UNITS_TABLE}?select=*`;
            let unitsLegacyTable = false; // true once the `project` column was found missing

            /* Rooms & features — the `units` columns of SQL section 9 (Khawalid Tower 2's workbook through
               tools/upload-tower2-units.js, or the dashboard's Edit unit → Rooms & features). The Unit Search
               panel offers a chip for each one the project's units vary in, and the unit panel lists them.
               kind: "choice" (one of `values`), "count" (a number), "bool" (yes / no). `label` is the English
               text — the Arabic comes from the i18n dictionary. */
            const UNIT_FEATURES = [
                { key: "facing", kind: "choice", label: "Facing", values: ["North", "South", "East", "West"] },
                { key: "master_bedrooms", kind: "count", label: "Master bedrooms" },
                { key: "bathrooms", kind: "count", label: "Bathrooms" },
                { key: "dressing_rooms", kind: "count", label: "Dressing rooms" },
                { key: "maid_room", kind: "bool", label: "Maid's room" },
                { key: "maid_bath", kind: "bool", label: "Maid's bath" },
                { key: "kitchen", kind: "bool", label: "Kitchen" },
                { key: "dining_room", kind: "bool", label: "Dining room" },
                { key: "living_room", kind: "bool", label: "Living room" },
                { key: "laundry_room", kind: "bool", label: "Laundry room" },
                { key: "balcony_terrace", kind: "bool", label: "Balcony / Terrace" },
            ];
            // { facing: "North", bathrooms: 2, maid_room: true, … } from a row — null for an empty or missing
            // column, and null altogether when the row has none of them (Khawalid 20, a database without section 9).
            function unitFeaturesFromRow(row) {
                const out = {};
                let any = false;
                for (const f of UNIT_FEATURES) {
                    const raw = row[f.key];
                    let v = null;
                    if (raw !== undefined && raw !== null && String(raw).trim() !== "") {
                        const s = String(raw).trim();
                        if (f.kind === "choice") v = s;
                        else if (f.kind === "count") { const n = Number(s); v = Number.isFinite(n) ? n : /^(true|yes)$/i.test(s) ? 1 : /^(false|no)$/i.test(s) ? 0 : null; }
                        else v = raw === true || /^(true|yes|1)$/i.test(s) ? true : raw === false || /^(false|no|0)$/i.test(s) ? false : null;
                    }
                    out[f.key] = v;
                    if (v !== null) any = true;
                }
                return any ? out : null;
            }

            /* Map one Supabase row to the internal unit model.
               col_g..col_l are media columns — reorder this block if their meaning
               differs from the assumed order below. */
            function mapSupabaseUnit(row, index) {
                const name = String(row.unit_name || "").trim();
                const floorRaw = String(row.floor || "").trim();
                if (!name || !floorRaw) return null;

                const areaRaw = String(row.area || "").trim();
                const priceRaw = String(row.price || "").trim();
                const availability = String(row.availability || "").trim();

                return {
                    id: name + "-" + index,
                    name,
                    floorRaw,
                    floor: normalizeFloor(floorRaw),
                    area: areaRaw ? areaRaw + " m²" : "—",
                    price: formatPrice(priceRaw),
                    priceRaw: Number(priceRaw.replace(/,/g, "")) || 0,
                    status: statusKey(availability),
                    availability: availability || "Available",
                    type: row.type || "—",
                    model: row.model || "", // the unit's prototype name ("Model A"), when the project has them (SQL section 8)
                    bedrooms: row.bedrooms ?? null, // the areas sheet's BR column (section 2b of the SQL), when present
                    features: unitFeaturesFromRow(row), // rooms & features (section 9), null when the row has none
                    phase: row.phase || "",

                    points: "",
                    x: null,
                    y: null,
                    w: null,
                    h: null,

                    imgSource: row.col_g || "", // unit photo
                    brochure: row.col_h || "", // brochure / PDF
                    tour: row.col_i || "", // virtual tour
                    balcony: row.col_j || "", // balcony / view
                    view3d: row.col_k || "", // 3D walkthrough
                    plans: row.col_l || "", // floor plan image
                };
            }

            async function readSheetUnits() {
                if (!SUPABASE_URL) return []; // config.js not filled in yet — nothing to fetch
                const headers = { apikey: SUPABASE_ANON_KEY, Authorization: "Bearer " + SUPABASE_ANON_KEY };
                const isDefault = PROJECT_ID === window.MAAZAR_DEFAULT_PROJECT;
                if (unitsLegacyTable && !isDefault) return []; // (no `project` column: the table is the default project's — see below)
                let res = await fetch(unitsLegacyTable ? UNITS_REST_URL_LEGACY : UNITS_REST_URL, { headers, cache: "no-store" });
                if (res.status === 400 && !unitsLegacyTable) {
                    // No `project` column yet (section 8 of admin/supabase-setup.sql not run): the table holds the default project's units.
                    unitsLegacyTable = true;
                    console.warn("[units] the units table has no `project` column yet — run admin/supabase-setup.sql (section 8). " +
                        (isDefault ? "Showing the whole table as " + PROJECT_ID + "." : "No units for " + PROJECT_ID + " until then."));
                    if (!isDefault) return [];
                    res = await fetch(UNITS_REST_URL_LEGACY, { headers, cache: "no-store" });
                }

                if (!res.ok) {
                    throw new Error(`Supabase HTTP ${res.status} ${res.statusText}`.trim());
                }

                const rows = await res.json();
                if (!Array.isArray(rows)) {
                    throw new Error("Supabase returned an unexpected (non-array) response");
                }

                return rows.map(mapSupabaseUnit).filter(Boolean);
            }

            async function loadSheet(options = {}) {
                const { silent = false } = options;

                try {
                    if (!silent) $("#sheetLoading").classList.remove("hide");

                    const newUnits = await readSheetUnits();

                    if (!newUnits.length) {
                        // Al Maazar has no unit data yet — an empty table is expected, not
                        // an error. The lists simply render empty until rows are added
                        // from admin/index.html.
                        console.warn("[units] the `units` table is empty — add units from admin/index.html");
                    }

                    const newHash = JSON.stringify(newUnits);

                    if (newHash !== lastSheetHash) {
                        lastSheetHash = newHash;
                        allUnits = newUnits;

                        console.log("Sheet updated:", allUnits.length, allUnits);

                        if (activeFloor) {
                            renderFloor();
                        }

                        if (typeof renderUnitsTable === "function") {
                            renderUnitsTable();
                            renderCompare();
                            applyThreeUnitsFromSheet();
                        }

                        if (typeof maybeOpenUnitFromUrl === "function") {
                            maybeOpenUnitFromUrl();
                        }
                    }
                } catch (e) {
                    console.error(e);

                    if (!silent) {
                        alert(
                            `Could not load units from Supabase. Make sure the \`units\` table has a public read (RLS) policy for the anon role.\n\nDetails: ${e.message}`,
                        );
                    }
                } finally {
                    if (!silent) {
                        $("#sheetLoading").classList.add("hide");
                        initFloors();
                    }
                }
            }

            function startSheetAutoRefresh(ms = SHEET_REFRESH_INTERVAL) {
                if (sheetRefreshTimer) clearInterval(sheetRefreshTimer);

                sheetRefreshTimer = setInterval(() => {
                    loadSheet({ silent: true });
                }, ms);
            }

            function floorUnits() {
                const q = $("#unitSearch").value.toLowerCase().trim();

                return allUnits.filter((unit) => {
                    if (unit.floor !== activeFloor) return false;
                    if (!filters[unit.status]) return false;
                    if (q && !unit.name.toLowerCase().includes(q)) return false;

                    return true;
                });
            }

            function initFloors() {
                const tt = $("#tooltip");

                $$(".floor-hotspot").forEach((hs) => {
                    hs.addEventListener("mousemove", (e) => {
                        const floor = normalizeFloor(hs.dataset.floor);
                        const arr = allUnits.filter((unit) => unit.floor === floor);
                        const av = arr.filter((unit) => unit.status === "available").length;

                        tt.textContent = `${hs.dataset.title || hs.dataset.floor} · ${av} available of ${arr.length}`;
                        tt.style.left = e.clientX + "px";
                        tt.style.top = e.clientY + "px";
                        tt.classList.add("show");
                    });

                    hs.addEventListener("mouseleave", () => {
                        tt.classList.remove("show");
                    });

                    hs.addEventListener("click", () => {
                        openFloor(hs);
                    });
                });
            }

            function openFloor(hs) {
                if (currentHotspot) currentHotspot.classList.remove("active");

                currentHotspot = hs;
                hs.classList.add("active");

                activeFloorRaw = hs.dataset.floor;
                activeFloor = normalizeFloor(activeFloorRaw);
                activeVideo = hs.dataset.video || "";

                $("#floorTitle").textContent =
                    hs.dataset.title || `Floor ${activeFloorRaw}`;
                $("#floorSub").textContent =
                    `Floor: ${activeFloorRaw} · Units from Google Sheet`;
                $("#unitSearch").value = "";

                loadFloorVideo(activeVideo);

                $("#floorOverlay").classList.add("show");
                renderFloor();
            }

            function loadFloorVideo(videoUrl) {
                const video = $("#floorVideo");
                const fallback = $("#videoFallback");

                fallback.classList.remove("show");
                video.pause();
                video.removeAttribute("src");
                video.load();

                if (!videoUrl) {
                    fallback.classList.add("show");
                    return;
                }

                video.src = videoUrl;
                video.load();

                video.oncanplay = () => {
                    fallback.classList.remove("show");
                    video.play().catch(() => { });
                };

                video.onerror = () => {
                    console.warn("Floor video failed to load:", videoUrl);
                    fallback.classList.add("show");
                };
            }

            function closeFloor() {
                $("#floorOverlay").classList.remove("show");

                const video = $("#floorVideo");
                video.pause();

                if (currentHotspot) currentHotspot.classList.remove("active");
                currentHotspot = null;
            }

            function renderFloor() {
                const units = floorUnits();

                renderStats(units);
                renderUnitShapes(units);
                renderCards(units);
            }

            function renderStats(units) {
                const allOnFloor = allUnits.filter(
                    (unit) => unit.floor === activeFloor,
                );

                $("#stAvailable").textContent = allOnFloor.filter(
                    (unit) => unit.status === "available",
                ).length;
                $("#stReserved").textContent = allOnFloor.filter(
                    (unit) => unit.status === "reserved",
                ).length;
                $("#stSold").textContent = allOnFloor.filter(
                    (unit) => unit.status === "sold",
                ).length;

                const prices = allOnFloor.map((unit) => unit.priceRaw).filter(Boolean);

                $("#priceRange").textContent = prices.length
                    ? `Price range: ${formatPrice(Math.min(...prices))} — ${formatPrice(Math.max(...prices))}`
                    : "Price range: —";
            }

            function autoRect(i, total) {
                const cols = Math.ceil(Math.sqrt(total * 1.5));
                const gap = 10;
                const w = (1000 - gap * (cols + 1)) / cols;
                const rows = Math.ceil(total / cols);
                const h = Math.min(70, (650 - gap * (rows + 1)) / rows);
                const col = i % cols;
                const row = Math.floor(i / cols);
                const x = gap + col * (w + gap);
                const y = gap + row * (h + gap);

                return { x, y, w, h };
            }

            function renderUnitShapes(units) {
                const svg = $("#unitSvg");
                svg.innerHTML = "";

                units.forEach((unit, i) => {
                    let shape;
                    let cx;
                    let cy;

                    if (unit.points) {
                        shape = document.createElementNS(
                            "http://www.w3.org/2000/svg",
                            "polygon",
                        );
                        shape.setAttribute("points", unit.points);

                        const nums = unit.points.match(/-?\d+(\.\d+)?/g)?.map(Number) || [];
                        const xs = nums.filter((_, i) => i % 2 === 0);
                        const ys = nums.filter((_, i) => i % 2 === 1);

                        cx = xs.reduce((a, b) => a + b, 0) / Math.max(xs.length, 1);
                        cy = ys.reduce((a, b) => a + b, 0) / Math.max(ys.length, 1);
                    } else {
                        const r =
                            unit.x && unit.y && unit.w && unit.h
                                ? unit
                                : autoRect(i, units.length);

                        shape = document.createElementNS(
                            "http://www.w3.org/2000/svg",
                            "rect",
                        );
                        shape.setAttribute("x", r.x);
                        shape.setAttribute("y", r.y);
                        shape.setAttribute("width", r.w);
                        shape.setAttribute("height", r.h);
                        shape.setAttribute("rx", 8);

                        cx = r.x + r.w / 2;
                        cy = r.y + r.h / 2;
                    }

                    shape.classList.add("unit-shape", unit.status);

                    shape.addEventListener("mousemove", (e) => {
                        showUnitHoverCard(unit, e);
                    });

                    shape.addEventListener("mouseleave", () => {
                        hideUnitHoverCard();
                    });

                    shape.addEventListener("click", () => openUnit(unit));

                    svg.appendChild(shape);

                    const label = document.createElementNS(
                        "http://www.w3.org/2000/svg",
                        "text",
                    );
                    label.classList.add("unit-label");
                    label.setAttribute("x", cx);
                    label.setAttribute("y", cy);
                    label.setAttribute("text-anchor", "middle");
                    label.setAttribute("dominant-baseline", "middle");
                    label.textContent = unit.name;
                    svg.appendChild(label);
                });
            }

            function renderCards(units) {
                const grid = $("#cardsGrid");
                grid.innerHTML = "";

                if (!units.length) {
                    grid.innerHTML = `<div class="empty">No units match this floor/filter.</div>`;
                    return;
                }

                units.forEach((unit) => {
                    const div = document.createElement("div");
                    div.className = `unit-card ${unit.status}`;

                    div.innerHTML = `
      <strong>${unit.name}</strong>
      <span>${unit.area}</span>
      <span>${unit.price}</span>
      <span class="badge ${unit.status}">${unit.availability}</span>
    `;

                    div.addEventListener("mousemove", (e) => {
                        showUnitHoverCard(unit, e);
                    });

                    div.addEventListener("mouseleave", () => {
                        hideUnitHoverCard();
                    });

                    div.addEventListener("click", () => openUnit(unit));

                    grid.appendChild(div);
                });
            }

            /* The unit panel's Rooms & features block (UNIT_FEATURES): Facing and the counts as detail
               rows, the yes / no features the unit HAS as pills; hidden for a unit without the data
               (Khawalid 20) and for an amenity. */
            function renderSideFeatures(unit) {
                const section = $("#sideFeaturesSection");
                if (!section) return;
                const f = unit.features;
                if (!f || isAmenityUnit(unit)) { section.style.display = "none"; return; }
                const tr = (s) => (window.i18n ? window.i18n.t(s) : s);
                const rows = [], pills = [];
                for (const def of UNIT_FEATURES) {
                    const v = f[def.key];
                    if (v === null || v === undefined) continue;
                    if (def.kind === "choice") rows.push([def.label, tr(String(v))]);
                    else if (def.kind === "count") rows.push([def.label, String(v)]);
                    else if (v === true) pills.push(def.label);
                }
                if (!rows.length && !pills.length) { section.style.display = "none"; return; }
                $("#sideFeatureRows").innerHTML = rows
                    .map(([k, v]) => '<div class="unit-side-detail"><span>' + escapeHtml(tr(k)) + "</span><b>" + escapeHtml(v) + "</b></div>")
                    .join("");
                $("#sideFeatureChips").innerHTML = pills
                    .map((p) => '<span class="unit-side-feature">' + escapeHtml(tr(p)) + "</span>")
                    .join("");
                section.style.display = "";
            }

            function openUnit(unit) {
                if (!unit) return;

                currentUnit = unit;
                hideUnitHoverCard();

                const sideMenu = $("#unitSideMenu");

                if (!sideMenu) {
                    console.error("Unit side menu element was not found");
                    return;
                }

                $("#unitSideBackdrop")?.classList.add("show");
                sideMenu.classList.add("show");

                updateSideCompareButton(unit);

                const amenity = isAmenityUnit(unit); // a shared space (projects.js floors → amenities): no bedrooms, price, Compare or sales button
                $("#sideUnitName").textContent = unit.name || "Unit";
                $("#sideUnitSub").textContent = amenity ? (unit.area || "—") : `${unit.model ? unit.model + " · " : ""}${unit.type || "—"} · ${unit.area || "—"}`;

                $("#sideUnitFloor").textContent = unit.floorRaw || unit.floor || "—";
                $("#sideUnitRooms").textContent = unitBedrooms(unit) || unit.type || "—";
                $("#sideUnitArea").textContent = unit.area || "—";
                $("#sideUnitPrice").textContent = unit.price || "—";
                $("#sideUnitRooms").closest(".unit-side-detail").style.display = amenity ? "none" : "";
                $("#sideUnitPrice").closest(".unit-side-detail").style.display = amenity ? "none" : "";
                renderSideFeatures(unit);
                const sideActions = $("#sideWhatsApp").closest(".unit-side-section"); // the WhatsApp + Compare buttons
                if (sideActions) sideActions.style.display = amenity ? "none" : "";

                const planOnTop = renderSideUnitImage(unit);
                const renders = renderSide3d(unit);
                // What the cards above already show needs no button in the Media grid.
                setSideMediaBtn("sideImg", renders ? "" : unit.imgSource, "Open image");
                setSideMediaBtn("sideBrochure", unit.brochure, "Open brochure");
                setSideMediaBtn("sideTour", unit.tour, "Open tour");
                setSideMediaBtn("side3D", unit.view3d, "Open 3D");
                setSideMediaBtn("sideBalcony", unit.balcony, "Open view");
                setSideMediaBtn("sidePlan", planOnTop ? "" : unit.plans, "Open plans");
                syncSideMediaBlock();

                $("#unitSideBackdrop").classList.add("show");
                $("#unitSideMenu").classList.add("show");
            }

            // No media buttons left → drop the whole Media block (title + grid).
            function syncSideMediaBlock() {
                const mediaGrid = $("#unitSideMenu .unit-side-media-grid");
                if (!mediaGrid) return;
                const anyMedia = [...mediaGrid.querySelectorAll(".unit-side-media")].some((b) => b.style.display !== "none");
                mediaGrid.style.display = anyMedia ? "" : "none";
                const title = mediaGrid.previousElementSibling;
                if (title && title.classList.contains("unit-side-section-title")) title.style.display = anyMedia ? "" : "none";
            }

            function openUnitSideMenu(unit) {
                openUnit(unit);
            }

            const isImageUrl = (url) => /\.(jpe?g|png|gif|webp|svg|bmp|avif)(\?[^#]*)?(#.*)?$/i.test(String(url || "").trim());
            /* units.col_l may hold several plan links (a townhouse: one drawing per level), separated by spaces, commas or new
               lines — tools/upload-plans.js writes them so. The cards show the first; the Floor Plans modal shows all of them. */
            function planUrls(unit) { return String((unit && unit.plans) || "").split(/[\s,]+/).map((u) => u.trim()).filter(Boolean); }

            /* "2 Bedrooms" → "2" (the sheet's bedrooms column when the row has it). */
            function unitBedrooms(unit) {
                if (unit.bedrooms != null && String(unit.bedrooms).trim() !== "") return String(unit.bedrooms).trim();
                const m = String(unit.type || "").match(/\d+/);
                return m ? m[0] : "";
            }

            /* The top card: the unit's floor plan when the link is an image (a PDF or a
               web page stays behind the "Open plans" button), else the unit photo.
               Returns true when the plan is the card. */
            function renderSideUnitImage(unit) {
                const box = $("#sideUnitImage");
                if (!box) return false;

                const statusText = escapeHtml(unit.availability || unit.status || "Available");
                const statusClass = escapeHtml(unit.status || "available");
                const badge = `<span class="unit-side-badge ${statusClass}">${statusText}</span>`;
                const plans = planUrls(unit);
                const plan = plans[0] || "";
                const isPlan = isImageUrl(plan);
                const src = isPlan ? plan : String(unit.imgSource || "").trim();

                box.classList.toggle("is-plan", isPlan);
                box.onclick = isPlan ? () => openMedia("plan") : null;
                box.title = isPlan ? "Open plans" : "";

                if (src) {
                    box.innerHTML = `
      <img
        src="${escapeHtml(src)}"
        alt="${escapeHtml(isPlan ? "Floor plan" : unit.name)}"
        onerror="this.parentElement.innerHTML='<div class=&quot;unit-side-image-empty&quot;>Image failed to load</div>'"
      />
      ${badge}
      ${isPlan ? `<span class="unit-side-image-zoom">${plans.length > 1 ? "⤢ View all plans" : "⤢ View full size"}</span>` : ""}
    `;
                } else {
                    box.innerHTML = `<div class="unit-side-image-empty">No image available</div>${badge}`;
                }
                return isPlan;
            }

            /* The 3D renders of this unit's type: the gallery's "Unit Prototypes" rows
               whose subcategory is the type (the brochure's plan pages, titled
               "Prototype 0n …", are not renders and are left out). Falls back to the
               unit's own photo. */
            function unit3dImages(unit) {
                const data = typeof GALLERY_DATA !== "undefined" ? GALLERY_DATA : [];
                // An amenity (projects.js floors → amenities) has no type: its 3D images are the gallery rows whose subcategory is
                // the unit's name (the amenities brochure through tools/upload-prototypes.js --catalog tools/amenities-catalog.json,
                // or any image given that subcategory in the dashboard).
                if (typeof isAmenityUnit === "function" && isAmenityUnit(unit)) {
                    const key = normalizeUnitName(unit.name);
                    const mine = data.filter((i) => i.src && normalizeUnitName(i.subcategory) === key);
                    if (mine.length) return mine;
                }
                const type = String(unit.type || "").trim();
                const renders = data
                    .filter((i) => i.category === "prototypes" && i.subcategory === type && i.src && !/^prototype\s*\d/i.test(i.title || ""));
                if (renders.length) return renders;
                const hero = String(unit.imgSource || "").trim();
                return hero && isImageUrl(hero) ? [{ src: hero, thumb: hero, title: unit.name, title_ar: unit.name }] : [];
            }

            /* Returns the number of renders shown (0 hides the section). */
            function renderSide3d(unit) {
                const section = $("#side3dSection");
                const strip = $("#side3dStrip");
                if (!section || !strip) return 0;

                const items = unit3dImages(unit);
                strip.innerHTML = "";
                section.style.display = items.length ? "" : "none";
                $("#side3dCount").textContent = items.length > 1 ? `· ${items.length}` : "";

                items.forEach((item, idx) => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "unit-side-3d-item";
                    const title = (typeof galleryItemTitle === "function" ? galleryItemTitle(item) : item.title) || "";
                    btn.title = title;
                    btn.innerHTML = `<img src="${escapeHtml(item.thumb || item.src)}" alt="${escapeHtml(title)}" loading="lazy" decoding="async" />${title ? `<span>${escapeHtml(title)}</span>` : ""}`;
                    btn.addEventListener("click", () => {
                        // Browse this unit's renders in the gallery lightbox (prev / next, captions)
                        galleryLbItems = items;
                        openGalleryLightbox(idx);
                    });
                    strip.appendChild(btn);
                });
                return items.length;
            }

            // The gallery rows arrive from Supabase after the page has loaded — refresh a panel that is already open
            document.addEventListener("gallery:loaded", () => {
                if (currentUnit && $("#unitSideMenu")?.classList.contains("show")) {
                    const renders = renderSide3d(currentUnit);
                    setSideMediaBtn("sideImg", renders ? "" : currentUnit.imgSource, "Open image");
                    syncSideMediaBlock();
                }
            });

            function setSideMediaBtn(id, url, availableText) {
                const btn = $("#" + id);
                if (!btn) return;

                const status = btn.querySelector(".unit-side-media-status");
                const has = !!(url && String(url).trim() !== "");

                // A unit shows only the media it actually has: slots without a link are
                // hidden (inline style, so it wins over the button's own display rule).
                btn.style.display = has ? "" : "none";
                btn.disabled = !has;
                if (status) status.textContent = has ? (availableText || "Open") : "Not available";
            }

            function closeUnitSideMenu() {
                $("#unitSideBackdrop")?.classList.remove("show");
                $("#unitSideMenu")?.classList.remove("show");
            }

            /* =========================================================
               SHARE A UNIT — deep-link (?unit=<name>) + copy-to-clipboard
            ========================================================= */
            function buildUnitShareUrl(unit) {
                if (!unit) return location.href;
                const base = location.origin + location.pathname;
                return `${base}?unit=${encodeURIComponent(unit.name)}`;
            }

            async function copyUnitShareLink(unit, btn) {
                if (!unit) return;
                const url = buildUnitShareUrl(unit);

                const flash = () => {
                    if (!btn) return;
                    btn.classList.add("copied");
                    btn.title = "Link copied!";
                    setTimeout(() => {
                        btn.classList.remove("copied");
                        btn.title = "Copy share link";
                    }, 1600);
                };

                try {
                    await navigator.clipboard.writeText(url);
                    flash();
                } catch (_) {
                    // Fallback for non-secure contexts / older browsers.
                    const ta = document.createElement("textarea");
                    ta.value = url;
                    ta.style.position = "fixed";
                    ta.style.opacity = "0";
                    document.body.appendChild(ta);
                    ta.select();
                    try {
                        document.execCommand("copy");
                        flash();
                    } catch (e) { }
                    ta.remove();
                }
            }

            // Open the unit named in the URL (?unit=...) once, after data has loaded.
            let deepLinkHandled = false;
            function maybeOpenUnitFromUrl() {
                if (deepLinkHandled) return;
                if (!allUnits || !allUnits.length) return;

                const wanted = new URLSearchParams(location.search).get("unit");
                if (!wanted) {
                    deepLinkHandled = true;
                    return;
                }

                const target =
                    allUnits.find((u) => u.name === wanted) ||
                    allUnits.find((u) => u.id === wanted);

                deepLinkHandled = true;
                if (!target) return;

                // Light up the unit in 3D too, mirroring the table-row open behaviour.
                // The 3D scene may not be ready on first load, so fail soft.
                try {
                    if (typeof highlightUnitInThree === "function") highlightUnitInThree(target);
                } catch (e) { }
                openUnit(target);
            }

            function openFirstAvailableMedia() {
                if (!currentUnit) return;

                const mediaOrder = [
                    ["img", currentUnit.imgSource],
                    ["brochure", currentUnit.brochure],
                    ["tour", currentUnit.tour],
                    ["3d", currentUnit.view3d],
                    ["balcony", currentUnit.balcony],
                    ["plan", currentUnit.plans],
                ];

                const first = mediaOrder.find((item) => item[1] && item[1].trim() !== "");

                if (first) {
                    openMedia(first[0]);
                }
            }

            function setMediaBtn(id, url, label) {
                const btn = $("#" + id);
                if (!btn) return;

                const icon =
                    btn.dataset.icon ||
                    (btn.querySelector(".icon")
                        ? btn.querySelector(".icon").textContent
                        : "");
                btn.dataset.icon = icon;

                if (url && url.trim() !== "") {
                    btn.disabled = false;
                    btn.title = "Open " + label;
                    btn.innerHTML = `<span class="icon">${icon}</span> ${label}`;
                } else {
                    btn.disabled = true;
                    btn.title = label + " not available";
                    btn.innerHTML = `<span class="icon">${icon}</span> ${label} <span style="font-size:10px;opacity:.5">(N/A)</span>`;
                }
            }

            const MEDIA_LABELS = {
                img: "Image",
                brochure: "Brochure",
                tour: "Apartment Tour",
                "3d": "3D View",
                balcony: "Balcony View",
                plan: "Floor Plans",
            };

            const MEDIA_ICONS = {
                img: "🖼️",
                brochure: "📄",
                tour: "🎥",
                "3d": "🧊",
                balcony: "🌅",
                plan: "📐",
            };

            // Convert Google Drive / Docs sharing links into their embeddable
            // "/preview" form. A raw /view or /edit link rendered in an iframe shows
            // the full Drive UI (and a "You need access" wall), whereas /preview
            // shows a clean embedded viewer.
            function toEmbeddableUrl(url) {
                if (!url) return url;
                const u = url.trim();

                // drive.google.com/file/d/FILE_ID/view  ->  /preview
                let m = u.match(/drive\.google\.com\/file\/d\/([^/]+)/i);
                if (m) return `https://drive.google.com/file/d/${m[1]}/preview`;

                // drive.google.com/open?id=FILE_ID  or  ...?id=FILE_ID  ->  /preview
                m = u.match(/drive\.google\.com\/(?:open|uc)\?(?:[^#]*&)?id=([^&#]+)/i);
                if (m) return `https://drive.google.com/file/d/${m[1]}/preview`;

                // docs.google.com/(document|presentation|spreadsheets)/d/ID/...  ->  /preview
                m = u.match(
                    /docs\.google\.com\/(document|presentation|spreadsheets)\/d\/([^/]+)/i
                );
                if (m) return `https://docs.google.com/${m[1]}/d/${m[2]}/preview`;

                return u;
            }

            /* The Floor Plans tab with several drawings (a townhouse's levels): side by side, each fitted to its column
               (stacked on a narrow screen); a click on one shows it alone, zoomable like a single drawing, and the
               "All plans" button brings them all back. */
            function renderPlanBody(list, focus) {
                const body = $("#mediaBody");
                body.innerHTML = "";
                body.classList.remove("zoomed");
                body.classList.toggle("multi", focus == null);
                if (focus == null) {
                    list.forEach((u, i) => {
                        const fig = document.createElement("figure");
                        fig.className = "media-multi-item";
                        const img = document.createElement("img");
                        img.src = u; img.alt = `${MEDIA_LABELS.plan} ${i + 1}`; img.draggable = false; img.loading = "lazy"; img.title = "Click to enlarge";
                        img.addEventListener("click", () => renderPlanBody(list, i));
                        const cap = document.createElement("figcaption"); cap.textContent = `${i + 1} / ${list.length}`;
                        fig.appendChild(img); fig.appendChild(cap); body.appendChild(fig);
                    });
                } else {
                    const img = document.createElement("img");
                    img.src = list[focus]; img.alt = `${MEDIA_LABELS.plan} ${focus + 1}`; img.className = "media-zoomable"; img.title = "Click to zoom"; img.draggable = false;
                    img.addEventListener("click", (e) => toggleMediaZoom(e, img));
                    body.appendChild(img);
                    const back = document.createElement("button");
                    back.type = "button"; back.className = "media-back"; back.textContent = "◂ All plans";
                    back.addEventListener("click", () => renderPlanBody(list, null));
                    body.appendChild(back);
                }
            }

            function openMedia(tab) {
                if (!currentUnit) return;

                currentMediaTab = tab;

                const modal = $("#mediaModal");
                const title = $("#mediaTitle");
                const sub = $("#mediaSub");
                const body = $("#mediaBody");

                title.textContent = MEDIA_LABELS[tab] || "Media";
                sub.textContent = `${currentUnit.name} — ${currentUnit.type} — ${currentUnit.area}`;

                $$(".media-tab").forEach((t) => {
                    t.classList.toggle("active", t.dataset.tab === tab);
                });

                const urlMap = {
                    img: currentUnit.imgSource,
                    brochure: currentUnit.brochure,
                    tour: currentUnit.tour,
                    "3d": currentUnit.view3d,
                    balcony: currentUnit.balcony,
                    plan: currentUnit.plans,
                };

                // Tabs mirror the side panel: no link → no tab.
                $$("#mediaTabs .media-tab").forEach((t) => {
                    const u = urlMap[t.dataset.tab];
                    t.style.display = u && String(u).trim() !== "" ? "" : "none";
                });

                // the plan tab may hold several drawings (planUrls); the other tabs one link
                const list = (tab === "plan" ? planUrls(currentUnit) : [urlMap[tab]]).map(toEmbeddableUrl).filter((u) => u && String(u).trim() !== "");
                const url = list[0] || "";
                const multi = list.length > 1 && list.every(isImageUrl);

                body.innerHTML = "";
                body.classList.remove("zoomed");
                body.classList.toggle("is-plan", tab === "plan");
                body.classList.toggle("multi", multi);

                if (url && url.trim() !== "") {
                    const isImage = isImageUrl(url);
                    const isPDF = /\.pdf(\?.*)?$/i.test(url);

                    if (tab === "tour" || tab === "3d") {
                        const iframe = document.createElement("iframe");
                        iframe.src = url;
                        iframe.title = MEDIA_LABELS[tab];
                        iframe.allow =
                            "fullscreen; autoplay; clipboard-write; gyroscope; accelerometer";
                        iframe.loading = "lazy";
                        iframe.sandbox =
                            "allow-scripts allow-same-origin allow-popups allow-forms allow-presentation";
                        body.appendChild(iframe);
                    } else if (isImage && multi) {
                        renderPlanBody(list, null); // several drawings (a townhouse's levels): side by side, each a click from its own zoom
                    } else if (isImage) {
                        const img = document.createElement("img");
                        img.src = url;
                        img.alt = MEDIA_LABELS[tab];
                        img.className = "media-zoomable";
                        img.title = "Click to zoom";
                        img.draggable = false;
                        img.addEventListener("click", (e) => toggleMediaZoom(e, img));

                        img.onerror = () => {
                            body.innerHTML = `
          <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:14px;">
            Failed to load image
          </div>
        `;
                        };

                        body.appendChild(img);
                    } else if (isPDF) {
                        const iframe = document.createElement("iframe");
                        iframe.src = url;
                        iframe.title = MEDIA_LABELS[tab];
                        body.appendChild(iframe);
                    } else {
                        const iframe = document.createElement("iframe");
                        iframe.src = url;
                        iframe.title = MEDIA_LABELS[tab];
                        iframe.allow = "fullscreen; autoplay; clipboard-write";
                        body.appendChild(iframe);
                    }
                } else {
                    body.innerHTML = `
      <div style="display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:12px;color:var(--muted);">
        <div style="font-size:40px;opacity:.3">${MEDIA_ICONS[tab]}</div>
        <div style="font-size:14px">No ${MEDIA_LABELS[tab].toLowerCase()} available for this unit.</div>
      </div>
    `;
                }

                modal.classList.add("show");
            }

            function closeMediaModal() {
                $("#mediaModal").classList.remove("show");

                setTimeout(() => {
                    $("#mediaBody").innerHTML = "";
                    $("#mediaBody").classList.remove("zoomed", "is-plan", "multi");
                }, 400);
            }

            /* Click an image in the modal: 1:1 pixels with the clicked point kept
               under the cursor (scroll or drag to pan); click again to fit. */
            let mediaDrag = null;
            let mediaDragMoved = false;

            function toggleMediaZoom(e, img) {
                const body = $("#mediaBody");
                if (mediaDragMoved) { mediaDragMoved = false; return; } // a pan ended on the image, not a click
                if (body.classList.contains("zoomed")) {
                    body.classList.remove("zoomed");
                    return;
                }
                // Where on the picture (not the letterboxed element) was clicked
                const r = img.getBoundingClientRect();
                const nw = img.naturalWidth || r.width, nh = img.naturalHeight || r.height;
                const scale = Math.min(r.width / nw, r.height / nh);
                const cw = nw * scale, ch = nh * scale;
                const fx = Math.min(1, Math.max(0, (e.clientX - (r.left + (r.width - cw) / 2)) / cw));
                const fy = Math.min(1, Math.max(0, (e.clientY - (r.top + (r.height - ch) / 2)) / ch));

                body.classList.add("zoomed");
                const b = body.getBoundingClientRect();
                body.scrollLeft = fx * img.offsetWidth - (e.clientX - b.left);
                body.scrollTop = fy * img.offsetHeight - (e.clientY - b.top);
            }

            (function () {
                const body = $("#mediaBody");
                if (!body) return;
                body.addEventListener("pointerdown", (e) => {
                    if (!body.classList.contains("zoomed") || e.pointerType === "touch" || e.button !== 0) return;
                    mediaDrag = { x: e.clientX, y: e.clientY, left: body.scrollLeft, top: body.scrollTop };
                    mediaDragMoved = false;
                    body.classList.add("dragging");
                });
                body.addEventListener("pointermove", (e) => {
                    if (!mediaDrag) return;
                    const dx = e.clientX - mediaDrag.x, dy = e.clientY - mediaDrag.y;
                    if (Math.abs(dx) + Math.abs(dy) > 4) mediaDragMoved = true;
                    body.scrollLeft = mediaDrag.left - dx;
                    body.scrollTop = mediaDrag.top - dy;
                });
                const end = () => { mediaDrag = null; body.classList.remove("dragging"); };
                body.addEventListener("pointerup", end);
                body.addEventListener("pointercancel", end);
                body.addEventListener("pointerleave", end);
            })();

            function switchMediaTab(tab) {
                if (!currentUnit) return;

                currentMediaTab = tab;
                openMedia(tab);
            }

            $("#mediaModal").addEventListener("click", function (e) {
                if (e.target === this) closeMediaModal();
            });
            $("#closeUnitSide").addEventListener("click", closeUnitSideMenu);

            $("#shareUnitBtn")?.addEventListener("click", (e) => {
                e.stopPropagation();
                copyUnitShareLink(currentUnit, e.currentTarget);
            });

            $("#unitSideBackdrop").addEventListener("click", closeUnitSideMenu);
            $("#closeFloor").addEventListener("click", closeFloor);

            $("#floorOverlay").addEventListener("click", (e) => {
                if (e.target.id === "floorOverlay") closeFloor();
            });

            $("#closeUnit").addEventListener("click", () => {
                $("#unitModal").classList.remove("show");
            });

            $("#unitModal").addEventListener("click", (e) => {
                if (e.target.id === "unitModal") {
                    $("#unitModal").classList.remove("show");
                }
            });

            $("#unitSearch").addEventListener("input", renderFloor);

            $$(".pill").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const filter = btn.dataset.filter;

                    filters[filter] = !filters[filter];
                    btn.classList.toggle("active", filters[filter]);

                    renderFloor();
                });
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") {
                    if ($("#mediaModal").classList.contains("show")) {
                        closeMediaModal();
                        return;
                    }

                    if ($("#unitModal").classList.contains("show")) {
                        $("#unitModal").classList.remove("show");
                        return;
                    }

                    closeFloor();
                }
            });

            loadSheet().then(() => {
                startSheetAutoRefresh();
            });

            /* =========================================================
               LIVE UPDATES — Supabase Realtime, no page reload
               The admin dashboard (and tools/*.js) broadcast { table } on the
               "mazaar-live" channel after every write; the viewer refetches that
               table at once. A second channel asks for Postgres row changes as
               well, so edits made straight in Supabase also arrive once section 6
               of admin/supabase-setup.sql has been run — until then that channel
               just reports "not enabled" and stays quiet. Polling remains as a
               fallback: every 60 s while the socket is up, every 15 s when down.
               Plain WebSocket + the Phoenix channel protocol (no client library).
            ========================================================= */
            const LIVE_CHANNEL = "mazaar-live";
            const LIVE_TABLES = ["units", "gallery", "gallery_categories", "site_settings"];
            let liveConnected = false;
            const liveTimers = {};

            function onLiveChange(table) {
                if (!table) return;
                clearTimeout(liveTimers[table]);
                liveTimers[table] = setTimeout(() => {
                    if (table === "units") {
                        Promise.resolve(loadSheet({ silent: true })).then(() => {
                            // keep an open unit panel in step with its row
                            const menu = $("#unitSideMenu");
                            if (typeof currentUnit !== "undefined" && currentUnit && menu && menu.classList.contains("show") && typeof openUnit === "function") {
                                const fresh = allUnits.find((u) => u.name === currentUnit.name);
                                if (fresh) openUnit(fresh);
                            }
                        });
                    } else if (table === "gallery" || table === "gallery_categories") {
                        if (typeof loadGalleryFromSupabase === "function") loadGalleryFromSupabase();
                    } else if (table === "site_settings") {
                        if (window.introHero) window.introHero.refresh();
                    }
                }, 350);
            }

            function startLiveUpdates() {
                if (!SUPABASE_URL || !SUPABASE_ANON_KEY || typeof WebSocket === "undefined") return;
                const wsUrl = SUPABASE_URL.replace(/^http/, "ws") + "/realtime/v1/websocket?apikey=" + encodeURIComponent(SUPABASE_ANON_KEY) + "&vsn=1.0.0";
                let ws = null, ref = 0, heartbeat = null, retry = 1000, pending = null;
                const send = (topic, event, payload) => { if (ws && ws.readyState === 1) ws.send(JSON.stringify({ topic, event, payload, ref: String(++ref) })); };
                const setConnected = (on) => {
                    if (liveConnected === on) return;
                    liveConnected = on;
                    startSheetAutoRefresh(on ? SHEET_REFRESH_INTERVAL * 4 : SHEET_REFRESH_INTERVAL);
                    console.info("[live] " + (on ? "connected — dashboard changes arrive without a reload" : "disconnected — polling every 15 s until it is back"));
                };
                const schedule = () => { clearTimeout(pending); pending = setTimeout(connect, retry); retry = Math.min(retry * 2, 30000); };
                function connect() {
                    clearTimeout(pending);
                    try { ws = new WebSocket(wsUrl); } catch (e) { schedule(); return; }
                    ws.onopen = () => {
                        retry = 1000;
                        send("realtime:" + LIVE_CHANNEL, "phx_join", { config: { broadcast: { self: false }, presence: { key: "" }, postgres_changes: [] }, access_token: SUPABASE_ANON_KEY });
                        send("realtime:mazaar-db", "phx_join", { config: { broadcast: { self: false }, presence: { key: "" }, postgres_changes: LIVE_TABLES.map((table) => ({ event: "*", schema: "public", table })) }, access_token: SUPABASE_ANON_KEY });
                        clearInterval(heartbeat);
                        heartbeat = setInterval(() => send("phoenix", "heartbeat", {}), 25000);
                    };
                    ws.onmessage = (e) => {
                        let m; try { m = JSON.parse(e.data); } catch (_) { return; }
                        const p = m.payload || {};
                        if (m.event === "phx_reply" && m.topic === "realtime:" + LIVE_CHANNEL && p.status === "ok") {
                            setConnected(true);
                            onLiveChange("units"); onLiveChange("gallery"); // catch up on anything missed while offline
                        } else if (m.event === "broadcast" && p.event === "change") {
                            onLiveChange(p.payload && p.payload.table);
                        } else if (m.event === "postgres_changes" && p.data) {
                            onLiveChange(p.data.table);
                        } else if (m.event === "system" && p.status === "error" && m.topic === "realtime:mazaar-db") {
                            console.info("[live] row-change feed not enabled on the project (section 6 of admin/supabase-setup.sql) — dashboard broadcasts still arrive");
                        }
                    };
                    ws.onclose = () => { clearInterval(heartbeat); setConnected(false); schedule(); };
                    ws.onerror = () => { /* onclose follows and reconnects */ };
                }
                document.addEventListener("visibilitychange", () => {
                    if (document.visibilityState !== "visible") return;
                    if (!ws || ws.readyState === 3) { retry = 1000; connect(); }
                    onLiveChange("units"); // a tab that was asleep refetches regardless
                });
                connect();
            }
            startLiveUpdates();
            /* =========================================================
         UNITS EXCEL TABLE DRAWER
      ========================================================= */

            const TABLE_FILTERS = {
                search: "",
                floor: "",
                status: "",
                minPrice: "",
                maxPrice: "",
                minArea: "",
                maxArea: "",
                // Multi-select dimensions driven by the left "Unit Search" panel.
                statuses: [],
                types: [],
                // Rooms & features (UNIT_FEATURES): { facing: ["North", "South"], bathrooms: ["2"], maid_room: true, … }
                // — a list of accepted values for a Facing / count group, true for a yes / no feature the unit must have.
                features: {},
            };
            const UNITS_TABLE_MOBILE_QUERY = window.matchMedia("(max-width: 700px)");
            const UNITS_TABLE_HEIGHT_KEY = "unitsTableMobileHeight";

            /* Dual-range (price / area) slider controllers */
            const RANGE_FILTERS = {};
            let rangeBoundsReady = false;

            function formatPriceShort(v) {
                v = Number(v) || 0;
                if (v >= 1_000_000) {
                    const m = v / 1_000_000;
                    return (m % 1 === 0 ? m.toFixed(0) : m.toFixed(1)) + "M";
                }
                if (v >= 1_000) return Math.round(v / 1_000) + "K";
                return String(Math.round(v));
            }

            function createDualRange({
                minEl,
                maxEl,
                fillEl,
                valMinEl,
                valMaxEl,
                filterMinKey,
                filterMaxKey,
                format,
            }) {
                let lo = 0;
                let hi = 100;

                function pct(v) {
                    return hi > lo ? ((v - lo) / (hi - lo)) * 100 : 0;
                }

                // Fill + labels from the thumbs (no filter write).
                function paint() {
                    const minV = Number(minEl.value);
                    const maxV = Number(maxEl.value);

                    const a = pct(minV);
                    const b = pct(maxV);
                    if (fillEl) {
                        fillEl.style.left = a + "%";
                        fillEl.style.width = Math.max(0, b - a) + "%";
                    }

                    if (valMinEl) valMinEl.textContent = format(minV);
                    if (valMaxEl) valMaxEl.textContent = format(maxV);
                }

                function refresh() {
                    paint();
                    const minV = Number(minEl.value);
                    const maxV = Number(maxEl.value);
                    // At an extreme, treat the bound as "unbounded" so units with an unknown
                    // (0 / blank) price or area still pass the filter. The max thumb stops on
                    // the slider's step grid (hi − lo over 100 steps), up to one step short of
                    // hi — that is the end of the slider too, not a maximum just under the
                    // dearest unit.
                    const step = Number(maxEl.step) || 1;
                    TABLE_FILTERS[filterMinKey] = minV <= lo ? "" : String(minV);
                    TABLE_FILTERS[filterMaxKey] = maxV >= hi - step ? "" : String(maxV);
                }

                function onInput(e) {
                    let minV = Number(minEl.value);
                    let maxV = Number(maxEl.value);

                    // Keep the two thumbs from crossing each other.
                    if (minV > maxV) {
                        if (e.target === minEl) {
                            minV = maxV;
                            minEl.value = minV;
                        } else {
                            maxV = minV;
                            maxEl.value = maxV;
                        }
                    }

                    // Bring the thumb being dragged to the front (helps when they overlap).
                    minEl.style.zIndex = e.target === minEl ? 5 : 4;
                    maxEl.style.zIndex = e.target === maxEl ? 5 : 4;

                    refresh();
                    renderUnitsTable();
                    applyThreeUnitsFromSheet();
                }

                minEl.addEventListener("input", onInput);
                maxEl.addEventListener("input", onInput);

                return {
                    setBounds(newLo, newHi) {
                        lo = newLo;
                        hi = newHi <= newLo ? newLo + 1 : newHi;
                        const step = Math.max(1, Math.round((hi - lo) / 100));
                        [minEl, maxEl].forEach((el) => {
                            el.min = lo;
                            el.max = hi;
                            el.step = step;
                        });
                        this.syncFromFilters(); // thumbs follow the shared state, never overwrite it
                    },
                    // Show what TABLE_FILTERS holds (the Unit Search panel writes the same keys)
                    // without writing anything back.
                    syncFromFilters() {
                        const mn = TABLE_FILTERS[filterMinKey], mx = TABLE_FILTERS[filterMaxKey];
                        minEl.value = mn !== "" && mn != null && !isNaN(Number(mn)) ? Math.min(hi, Math.max(lo, Number(mn))) : lo;
                        maxEl.value = mx !== "" && mx != null && !isNaN(Number(mx)) ? Math.min(hi, Math.max(lo, Number(mx))) : hi;
                        paint();
                    },
                    reset() {
                        // A reset means no bounds at all: say so in the shared state and show it. (Reading the
                        // thumbs back instead stored the step-snapped maximum — 2,484,465 for Tower 2 — and hid
                        // the two dearest townhouses after every Reset until a reload.)
                        TABLE_FILTERS[filterMinKey] = "";
                        TABLE_FILTERS[filterMaxKey] = "";
                        this.syncFromFilters();
                    },
                };
            }

            let rangeBoundsSig = "";
            function syncRangeFilterBounds() {
                if (!RANGE_FILTERS.price || !RANGE_FILTERS.area) return;
                if (!allUnits || !allUnits.length) return;

                const prices = allUnits
                    .map((u) => Number(u.priceRaw) || 0)
                    .filter((v) => v > 0);
                const areas = allUnits.map(getAreaNumber).filter((v) => v > 0);

                // Re-derive only when the data changed (rows added, prices filled in).
                const sig = allUnits.length + "|" + prices.length + "|" + areas.length;
                if (sig === rangeBoundsSig) return;
                rangeBoundsSig = sig;

                // Each slider follows its own column. No prices yet → the Price block is
                // hidden rather than left as a 0 – 100 slider that filters every unit out.
                // (#priceRange is also the id of a text line in the floor overlay — anchor on the slider input instead)
                const priceBlock = document.getElementById("tableMinPrice")?.closest(".range-filter");
                if (priceBlock) priceBlock.style.display = prices.length ? "" : "none";
                if (prices.length) {
                    RANGE_FILTERS.price.setBounds(
                        Math.floor(Math.min(...prices)),
                        Math.ceil(Math.max(...prices)),
                    );
                } else {
                    TABLE_FILTERS.minPrice = "";
                    TABLE_FILTERS.maxPrice = "";
                }
                if (areas.length) {
                    RANGE_FILTERS.area.setBounds(
                        Math.floor(Math.min(...areas)),
                        Math.ceil(Math.max(...areas)),
                    );
                }

                rangeBoundsReady = prices.length > 0 || areas.length > 0;
            }

            function isMobileUnitsTable() {
                return UNITS_TABLE_MOBILE_QUERY.matches;
            }

            function getUnitsTableHeightBounds() {
                // Use the app's layout-box height. When the UI is CSS-rotated 90° for
                // landscape mode the visual viewport is portrait, so the box height equals
                // the visual viewport WIDTH, not its height.
                const viewportHeight = document.body.classList.contains("ui-rotated")
                    ? window.innerWidth
                    : window.innerHeight || document.documentElement.clientHeight;
                // Allow dragging to (almost) any height: from just the grab handle up to the
                // full screen height.
                const min = 56;
                const max = viewportHeight;

                return {
                    min,
                    max,
                    initial: Math.round(viewportHeight * 0.52),
                };
            }

            function setUnitsTableMobileHeight(height, options = {}) {
                const { persist = false } = options;
                const bounds = getUnitsTableHeightBounds();
                const nextHeight = Math.min(bounds.max, Math.max(bounds.min, Math.round(height)));

                document.documentElement.style.setProperty(
                    "--units-table-drawer-height",
                    `${nextHeight}px`,
                );

                // Once the drawer covers most of the screen, hide the floating controls so
                // the table stands alone (see body.units-table-tall in CSS).
                const drawerOpen = !!document.querySelector("#unitsTableDrawer.show");
                const tall = isMobileUnitsTable() && drawerOpen && nextHeight >= bounds.max * 0.8;
                document.body.classList.toggle("units-table-tall", tall);

                if (persist) {
                    localStorage.setItem(UNITS_TABLE_HEIGHT_KEY, String(nextHeight));
                }

                requestAnimationFrame(() => {
                    if (typeof resizeThreeOverlay === "function") resizeThreeOverlay();
                });
            }

            function applyStoredUnitsTableMobileHeight() {
                const bounds = getUnitsTableHeightBounds();
                const saved = Number(localStorage.getItem(UNITS_TABLE_HEIGHT_KEY));

                setUnitsTableMobileHeight(Number.isFinite(saved) && saved > 0 ? saved : bounds.initial);
            }

            function syncUnitsTableMobileLayout() {
                const isMobile = isMobileUnitsTable();

                document.body.classList.toggle("units-mobile-drawer-open", isMobile);

                if (isMobile) {
                    applyStoredUnitsTableMobileHeight();
                }

                requestAnimationFrame(() => {
                    if (typeof resizeThreeOverlay === "function") resizeThreeOverlay();
                });
            }

            function openUnitsTable() {
                // Desktop: the drawer covers the Unit Search panel, so only one of them is
                // open at a time. (On phones the table is a permanent bottom sheet and the
                // panel is layered above it instead — see the .usp mobile rule.)
                if (!isMobileUnitsTable() && typeof window.closeUnitSearch === "function") window.closeUnitSearch();
                $("#unitsTableDrawer").classList.add("show");
                $("#unitsTableBackdrop").classList.add("show");
                syncUnitsTableMobileLayout();
                renderUnitsTable();
                applyThreeUnitsFromSheet();
            }

            function closeUnitsTable() {
                $("#unitsTableDrawer").classList.remove("show");
                $("#unitsTableBackdrop").classList.remove("show");
                document.body.classList.remove("units-table-tall");
                syncUnitsTableMobileLayout();
            }

            function getAreaNumber(unit) {
                const raw = String(unit.area || "").replace(/[^\d.]/g, "");
                return Number(raw) || 0;
            }

            function getUniqueFloors() {
                const map = new Map();

                allUnits.forEach((unit) => {
                    const key = unit.floor || "";
                    const label = unit.floorRaw || unit.floor || "";
                    if (key && !map.has(key)) {
                        map.set(key, label);
                    }
                });

                return Array.from(map.entries());
            }

            function fillTableFloorFilter() {
                const select = $("#tableFloorFilter");
                if (!select) return;

                const floors = getUniqueFloors();

                select.innerHTML = `<option value="">All Floors</option>`;

                floors.forEach(([value, label]) => {
                    const option = document.createElement("option");
                    option.value = value;
                    option.textContent = label;
                    select.appendChild(option);
                });

                select.value = TABLE_FILTERS.floor || "";
            }

            /* The Unit Search panel's rooms & features selection (TABLE_FILTERS.features) against one unit:
               every selected group must be satisfied — a value group by one of its values, a yes / no feature
               by true (a count of 1 or more counts as yes). A unit without the data never matches a selection. */
            function unitMatchesFeatures(unit, sel) {
                if (!sel) return true;
                const f = unit.features || null;
                for (const key of Object.keys(sel)) {
                    const want = sel[key];
                    const v = f ? f[key] : null;
                    if (want === true) {
                        if (!(v === true || (typeof v === "number" && v >= 1))) return false;
                    } else if (Array.isArray(want) && want.length) {
                        if (v === null || v === undefined || !want.map(String).includes(String(v))) return false;
                    }
                }
                return true;
            }

            function getFilteredTableUnits() {
                const q = TABLE_FILTERS.search.toLowerCase().trim();

                const minPrice = Number(TABLE_FILTERS.minPrice) || 0;
                const maxPrice = Number(TABLE_FILTERS.maxPrice) || Infinity;
                const minArea = Number(TABLE_FILTERS.minArea) || 0;
                const maxArea = Number(TABLE_FILTERS.maxArea) || Infinity;

                return allUnits.filter((unit) => {
                    const name = String(unit.name || "").toLowerCase();
                    const type = String(unit.type || "").toLowerCase();
                    const status = String(unit.availability || unit.status || "").toLowerCase();
                    const floorRaw = String(unit.floorRaw || unit.floor || "").toLowerCase();

                    const price = Number(unit.priceRaw) || 0;
                    const area = getAreaNumber(unit);

                    const searchMatch =
                        !q ||
                        name.includes(q) ||
                        type.includes(q) ||
                        status.includes(q) ||
                        floorRaw.includes(q);

                    const floorMatch =
                        !TABLE_FILTERS.floor || unit.floor === TABLE_FILTERS.floor;

                    const statusMatch =
                        !TABLE_FILTERS.status || unit.status === TABLE_FILTERS.status;

                    // Multi-select availability / type from the Unit Search panel (empty = all).
                    const statusesMatch =
                        !TABLE_FILTERS.statuses ||
                        !TABLE_FILTERS.statuses.length ||
                        TABLE_FILTERS.statuses.includes(unit.status);

                    const typesMatch =
                        !TABLE_FILTERS.types ||
                        !TABLE_FILTERS.types.length ||
                        TABLE_FILTERS.types.includes(String(unit.type));

                    const priceMatch = price >= minPrice && price <= maxPrice;
                    const areaMatch = area >= minArea && area <= maxArea;
                    const featuresMatch = unitMatchesFeatures(unit, TABLE_FILTERS.features);

                    return (
                        searchMatch &&
                        floorMatch &&
                        statusMatch &&
                        statusesMatch &&
                        typesMatch &&
                        priceMatch &&
                        areaMatch &&
                        featuresMatch
                    );
                });
            }

            function renderUnitsTable() {
                const body = $("#unitsTableBody");
                const count = $("#unitsTableCount");

                if (!body) return;

                fillTableFloorFilter();
                syncRangeFilterBounds();
                // Thumbs mirror the shared state (the Unit Search panel may have moved it).
                if (RANGE_FILTERS.area) RANGE_FILTERS.area.syncFromFilters();
                if (RANGE_FILTERS.price) RANGE_FILTERS.price.syncFromFilters();
                if (typeof refreshUnitSearchPanel === "function") refreshUnitSearchPanel();

                const rows = getFilteredTableUnits();

                if (count) {
                    count.textContent = `${rows.length} of ${allUnits.length} units`;
                }

                // Perf: building 600+ rows is costly. Only do it while the drawer is
                // actually visible; filters still update the 3D overlay + Unit Search panel.
                if (!document.querySelector("#unitsTableDrawer.show")) return;

                if (!rows.length) {
                    body.innerHTML = `
      <tr>
        <td colspan="7" class="table-empty">
          No units found. Try changing filters.
        </td>
      </tr>
    `;
                    return;
                }

                body.innerHTML = rows
                    .map((unit) => {
                        const isActive = highlightedUnitId === unit.id ? "active-table-unit" : "";
                        const isCompared = isUnitCompared(unit.id);

                        return `
        <tr class="${isActive}" onclick="openUnitSideMenuFromTable('${escapeHtml(unit.id)}')">
          <td>
            ${isAmenityUnit(unit) ? "" : `<button
              class="compare-heart-btn ${isCompared ? "active" : ""}"
              type="button"
              title="${isCompared ? "Remove from compare" : "Add to compare"}"
              onclick="toggleCompareUnit('${escapeHtml(unit.id)}', event)"
            >
              ${isCompared ? "♥" : "♡"}
            </button>`}
          </td>

          <td>${escapeHtml(unit.name)}</td>
          <td>${escapeHtml(unit.floorRaw || unit.floor || "—")}</td>
          <td>
            <span class="table-status ${escapeHtml(unit.status)}">
              ${escapeHtml(unit.availability || unit.status)}
            </span>
          </td>
          <td>${escapeHtml(unit.area || "—")}</td>
          <td>${escapeHtml(unit.price || "—")}</td>
          <td>${escapeHtml(unit.type || "—")}</td>
        </tr>
      `;
                    })
                    .join("");
            }

            function openUnitSideMenuFromTable(unitId) {
                const unit = allUnits.find((u) => u.id === unitId);
                if (!unit) return;

                // خلي الـ unit تنور في 3D
                highlightUnitInThree(unit);

                closeUnitsTable();

                if (typeof openUnitSideMenu === "function") {
                    openUnitSideMenu(unit);
                } else if (typeof openUnit === "function") {
                    openUnit(unit);
                }
            }

            function bindUnitsTableEvents() {
                $("#unitsTableToggle").addEventListener("click", openUnitsTable);
                $("#closeUnitsTable").addEventListener("click", closeUnitsTable);
                $("#unitsTableBackdrop").addEventListener("click", closeUnitsTable);
                bindUnitsTableResizeEvents();

                $("#tableSearch").addEventListener("input", (e) => {
                    TABLE_FILTERS.search = e.target.value;
                    renderUnitsTable();
                    applyThreeUnitsFromSheet();
                });

                $("#tableFloorFilter").addEventListener("change", (e) => {
                    TABLE_FILTERS.floor = e.target.value;
                    // On a floor plan, picking another floor opens that floor's plan (or the building view for a
                    // floor that has none / "all floors") — the same rule as the Unit Search chips. On the building
                    // only a plan marked openFromFilter (the basement) opens from here.
                    const planNow = e.target.value && floorSceneFor(e.target.value);
                    if (typeof sceneIsStill === "function" && sceneIsStill()) {
                        const target = planNow || window.buildingScene();
                        if (target !== currentScene) { setScene(target); return; } // setScene re-filters and repaints
                    } else if (planNow && SCENES[planNow].openFromFilter && planNow !== currentScene) {
                        setScene(planNow); return;
                    }
                    renderUnitsTable();
                    applyThreeUnitsFromSheet();
                });

                $("#tableStatusFilter").addEventListener("change", (e) => {
                    // One state for both UIs: the panel's Availability chips read `statuses`.
                    TABLE_FILTERS.status = "";
                    TABLE_FILTERS.statuses = e.target.value ? [e.target.value] : [];
                    renderUnitsTable();
                    applyThreeUnitsFromSheet();
                });

                RANGE_FILTERS.price = createDualRange({
                    minEl: $("#tableMinPrice"),
                    maxEl: $("#tableMaxPrice"),
                    fillEl: $("#priceFill"),
                    valMinEl: $("#priceValMin"),
                    valMaxEl: $("#priceValMax"),
                    filterMinKey: "minPrice",
                    filterMaxKey: "maxPrice",
                    format: formatPriceShort,
                });

                RANGE_FILTERS.area = createDualRange({
                    minEl: $("#tableMinArea"),
                    maxEl: $("#tableMaxArea"),
                    fillEl: $("#areaFill"),
                    valMinEl: $("#areaValMin"),
                    valMaxEl: $("#areaValMax"),
                    filterMinKey: "minArea",
                    filterMaxKey: "maxArea",
                    format: (v) => `${Math.round(v)} m²`,
                });

                syncRangeFilterBounds();

                $("#resetTableFilters").addEventListener("click", () => {
                    TABLE_FILTERS.search = "";
                    TABLE_FILTERS.floor = "";
                    TABLE_FILTERS.status = "";
                    TABLE_FILTERS.statuses = [];
                    TABLE_FILTERS.types = [];
                    TABLE_FILTERS.minPrice = "";
                    TABLE_FILTERS.maxPrice = "";
                    TABLE_FILTERS.minArea = "";
                    TABLE_FILTERS.maxArea = "";
                    TABLE_FILTERS.features = {};

                    $("#tableSearch").value = "";
                    $("#tableFloorFilter").value = "";
                    $("#tableStatusFilter").value = "";

                    RANGE_FILTERS.price?.reset();
                    RANGE_FILTERS.area?.reset();

                    renderUnitsTable();
                    applyThreeUnitsFromSheet();
                });
            }

            function bindUnitsTableResizeEvents() {
                const handle = $("#unitsTableResizeHandle");
                if (!handle) return;

                let isResizing = false;

                // Reads clientX/clientY off either a PointerEvent/MouseEvent or a Touch.
                function updateFromPoint(point, options = {}) {
                    let nextHeight;
                    if (document.body.classList.contains("ui-rotated")) {
                        // App is CSS-rotated 90°: the drawer's bottom edge maps to the screen's
                        // left edge, so its height grows with the pointer's X position.
                        nextHeight = point.clientX;
                    } else {
                        const boxH = window.innerHeight || document.documentElement.clientHeight;
                        nextHeight = boxH - point.clientY;
                    }
                    setUnitsTableMobileHeight(nextHeight, options);
                }

                /* ---- Mouse / stylus via Pointer Events ----------------------------
                   Touch is handled by the native touch listeners below instead. Pointer
                   capture is unreliable for touch pointers inside the CSS-rotated
                   (landscape) container, which left the drag handle dead on touch. */
                handle.addEventListener("pointerdown", (event) => {
                    if (event.pointerType === "touch") return;
                    if (!isMobileUnitsTable()) return;

                    isResizing = true;
                    document.body.classList.add("is-units-table-resizing");
                    handle.setPointerCapture(event.pointerId);
                    updateFromPoint(event);
                    event.preventDefault();
                });

                handle.addEventListener("pointermove", (event) => {
                    if (event.pointerType === "touch") return;
                    if (!isResizing) return;

                    updateFromPoint(event);
                    event.preventDefault();
                });

                function stopResize(event) {
                    if (event.pointerType === "touch") return;
                    if (!isResizing) return;

                    isResizing = false;
                    document.body.classList.remove("is-units-table-resizing");
                    updateFromPoint(event, { persist: true });

                    if (handle.hasPointerCapture(event.pointerId)) {
                        handle.releasePointerCapture(event.pointerId);
                    }
                }

                handle.addEventListener("pointerup", stopResize);
                handle.addEventListener("pointercancel", stopResize);

                /* ---- Touch via native touch events --------------------------------
                   Consistent with the frame-viewer and map drag elsewhere in this file.
                   Works in both portrait and the rotated landscape layout, where Pointer
                   Events fail. The handle already has `touch-action: none`, so calling
                   preventDefault keeps the page from scrolling/competing during a drag. */
                function resizeTouchPoint(event) {
                    return (
                        (event.touches && event.touches[0]) ||
                        (event.changedTouches && event.changedTouches[0]) ||
                        null
                    );
                }

                handle.addEventListener(
                    "touchstart",
                    (event) => {
                        if (!isMobileUnitsTable()) return;
                        const point = resizeTouchPoint(event);
                        if (!point) return;

                        isResizing = true;
                        document.body.classList.add("is-units-table-resizing");
                        updateFromPoint(point);
                        event.preventDefault();
                    },
                    { passive: false },
                );

                handle.addEventListener(
                    "touchmove",
                    (event) => {
                        if (!isResizing) return;
                        const point = resizeTouchPoint(event);
                        if (!point) return;

                        updateFromPoint(point);
                        event.preventDefault();
                    },
                    { passive: false },
                );

                function stopResizeTouch(event) {
                    if (!isResizing) return;

                    isResizing = false;
                    document.body.classList.remove("is-units-table-resizing");
                    const point = resizeTouchPoint(event);
                    if (point) updateFromPoint(point, { persist: true });
                }

                handle.addEventListener("touchend", stopResizeTouch);
                handle.addEventListener("touchcancel", stopResizeTouch);

                handle.addEventListener("keydown", (event) => {
                    if (!isMobileUnitsTable()) return;

                    const current = Number(
                        getComputedStyle(document.documentElement)
                            .getPropertyValue("--units-table-drawer-height")
                            .replace("px", ""),
                    );
                    const fallback = getUnitsTableHeightBounds().initial;
                    const baseHeight = Number.isFinite(current) ? current : fallback;
                    let nextHeight = baseHeight;

                    if (event.key === "ArrowUp") nextHeight += 32;
                    if (event.key === "ArrowDown") nextHeight -= 32;
                    if (event.key === "Home") nextHeight = getUnitsTableHeightBounds().min;
                    if (event.key === "End") nextHeight = getUnitsTableHeightBounds().max;

                    if (nextHeight !== baseHeight) {
                        setUnitsTableMobileHeight(nextHeight, { persist: true });
                        event.preventDefault();
                    }
                });

                UNITS_TABLE_MOBILE_QUERY.addEventListener("change", syncUnitsTableMobileLayout);
                window.addEventListener("resize", syncUnitsTableMobileLayout);
            }
            /* =========================================================
               COMPARE SYSTEM
            ========================================================= */

            const COMPARE_STORAGE_KEY = "unitCompareList";
            let compareUnitIds = JSON.parse(localStorage.getItem(COMPARE_STORAGE_KEY) || "[]");

            function saveCompare() {
                localStorage.setItem(COMPARE_STORAGE_KEY, JSON.stringify(compareUnitIds));
            }

            function isUnitCompared(unitId) {
                return compareUnitIds.includes(unitId);
            }

            function getCompareUnits() {
                return compareUnitIds
                    .map((id) => allUnits.find((unit) => unit.id === id))
                    .filter(Boolean);
            }

            function toggleCompareUnit(unitId, event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                const unit = allUnits.find((u) => u.id === unitId);
                if (!unit || isAmenityUnit(unit)) return; // a shared space (the basement) is not compared

                if (isUnitCompared(unitId)) {
                    compareUnitIds = compareUnitIds.filter((id) => id !== unitId);
                } else {
                    compareUnitIds.push(unitId);
                }

                saveCompare();
                renderCompare();
                renderUnitsTable();

                if (currentUnit && currentUnit.id === unitId) {
                    updateSideCompareButton(currentUnit);
                }
            }

            function removeCompareUnit(unitId) {
                compareUnitIds = compareUnitIds.filter((id) => id !== unitId);
                saveCompare();
                renderCompare();
                renderUnitsTable();

                if (currentUnit && currentUnit.id === unitId) {
                    updateSideCompareButton(currentUnit);
                }
            }

            function clearCompareUnits() {
                compareUnitIds = [];
                saveCompare();
                renderCompare();
                renderUnitsTable();
                closeCompareDrawer();

                if (currentUnit) {
                    updateSideCompareButton(currentUnit);
                }
            }

            function openCompareDrawer() {
                $("#compareDrawer")?.classList.add("show");
                $("#compareBackdrop")?.classList.add("show");
                renderCompare();
            }

            /* Drag the compare cards sideways with the mouse — touch scrolls natively.
               The drag only starts after a few pixels, so the buttons inside the cards
               still click; a drag that did scroll swallows the click it would end with. */
            (function () {
                const strip = document.getElementById("compareCards");
                if (!strip) return;
                let down = null, dragged = false;
                strip.addEventListener("pointerdown", (e) => {
                    if (e.pointerType !== "mouse" || e.button !== 0) return;
                    down = { x: e.clientX, left: strip.scrollLeft };
                    dragged = false;
                });
                strip.addEventListener("pointermove", (e) => {
                    if (!down) return;
                    const dx = e.clientX - down.x;
                    if (!dragged && Math.abs(dx) < 5) return;
                    if (!dragged) {
                        dragged = true;
                        strip.classList.add("dragging");
                        try { strip.setPointerCapture(e.pointerId); } catch (_) { /* older browsers */ }
                    }
                    strip.scrollLeft = down.left - dx;
                    e.preventDefault();
                });
                const end = () => {
                    if (!down) return;
                    down = null;
                    if (!dragged) return;
                    dragged = false;
                    strip.classList.remove("dragging");
                    const swallow = (ev) => { ev.stopPropagation(); ev.preventDefault(); };
                    strip.addEventListener("click", swallow, { capture: true, once: true });
                    setTimeout(() => strip.removeEventListener("click", swallow, { capture: true }), 0);
                };
                strip.addEventListener("pointerup", end);
                strip.addEventListener("pointercancel", end);
                strip.addEventListener("pointerleave", end);
            })();

            function closeCompareDrawer() {
                $("#compareDrawer")?.classList.remove("show");
                $("#compareBackdrop")?.classList.remove("show");
            }

            function updateCompareFloatingButton() {
                const count = compareUnitIds.length;
                const countEl = $("#compareCount");
                const btn = $("#compareToggle");

                if (countEl) countEl.textContent = count;

                // يظهر فقط لما يكون فيه وحدات في المقارنة
                if (btn) {
                    btn.classList.toggle("show", count > 0);
                }

                const sub = $("#compareSub");
                if (sub) {
                    sub.textContent = `${count} unit${count === 1 ? "" : "s"} selected`;
                }

                // لو فضيت المقارنة وهي مفتوحة، اقفلها
                if (count === 0) {
                    closeCompareDrawer?.();
                }
            }

            function updateSideCompareButton(unit) {
                const btn = $("#sideCompareBtn");
                if (!btn || !unit) return;

                const active = isUnitCompared(unit.id);
                btn.classList.toggle("active", active);
                btn.textContent = active ? "♥ Compared" : "♡ Compare";

                btn.onclick = (event) => toggleCompareUnit(unit.id, event);
            }

            function renderCompare() {
                const container = $("#compareCards");
                if (!container) return;

                const units = getCompareUnits();

                updateCompareFloatingButton();

                if (!units.length) {
                    container.innerHTML = `
      <div class="compare-empty">
        No units selected yet. Press the heart beside any unit.
      </div>
    `;
                    return;
                }

                container.innerHTML = units
                    .map((unit) => {
                        const imageHtml =
                            unit.imgSource && unit.imgSource.trim() !== ""
                                ? `<img src="${escapeHtml(unit.imgSource)}" alt="${escapeHtml(unit.name)}" />`
                                : `<div class="compare-card-no-img">No image</div>`;

                        return `
        <article class="compare-card">
          <div class="compare-card-img">
            ${imageHtml}
            <span class="compare-card-status ${escapeHtml(unit.status)}">
              ${escapeHtml(unit.availability || unit.status)}
            </span>
          </div>

          <div class="compare-card-body">
            <div>
              <div class="compare-card-title">${escapeHtml(unit.name)}</div>
              <div class="compare-card-type">${escapeHtml(unit.type || "—")}</div>
            </div>

            <div class="compare-row">
              <span>Floor</span>
              <b>${escapeHtml(unit.floorRaw || unit.floor || "—")}</b>
            </div>

            <div class="compare-row">
              <span>Area</span>
              <b>${escapeHtml(unit.area || "—")}</b>
            </div>

            <div class="compare-row">
              <span>Price</span>
              <b>${escapeHtml(unit.price || "—")}</b>
            </div>

            <div class="compare-row">
              <span>Status</span>
              <b>${escapeHtml(unit.availability || unit.status || "—")}</b>
            </div>
          </div>

          <div class="compare-card-actions">
            <button class="compare-open-btn" type="button" onclick="openCompareUnit('${escapeHtml(unit.id)}')">
              Open Details
            </button>

            <button class="compare-remove-btn" type="button" onclick="removeCompareUnit('${escapeHtml(unit.id)}')">
              Remove
            </button>
          </div>
        </article>
      `;
                    })
                    .join("");
            }

            function openCompareUnit(unitId) {
                const unit = allUnits.find((u) => u.id === unitId);
                if (!unit) return;

                closeCompareDrawer();

                if (typeof highlightUnitInThree === "function") {
                    highlightUnitInThree(unit);
                }

                openUnit(unit);
            }

            function bindCompareEvents() {
                $("#compareToggle")?.addEventListener("click", openCompareDrawer);
                $("#closeCompare")?.addEventListener("click", closeCompareDrawer);
                $("#compareBackdrop")?.addEventListener("click", closeCompareDrawer);
                $("#clearCompare")?.addEventListener("click", clearCompareUnits);
            }

            bindCompareEvents();
            renderCompare();

            bindUnitsTableEvents();

            /* Auto-open table on mobile and apply stored height */
            if (window.innerWidth <= 700) {
                $("#unitsTableDrawer")?.classList.add("show");
                syncUnitsTableMobileLayout();
            }

            /* Table head icon buttons (mobile) */
            document.getElementById("tableHeadGallery")?.addEventListener("click", () => {
                if (typeof openGallery === "function") openGallery();
            });

            document.getElementById("tableHeadFavourites")?.addEventListener("click", () => {
                if (typeof openCompareDrawer === "function") openCompareDrawer();
            });

            /* Keep favourites badge in sync with compare count */
            function syncTableHeadFavBadge() {
                const badge = document.getElementById("tableHeadFavBadge");
                const count = document.getElementById("compareCount");
                if (!badge || !count) return;
                const n = parseInt(count.textContent, 10) || 0;
                badge.textContent = n;
                badge.classList.toggle("show", n > 0);
            }

            const _favBadgeObserver = new MutationObserver(syncTableHeadFavBadge);
            const _compareCountEl = document.getElementById("compareCount");
            if (_compareCountEl) _favBadgeObserver.observe(_compareCountEl, { childList: true, characterData: true, subtree: true });
            syncTableHeadFavBadge();

            /* ==========================================================
               GALLERY
            ========================================================== */

            /* Built-in fallback list. At runtime the gallery is loaded from Supabase
               (`gallery` + `gallery_categories`, managed in admin/index.html) — see
               loadGalleryFromSupabase() below. These rows are used only when the
               tables are missing or empty. */
            let GALLERY_DATA = [
                /* Local derivatives built by tools/optimize-gallery.py (git-ignored). */
                { id: 1, category: "exterior", subcategory: "Aerial", src: "gallery/images-gallery/_optimized/full/exterior/aerial-day.webp", thumb: "gallery/images-gallery/_optimized/thumb/exterior/aerial-day.webp", title: "Aerial View – Day", title_ar: "منظر جوي – نهارًا" },
                { id: 2, category: "exterior", subcategory: "Aerial", src: "gallery/images-gallery/_optimized/full/exterior/aerial-sunset.webp", thumb: "gallery/images-gallery/_optimized/thumb/exterior/aerial-sunset.webp", title: "Aerial View – Sunset", title_ar: "منظر جوي – عند الغروب" },
                { id: 3, category: "exterior", subcategory: "Street", src: "gallery/images-gallery/_optimized/full/exterior/main-facade.webp", thumb: "gallery/images-gallery/_optimized/thumb/exterior/main-facade.webp", title: "Main Facade", title_ar: "الواجهة الرئيسية" },
                { id: 4, category: "exterior", subcategory: "Street", src: "gallery/images-gallery/_optimized/full/exterior/street-corner.webp", thumb: "gallery/images-gallery/_optimized/thumb/exterior/street-corner.webp", title: "Street Corner", title_ar: "زاوية الشارع" },
                { id: 5, category: "courtyard", subcategory: "Courtyard", src: "gallery/images-gallery/_optimized/full/courtyard/inner-courtyard.webp", thumb: "gallery/images-gallery/_optimized/thumb/courtyard/inner-courtyard.webp", title: "Inner Courtyard", title_ar: "الفناء الداخلي" },
                { id: 6, category: "courtyard", subcategory: "Roof Terrace", src: "gallery/images-gallery/_optimized/full/courtyard/rooftop-terrace.webp", thumb: "gallery/images-gallery/_optimized/thumb/courtyard/rooftop-terrace.webp", title: "Rooftop Terrace", title_ar: "تراس السطح" },
                { id: 7, category: "prototypes", subcategory: "1 Bedroom", src: "gallery/images-gallery/_optimized/full/prototypes/1-bedroom-70.webp", thumb: "gallery/images-gallery/_optimized/thumb/prototypes/1-bedroom-70.webp", title: "Prototype 01 – 1 Bedroom", title_ar: "النموذج ٠١ – غرفة نوم" },
                { id: 8, category: "prototypes", subcategory: "2 Bedrooms", src: "gallery/images-gallery/_optimized/full/prototypes/2-bedroom-105.webp", thumb: "gallery/images-gallery/_optimized/thumb/prototypes/2-bedroom-105.webp", title: "Prototype 02 – 2 Bedrooms", title_ar: "النموذج ٠٢ – غرفتا نوم" },
                { id: 9, category: "prototypes", subcategory: "3 Bedrooms", src: "gallery/images-gallery/_optimized/full/prototypes/3-bedroom-140.webp", thumb: "gallery/images-gallery/_optimized/thumb/prototypes/3-bedroom-140.webp", title: "Prototype 03 – 3 Bedrooms", title_ar: "النموذج ٠٣ – ثلاث غرف نوم" },
                { id: 10, category: "plans", subcategory: "Plans", src: "gallery/images-gallery/_optimized/full/plans/ground-floor.webp", thumb: "gallery/images-gallery/_optimized/thumb/plans/ground-floor.webp", title: "Ground Floor Plan", title_ar: "مخطط الدور الأرضي" },
                { id: 11, category: "elevations", subcategory: "Elevations", src: "gallery/images-gallery/_optimized/full/elevations/main-elevation.webp", thumb: "gallery/images-gallery/_optimized/thumb/elevations/main-elevation.webp", title: "Main Elevation", title_ar: "الواجهة الرئيسية" },
            ];

            let GALLERY_CATEGORIES = [
                { key: "all", label: "All", label_ar: "الكل", hasChildren: true },
                { key: "exterior", label: "Exterior", label_ar: "الواجهات الخارجية", hasChildren: true },
                { key: "courtyard", label: "Courtyard & Roof", label_ar: "الفناء والسطح", hasChildren: true },
                { key: "prototypes", label: "Unit Prototypes", label_ar: "نماذج الوحدات", hasChildren: true },
                { key: "plans", label: "Floor Plans", label_ar: "المخططات", hasChildren: false },
                { key: "elevations", label: "Elevations", label_ar: "الواجهات والقطاعات", hasChildren: false },
            ];

            let galleryActiveCategory = "all";
            let galleryActiveSubcategory = null;
            let galleryExpandedCategories = new Set(["all"]);
            let galleryLbIndex = 0;
            let galleryLbItems = [];

            /* ---- Supabase-backed gallery (edited from admin/index.html) ---- */
            async function loadGalleryFromSupabase() {
                if (!SUPABASE_URL) return; // config.js not filled in yet — keep the built-in list
                const headers = { apikey: SUPABASE_ANON_KEY, Authorization: "Bearer " + SUPABASE_ANON_KEY };
                const get = async (path) => {
                    const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, { headers, cache: "no-store" });
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    return res.json();
                };
                try {
                    // This project's images (projects.js; the `project` column of SQL section 8). Without that column
                    // (section 8 not run yet) the default project shows the whole table, any other project nothing.
                    const itemsOfProject = async () => {
                        try { return await get(`gallery?select=*&project=eq.${encodeURIComponent(PROJECT_ID)}&order=sort_order.asc,id.asc&limit=5000`); }
                        catch (e) {
                            if (!/HTTP 400/.test(e.message)) throw e;
                            console.warn("[gallery] the gallery table has no `project` column yet — run admin/supabase-setup.sql (section 8).");
                            return PROJECT_ID === window.MAAZAR_DEFAULT_PROJECT ? get("gallery?select=*&order=sort_order.asc,id.asc&limit=5000") : [];
                        }
                    };
                    const [cats, items] = await Promise.all([
                        get("gallery_categories?select=*&order=sort_order.asc,key.asc"),
                        itemsOfProject(),
                    ]);
                    if (!Array.isArray(items)) return;
                    GALLERY_DATA = items;
                    // Categories are shared by every project: list the ones this project has images in.
                    const used = new Set(items.map((i) => i.category));
                    GALLERY_CATEGORIES = [{ key: "all", label: "All", label_ar: "الكل", hasChildren: true }]
                        .concat((cats || []).filter((c) => used.has(c.key)).map(c => ({ ...c, hasChildren: true })));
                    if (document.getElementById("galleryOverlay")?.classList.contains("show")) {
                        renderGallerySidebar();
                        renderGalleryGrid();
                    }
                    document.dispatchEvent(new CustomEvent("gallery:loaded")); // the unit panel's 3D images strip listens
                } catch (e) {
                    console.warn("[gallery] Supabase gallery unavailable, using the built-in list:", e.message);
                }
            }
            const galleryIsAr = () => window.i18n?.lang === "ar";
            /* Grid tiles use the small `thumb` derivative when the row has one (rows
               uploaded before the thumb column, or from the admin dashboard, don't —
               they fall back to the full image). The lightbox always uses item.src. */
            const galleryTileSrc = item => item.thumb || item.src;
            const galleryCatLabel = cat => (galleryIsAr() && cat.label_ar) ? cat.label_ar : cat.label;
            const galleryItemTitle = item => ((galleryIsAr() && item.title_ar) ? item.title_ar : item.title) || "";
            function gallerySubLabel(catKey, sub) {
                if (!galleryIsAr()) return sub;
                const hit = GALLERY_DATA.find(i => i.category === catKey && i.subcategory === sub && i.subcategory_ar);
                return hit ? hit.subcategory_ar : sub;
            }
            loadGalleryFromSupabase();
            document.addEventListener("i18n:change", () => {
                if (document.getElementById("galleryOverlay")?.classList.contains("show")) {
                    renderGallerySidebar();
                    renderGalleryGrid();
                }
            });

            function galleryCategoryCount(catKey) {
                if (catKey === "all") return GALLERY_DATA.length;
                return GALLERY_DATA.filter(i => i.category === catKey).length;
            }

            function gallerySubcategories(catKey) {
                const subs = [...new Set(
                    GALLERY_DATA.filter(i => i.category === catKey).map(i => i.subcategory).filter(Boolean)
                )];
                return subs;
            }

            function gallerySubcategoryCount(catKey, sub) {
                return GALLERY_DATA.filter(i => i.category === catKey && i.subcategory === sub).length;
            }

            function galleryFilteredItems() {
                if (galleryActiveSubcategory) {
                    return GALLERY_DATA.filter(i => i.subcategory === galleryActiveSubcategory);
                }
                if (galleryActiveCategory === "all") return GALLERY_DATA;
                return GALLERY_DATA.filter(i => i.category === galleryActiveCategory);
            }

            function renderGallerySidebar() {
                const nav = document.getElementById("gallerySidebar");
                if (!nav) return;

                let html = "";

                GALLERY_CATEGORIES.forEach(cat => {
                    const count = galleryCategoryCount(cat.key);
                    const isActive = galleryActiveCategory === cat.key && !galleryActiveSubcategory;
                    const isExpanded = galleryExpandedCategories.has(cat.key);
                    const subs = cat.hasChildren ? gallerySubcategories(cat.key) : [];

                    html += `
      <div class="gallery-cat-row${isActive ? " active" : ""}" data-cat="${cat.key}">
        ${subs.length ? `<span class="gallery-cat-toggle-icon${isExpanded ? " open" : ""}">▶</span>` : `<span style="width:18px;display:inline-block;"></span>`}
        <span class="gallery-cat-label">${escapeHtml(galleryCatLabel(cat))}</span>
        <span class="gallery-cat-count">${count}</span>
      </div>
    `;

                    if (isExpanded && subs.length) {
                        subs.forEach(sub => {
                            const subCount = gallerySubcategoryCount(cat.key, sub);
                            const subActive = galleryActiveSubcategory === sub;
                            html += `
          <div class="gallery-subcat-row${subActive ? " active" : ""}" data-cat="${cat.key}" data-sub="${escapeHtml(sub)}">
            <span class="gallery-cat-label">${escapeHtml(gallerySubLabel(cat.key, sub))}</span>
            <span class="gallery-cat-count">${subCount}</span>
          </div>
        `;
                        });
                    }
                });

                nav.innerHTML = html;

                nav.querySelectorAll(".gallery-cat-row").forEach(row => {
                    row.addEventListener("click", () => {
                        const catKey = row.dataset.cat;
                        if (galleryExpandedCategories.has(catKey)) {
                            galleryExpandedCategories.delete(catKey);
                        } else {
                            galleryExpandedCategories.add(catKey);
                        }
                        galleryActiveCategory = catKey;
                        galleryActiveSubcategory = null;
                        renderGallerySidebar();
                        renderGalleryGrid();
                    });
                });

                nav.querySelectorAll(".gallery-subcat-row").forEach(row => {
                    row.addEventListener("click", e => {
                        e.stopPropagation();
                        galleryActiveCategory = row.dataset.cat;
                        galleryActiveSubcategory = row.dataset.sub;
                        renderGallerySidebar();
                        renderGalleryGrid();
                    });
                });
            }

            function renderGalleryGrid() {
                const grid = document.getElementById("galleryMasonry");
                if (!grid) return;

                const items = galleryFilteredItems();
                galleryLbItems = items;

                if (!items.length) {
                    grid.innerHTML = `<div style="padding:40px;text-align:center;color:#999;font-size:14px;">No images in this category.</div>`;
                    return;
                }

                grid.innerHTML = items.map((item, idx) => `
    <div class="gallery-item" data-idx="${idx}">
      <div class="gallery-item-loading" id="gload-${item.id}">
        <div class="gallery-item-spinner"></div>
        Loading preview...
      </div>
      <img
        decoding="async"
        src="${escapeHtml(galleryTileSrc(item))}"
        alt="${escapeHtml(galleryItemTitle(item))}"
        style="display:none;"
        id="gimg-${item.id}"
      />
    </div>
  `).join("");

                items.forEach(item => {
                    const img = document.getElementById(`gimg-${item.id}`);
                    const loader = document.getElementById(`gload-${item.id}`);
                    if (!img || !loader) return;

                    const showImg = () => {
                        loader.style.display = "none";
                        img.style.display = "block";
                    };
                    const showErr = () => {
                        loader.innerHTML = `<span style="font-size:12px;color:var(--muted);">Image not found</span>`;
                    };

                    img.addEventListener("load", showImg);
                    img.addEventListener("error", showErr);

                    // Handle already-cached images where load fired before the listener
                    if (img.complete) {
                        img.naturalWidth > 0 ? showImg() : showErr();
                    }
                });

                grid.querySelectorAll(".gallery-item").forEach(el => {
                    el.addEventListener("click", () => {
                        openGalleryLightbox(parseInt(el.dataset.idx, 10));
                    });
                });
            }

            function openGalleryLightbox(idx) {
                galleryLbIndex = idx;
                updateGalleryLightbox();
                document.getElementById("galleryLightbox").classList.add("show");
            }

            function updateGalleryLightbox() {
                const item = galleryLbItems[galleryLbIndex];
                if (!item) return;
                const img = document.getElementById("galleryLbImg");
                const cap = document.getElementById("galleryLbCaption");
                img.src = item.src;
                img.alt = galleryItemTitle(item);
                cap.textContent = `${galleryItemTitle(item)}  (${galleryLbIndex + 1} / ${galleryLbItems.length})`;
            }

            function closeGalleryLightbox() {
                document.getElementById("galleryLightbox").classList.remove("show");
            }

            function openGallery() {
                document.getElementById("galleryOverlay").classList.add("show");
                renderGallerySidebar();
                renderGalleryGrid();
            }

            function closeGallery() {
                document.getElementById("galleryOverlay").classList.remove("show");
            }

            document.getElementById("galleryToggle")?.addEventListener("click", openGallery);
            document.getElementById("galleryClose")?.addEventListener("click", closeGallery);
            document.getElementById("galleryCloseX")?.addEventListener("click", closeGallery);

            document.getElementById("galleryLbClose")?.addEventListener("click", closeGalleryLightbox);
            document.getElementById("galleryLbPrev")?.addEventListener("click", () => {
                galleryLbIndex = (galleryLbIndex - 1 + galleryLbItems.length) % galleryLbItems.length;
                updateGalleryLightbox();
            });
            document.getElementById("galleryLbNext")?.addEventListener("click", () => {
                galleryLbIndex = (galleryLbIndex + 1) % galleryLbItems.length;
                updateGalleryLightbox();
            });

            document.getElementById("galleryLightbox")?.addEventListener("click", e => {
                if (e.target === document.getElementById("galleryLightbox")) closeGalleryLightbox();
            });

            document.addEventListener("keydown", e => {
                if (document.getElementById("galleryLightbox")?.classList.contains("show")) {
                    if (e.key === "ArrowLeft") { galleryLbIndex = (galleryLbIndex - 1 + galleryLbItems.length) % galleryLbItems.length; updateGalleryLightbox(); }
                    if (e.key === "ArrowRight") { galleryLbIndex = (galleryLbIndex + 1) % galleryLbItems.length; updateGalleryLightbox(); }
                    if (e.key === "Escape") closeGalleryLightbox();
                }
                if (document.getElementById("galleryOverlay")?.classList.contains("show") && e.key === "Escape") {
                    closeGallery();
                }
            });
        </script>

        <!-- ===================== UNIT FINDER CHATBOT ===================== -->
        <button id="ufLauncher" class="uf-launcher" type="button" aria-label="Open Unit Finder">
            <span class="uf-launcher-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                    stroke-linejoin="round" aria-hidden="true">
                    <path
                        d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.6 9.6 0 0 1-2.9-.4L3 21l1.4-4.1A8.2 8.2 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z">
                    </path>
                    <path d="M8.2 11.5h.01M12 11.5h.01M15.8 11.5h.01" stroke-width="2.6"></path>
                </svg>
            </span>
        </button>

        <div id="ufWindow" class="uf-window" role="dialog" aria-label="Unit Finder">
            <div class="uf-header">
                <div class="uf-header-left">
                    <div class="uf-avatar">🏢</div>
                    <div>
                        <div class="uf-title">Unit Finder</div>
                        <div class="uf-subtitle" id="ufAssistantName">Khawalid 20 Assistant</div>
                    </div>
                </div>
                <button id="ufClose" class="uf-close" type="button" aria-label="Close">×</button>
            </div>
            <div id="ufBody" class="uf-body"></div>
        </div>

        <script>
            (function () {
                const launcher = document.getElementById("ufLauncher");
                const win = document.getElementById("ufWindow");
                const closeBtn = document.getElementById("ufClose");
                const winBody = document.getElementById("ufBody");
                if (!launcher || !win || !winBody) return;

                // This project's floors (projects.js), bottom-up.
                const PROJECT_FLOORS = (window.MAAZAR_PROJECT && window.MAAZAR_PROJECT.floors) || [];
                const FLOOR_LABELS = PROJECT_FLOORS.length ? Object.fromEntries(PROJECT_FLOORS.map((f) => [String(f.key), f.name || f.label || String(f.key)])) : { LG: "Basement", GF: "Ground", 1: "First", 2: "Second", 3: "Third", RF: "Roof" };
                const FLOOR_ORDER = PROJECT_FLOORS.length ? PROJECT_FLOORS.map((f) => String(f.key)) : ["LG", "GF", "1", "2", "3", "RF"];

                // Budget brackets follow the prices on offer: cut at round figures
                // between the cheapest and the dearest unit, five brackets at most.
                // No prices in the table (or all the same) → no brackets, and the
                // budget question is skipped.
                const shortSar = (v) => (v >= 1e6 ? +(v / 1e6).toFixed(2) + "M" : Math.round(v / 1e3) + "K");
                function budgets() {
                    const prices = getUnits().filter((u) => u.status !== "sold").map((u) => Number(u.priceRaw) || 0).filter((p) => p > 0);
                    if (!prices.length) return [];
                    const lo = Math.min(...prices), hi = Math.max(...prices);
                    let cuts = [];
                    for (const step of [25e3, 50e3, 100e3, 250e3, 500e3, 1e6, 2.5e6, 5e6, 10e6, 25e6, 50e6, 100e6]) {
                        cuts = [];
                        for (let c = Math.floor(lo / step) * step + step; c < hi; c += step) cuts.push(c);
                        if (cuts.length <= 4) break;
                    }
                    if (!cuts.length) return [];
                    return [0, ...cuts].map((min, i) => {
                        const max = i < cuts.length ? cuts[i] : Infinity;
                        const label = !i ? "Under " + shortSar(max) : max === Infinity ? "Over " + shortSar(min) : shortSar(min) + " – " + shortSar(max);
                        return { label, min, max };
                    });
                }
                const AREAS = [
                    { label: "Under 50 m²", min: 0, max: 50 },
                    { label: "50 – 100 m²", min: 50, max: 100 },
                    { label: "100 – 200 m²", min: 100, max: 200 },
                    { label: "Over 200 m²", min: 200, max: Infinity },
                ];

                // Pull the live units list loaded from Supabase (global `allUnits`).
                function getUnits() {
                    try {
                        return typeof allUnits !== "undefined" && Array.isArray(allUnits) ? allUnits : [];
                    } catch (_) {
                        return [];
                    }
                }

                function areaNum(u) {
                    const m = String(u && u.area ? u.area : "").match(/[\d.]+/);
                    return m ? parseFloat(m[0]) : NaN;
                }

                function esc(s) {
                    return String(s == null ? "" : s)
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;");
                }

                // Does a unit satisfy the chosen filters so far? (sold units are never recommended)
                function unitMatches(u, s) {
                    if (u.status === "sold") return false;
                    if (s.budget) {
                        const p = Number(u.priceRaw) || 0;
                        if (p > 0 && !(p >= s.budget.min && p < s.budget.max)) return false;
                    }
                    if (s.type && s.type !== "__any") {
                        if (String(u.type || "").trim().toLowerCase() !== String(s.type).toLowerCase()) return false;
                    }
                    if (s.floor && s.floor !== "__any") {
                        if (u.floor !== s.floor) return false;
                    }
                    if (s.area) {
                        const a = areaNum(u);
                        if (!(a >= s.area.min && a < s.area.max)) return false;
                    }
                    return true;
                }

                const STEPS = [
                    {
                        key: "budget",
                        q: "What's your budget?",
                        options: () =>
                            budgets().map((b) => ({
                                label: b.label,
                                value: b,
                                // unknown-price units (0) match any budget so we never hide inventory
                                pred: (u) => {
                                    const p = Number(u.priceRaw) || 0;
                                    return p === 0 || (p >= b.min && p < b.max);
                                },
                            })),
                    },
                    {
                        key: "type",
                        q: "What type of unit are you looking for?",
                        options: () => {
                            const types = [
                                ...new Set(
                                    getUnits()
                                        .filter((u) => u.status !== "sold")
                                        .map((u) => String(u.type || "").trim())
                                        .filter((t) => t && t !== "—"),
                                ),
                            ].sort();
                            return [
                                { label: "Any Type", value: "__any", pred: () => true },
                                ...types.map((t) => ({
                                    label: t,
                                    value: t,
                                    pred: (u) => String(u.type || "").trim().toLowerCase() === t.toLowerCase(),
                                })),
                            ];
                        },
                    },
                    {
                        key: "floor",
                        q: "Which floor do you prefer?",
                        options: () => {
                            const present = new Set(getUnits().filter((u) => u.status !== "sold").map((u) => u.floor));
                            const floors = FLOOR_ORDER.filter((f) => present.has(f));
                            return [
                                { label: "Any Floor", value: "__any", pred: () => true },
                                ...floors.map((f) => ({
                                    label: FLOOR_LABELS[f] || f,
                                    value: f,
                                    pred: (u) => u.floor === f,
                                })),
                            ];
                        },
                    },
                    {
                        key: "area",
                        q: "What unit size do you need?",
                        options: () =>
                            AREAS.map((a) => ({
                                label: a.label,
                                value: a,
                                pred: (u) => {
                                    const n = areaNum(u);
                                    return n >= a.min && n < a.max;
                                },
                            })),
                    },
                ];

                let stepIndex = 0;
                let sel = { budget: null, type: null, floor: null, area: null };

                function scrollBottom() {
                    requestAnimationFrame(() => {
                        winBody.scrollTop = winBody.scrollHeight;
                    });
                }

                function addBot(text) {
                    const el = document.createElement("div");
                    el.className = "uf-msg uf-bot";
                    el.textContent = text;
                    winBody.appendChild(el);
                    scrollBottom();
                    return el;
                }

                function addUser(text) {
                    const el = document.createElement("div");
                    el.className = "uf-msg uf-user";
                    el.textContent = text;
                    winBody.appendChild(el);
                    scrollBottom();
                }

                function askStep() {
                    const step = STEPS[stepIndex];
                    const options = step.options();
                    if (!options.length) { // nothing to choose from: on to the next question
                        stepIndex++;
                        return stepIndex < STEPS.length ? askStep() : showResults();
                    }
                    addBot(step.q);

                    const all = getUnits();
                    const base = all.filter((u) => unitMatches(u, sel)); // applies previously-chosen filters only
                    const row = document.createElement("div");
                    row.className = "uf-chips";

                    options.forEach((o) => {
                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "uf-chip";
                        btn.textContent = o.label;
                        const count = base.filter(o.pred).length;
                        if (all.length && count === 0 && o.value !== "__any") {
                            btn.disabled = true;
                            btn.classList.add("uf-chip-disabled");
                        } else {
                            btn.addEventListener("click", () => chooseOption(step, o, row));
                        }
                        row.appendChild(btn);
                    });

                    winBody.appendChild(row);
                    scrollBottom();
                }

                function chooseOption(step, o, row) {
                    sel[step.key] = o.value;
                    addUser(o.label);
                    row.querySelectorAll(".uf-chip").forEach((b) => {
                        b.disabled = true;
                        b.classList.add("uf-chip-locked");
                    });
                    stepIndex++;
                    if (stepIndex < STEPS.length) {
                        setTimeout(askStep, 320);
                    } else {
                        setTimeout(showResults, 380);
                    }
                }

                function resultCard(u) {
                    const card = document.createElement("button");
                    card.type = "button";
                    card.className = "uf-card";

                    const floorLabel = FLOOR_LABELS[u.floor] || u.floorRaw || u.floor || "—";
                    const priceText = Number(u.priceRaw) > 0 ? esc(u.price) : "Price on request";
                    const img = u.imgSource
                        ? '<div class="uf-card-img"><img src="' +
                        esc(u.imgSource) +
                        '" alt="" onerror="this.style.display=\'none\';this.parentElement.classList.add(\'uf-noimg\')"></div>'
                        : '<div class="uf-card-img uf-noimg"></div>';

                    card.innerHTML =
                        img +
                        '<div class="uf-card-body">' +
                        '<div class="uf-card-name">' + esc(u.name) + "</div>" +
                        '<div class="uf-card-meta">' +
                        '<span class="uf-tag">🏷️ ' + esc(u.type || "—") + "</span>" +
                        '<span class="uf-tag">☰ ' + esc(floorLabel) + "</span>" +
                        "</div>" +
                        '<div class="uf-card-meta">' +
                        '<span class="uf-tag uf-muted">⛶ ' + esc(u.area || "—") + "</span>" +
                        "</div>" +
                        '<div class="uf-card-price">' + priceText + "</div>" +
                        "</div>" +
                        '<div class="uf-card-arrow">›</div>';

                    card.addEventListener("click", () => {
                        if (typeof openUnit === "function") openUnit(u);
                        else if (typeof openUnitSideMenu === "function") openUnitSideMenu(u);
                    });
                    return card;
                }

                function addStartOver() {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "uf-startover";
                    btn.textContent = "↺ Start Over";
                    btn.addEventListener("click", resetChat);
                    winBody.appendChild(btn);
                    scrollBottom();
                }

                function showResults() {
                    const all = getUnits();
                    if (!all.length) {
                        addBot("I'm still loading the units… give me a moment and tap Start Over.");
                        addStartOver();
                        return;
                    }

                    const units = all.filter((u) => unitMatches(u, sel));
                    units.sort((a, b) => {
                        const sa = a.status === "available" ? 0 : 1;
                        const sb = b.status === "available" ? 0 : 1;
                        if (sa !== sb) return sa - sb;
                        const pa = Number(a.priceRaw) || Infinity;
                        const pb = Number(b.priceRaw) || Infinity;
                        return pa - pb;
                    });

                    if (!units.length) {
                        addBot("Hmm, I couldn't find a unit matching all of that. Let's try again with broader choices.");
                        addStartOver();
                        return;
                    }

                    addBot("Great! I found " + units.length + " unit" + (units.length > 1 ? "s" : "") + " for you 🎉");
                    const list = document.createElement("div");
                    list.className = "uf-results";
                    units.slice(0, 40).forEach((u) => list.appendChild(resultCard(u)));
                    winBody.appendChild(list);
                    addStartOver();
                    scrollBottom();
                }

                function resetChat() {
                    stepIndex = 0;
                    sel = { budget: null, type: null, floor: null, area: null };
                    winBody.innerHTML = "";
                    addBot("Hi! I'll help you find the perfect unit. 🏢");
                    setTimeout(askStep, 380);
                }

                function toggleWindow(open) {
                    win.classList.toggle("uf-open", open);
                    launcher.classList.toggle("uf-hidden", open);
                    if (open && !winBody.childElementCount) resetChat();
                }

                launcher.addEventListener("click", () => toggleWindow(true));
                closeBtn.addEventListener("click", () => toggleWindow(false));
            })();
        </script>

