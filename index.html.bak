                    Reset: "إعادة الضبط",
                    All: "الكل",
                    "units — View list": "وحدة — عرض القائمة",
                    "No units match your filters.": "لا توجد وحدات مطابقة للفلاتر.",
                    // Rooms & features (UNIT_FEATURES — the Unit Search chips and the unit panel)
                    "Rooms & features": "الغرف والمميزات",
                    Features: "المميزات",
                    Facing: "الواجهة",
                    North: "شمالية",
