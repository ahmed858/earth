                    "Master bedrooms": "غرف النوم الرئيسية",
                    Bathrooms: "دورات المياه",
                    "Dressing rooms": "غرف الملابس",
                    "Maid's room": "غرفة خادمة",
                    "Maid's bath": "حمام خادمة",
                    Kitchen: "مطبخ",
                    "Dining room": "صالة طعام",
                    "Living room": "غرفة معيشة",
                    "Laundry room": "غرفة غسيل",
                    "Balcony / Terrace": "شرفة / تراس",
                    // Floor / section short labels
                    LG: "بدروم",
                    G: "أرضي",
                    "1st": "الأول",
                    "2nd": "الثاني",
                    "3rd": "الثالث",
                    // Common unit types (from the sheet)
                    "1 Bedroom": "غرفة نوم",
                    "2 Bedrooms": "غرفتا نوم",
                    "3 Bedrooms": "ثلاث غرف نوم",
                    Duplex: "دوبلكس",
                    Apartment: "شقة",
                    "Roof Terrace": "تراس السطح",
                    Garden: "حديقة",
                    // Location journey (Earth → Saudi Arabia → Riyadh → Khawalid 20)
                    Back: "رجوع",
                    Earth: "الأرض",
                    "Saudi Arabia": "السعودية",
                    Riyadh: "الرياض",
                    "Khawalid 20": "خوالد 20",
                    Residential: "سكني",
                    "Explore the project": "استكشف المشروع",
                    "Drag to rotate": "اسحب للتدوير",
                    "Tap to explore": "اضغط للاستكشاف",
                    "Select Saudi Arabia to begin": "اختر السعودية للبدء",
                    "Select the highlighted zone": "اختر المنطقة المظلّلة",
                    "Choose a project": "اختر المشروع",
                    "Tap a place to see distance & time from Khawalid 20":
                        "اضغط على أي موقع لمعرفة المسافة والوقت من خوالد 20",
                    "Minutes from everywhere": "دقائق من كل مكان",
                    "from Panorama Mall": "من بانوراما مول",
                    "from King Faisal Specialist Hospital": "من مستشفى الملك فيصل التخصصي",
                    "from Kingdom Centre": "من مركز المملكة",
                    "from the Diplomatic Quarter": "من حي السفارات",
                    "from King Khalid Int’l Airport": "من مطار الملك خالد الدولي",
                    "The interactive map could not load on this device.":
                        "تعذّر تحميل الخريطة التفاعلية على هذا الجهاز.",
                    "Zoom in": "تكبير",
                    "Zoom out": "تصغير",
                    "Reset view": "إعادة ضبط العرض",
                    London: "لندن",
                    Istanbul: "إسطنبول",
                    Cairo: "القاهرة",
                    Dubai: "دبي",
                    Mumbai: "مومباي",
                    Singapore: "سنغافورة",
                    Tokyo: "طوكيو",
                    "New York": "نيويورك",
                };

                /* Pattern rules for strings that carry a number. Returns the Arabic
                   replacement, or null when the rule does not apply. */
                const RX = [
                    [/^(\d+)\s+units?\s+selected$/, (m) => m[1] + " وحدة مختارة"],
                    [
                        /^(\d+)\s+of\s+(\d+)\s+units?$/,
                        (m) => m[1] + " من " + m[2] + " وحدة",
                    ],
                    [/^(\d+)\s+units?$/, (m) => m[1] + " وحدة"],
                    [/^(\d+)\s+apartments?$/, (m) => m[1] + " شقة"],
                    [/^Price range:\s*(.*)$/, (m) => "نطاق السعر: " + m[1]],
                    [/^Loading\s+(\d+)%$/, (m) => "جارٍ التحميل " + m[1] + "%"],
                    [
                        /^Great! I found (\d+) units? for you 🎉$/,
                        (m) => "رائع! وجدت " + m[1] + " وحدة لك 🎉",
                    ],
                    [
                        /^Showing (\d+) of (\d+) — refine filters to narrow down\.$/,
                        (m) => "عرض " + m[1] + " من " + m[2] + " — عدّل الفلاتر لتضييق النتائج.",
                    ],
                    [
                        /^(\d+)\s+min$/,
                        (m) => m[1] + (+m[1] >= 3 && +m[1] <= 10 ? " دقائق" : " دقيقة"),
                    ],
                    [/^([\d.]+)\s+km$/, (m) => m[1] + " كم"],
                    // Unit finder budget brackets ("Under 1.25M", "1.5M – 1.75M", "Over 2M")
                    [/^Under ([\d.]+)([MK])$/, (m) => "أقل من " + m[1] + (m[2] === "M" ? " مليون" : " ألف")],
                    [/^Over ([\d.]+)([MK])$/, (m) => "أكثر من " + m[1] + (m[2] === "M" ? " مليون" : " ألف")],
                    [/^([\d.]+)([MK]) – ([\d.]+)\2$/, (m) => m[1] + " – " + m[3] + (m[2] === "M" ? " مليون" : " ألف")],
                ];

                let LANG = "en";
                const cache = new WeakMap(); // text node -> original English
                const attrCache = new WeakMap(); // element -> { attr: original English }
                const ATTRS = ["placeholder", "title", "aria-label"];
                let obs = null;

                const skip = (node) => {
                    const el = node.nodeType === 1 ? node : node.parentNode;
                    if (!el || !el.closest) return false;
                    return !!el.closest(".tut-bubble, .lang-toggle, .intro-hero");
                };

                // Translate a raw string (with surrounding whitespace) or return null.
                function translate(raw) {
                    const key = raw.trim();
                    if (!key) return null;
                    if (AR[key] != null) return raw.replace(key, AR[key]);
                    for (const [rx, rep] of RX) {
                        const m = key.match(rx);
                        if (m) return raw.replace(key, rep(m));
                    }
                    return null;
                }

                function arNode(n) {
                    if (skip(n)) return;
                    const cur = n.nodeValue;
                    if (!cur || !cur.trim()) return;
                    const tr = translate(cur);
                    if (tr != null && tr !== cur) {
                        cache.set(n, cur);
                        n.nodeValue = tr;
                    }
                }
                function enNode(n) {
                    if (cache.has(n)) {
                        const o = cache.get(n);
                        if (n.nodeValue !== o) n.nodeValue = o;
                    }
                }

                function arAttr(el, a) {
                    const cur = el.getAttribute(a);
                    if (cur == null) return;
                    const tr = translate(cur);
                    if (tr != null && tr !== cur) {
                        let m = attrCache.get(el);
                        if (!m) {
                            m = {};
                            attrCache.set(el, m);
                        }
                        m[a] = cur;
                        el.setAttribute(a, tr);
                    }
                }
                function enAttr(el, a) {
                    const m = attrCache.get(el);
                    if (m && a in m) el.setAttribute(a, m[a]);
                }

                function walk(root, lang) {
                    if (root.nodeType === 3) {
                        lang === "ar" ? arNode(root) : enNode(root);
                        return;
                    }
                    if (root.nodeType !== 1) return;
                    const tw = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
                        acceptNode(n) {
                            const p = n.parentNode;
                            if (!p) return NodeFilter.FILTER_REJECT;
                            const tag = p.nodeName;
                            if (tag === "SCRIPT" || tag === "STYLE" || tag === "NOSCRIPT")
                                return NodeFilter.FILTER_REJECT;
                            if (skip(n)) return NodeFilter.FILTER_REJECT;
                            if (!n.nodeValue || !n.nodeValue.trim())
                                return NodeFilter.FILTER_REJECT;
                            return NodeFilter.FILTER_ACCEPT;
                        },
                    });
                    const arr = [];
                    while (tw.nextNode()) arr.push(tw.currentNode);
                    arr.forEach((n) => (lang === "ar" ? arNode(n) : enNode(n)));

                    const sel = "[" + ATTRS.join("],[") + "]";
                    const els = [];
                    if (root.matches && root.matches(sel)) els.push(root);
                    if (root.querySelectorAll)
                        root.querySelectorAll(sel).forEach((e) => els.push(e));
                    els.forEach((el) => {
                        if (el.closest(".tut-bubble, .lang-toggle, .intro-hero")) return;
                        ATTRS.forEach(
                            (a) =>
                                el.hasAttribute(a) &&
                                (lang === "ar" ? arAttr(el, a) : enAttr(el, a))
                        );
                    });
                }

                function onMut(muts) {
                    if (LANG !== "ar" || !obs) return;
                    obs.disconnect();
                    for (const m of muts) {
                        if (m.type === "characterData") arNode(m.target);
                        else if (m.type === "childList")
                            m.addedNodes.forEach((node) => {
                                if (node.nodeType === 1) walk(node, "ar");
                                else if (node.nodeType === 3) arNode(node);
                            });
                    }
                    obs.observe(document.body, {
                        subtree: true,
                        childList: true,
                        characterData: true,
                    });
                }
                function startObs() {
                    if (obs) return;
                    obs = new MutationObserver(onMut);
                    obs.observe(document.body, {
                        subtree: true,
                        childList: true,
                        characterData: true,
                    });
                }
                function stopObs() {
                    if (obs) {
                        obs.disconnect();
                        obs = null;
                    }
                }

                function updateBtn() {
                    const lbl = document.getElementById("langToggleLabel");
                    if (lbl) lbl.textContent = LANG === "ar" ? "English" : "العربية";
                }

                function apply(lang) {
                    LANG = lang;
                    stopObs();
                    walk(document.body, lang);
                    document.documentElement.setAttribute("lang", lang);
                    document.body.classList.toggle("lang-ar", lang === "ar");
                    if (lang === "ar") startObs();
                    updateBtn();
                    document.dispatchEvent(
                        new CustomEvent("i18n:change", { detail: { lang } })
                    );
                }

                function setLang(lang) {
                    try {
                        localStorage.setItem("siteLang", lang);
                    } catch (e) { }
                    apply(lang);
                }

                window.i18n = {
                    get lang() {
                        return LANG;
                    },
                    t(en) {
                        return LANG === "ar" && AR[en] != null ? AR[en] : en;
                    },
                    add(entries) {
                        Object.assign(AR, entries || {});
                    },
                    setLang,
                    toggle() {
                        setLang(LANG === "ar" ? "en" : "ar");
                    },
                };

                document
                    .getElementById("langToggle")
                    ?.addEventListener("click", () => window.i18n.toggle());

                // The projects' own Arabic (projects.js): every project's name (the Riyadh step shows them
                // all), and this project's title, map hint, floors and proximity strip.
                (function () {
                    const all = window.MAAZAR_PROJECTS || {}, P = window.MAAZAR_PROJECT;
                    const add = {};
                    Object.keys(all).forEach(function (id) {
                        const p = all[id];
                        if (p.name && p.name_ar) {
                            add[p.name] = p.name_ar;
                            add[p.name + " Assistant"] = "مساعد " + p.name_ar;
                            add[p.name + " · Typically replies instantly"] = p.name_ar + " · يردّ عادةً فورًا";
                        }
                        if (p.title && p.title_ar) add[p.title] = p.title_ar;
                    });
                    if (P) {
                        if (P.hint && P.hint_ar) add[P.hint] = P.hint_ar;
                        (P.prox || []).forEach(function (x) { if (x.en && x.ar) add[x.en] = x.ar; });
                        (P.floors || []).forEach(function (f) {
                            if (f.name && f.ar) add[f.name] = f.ar;
                            if (f.label && f.ar && add[f.label] == null) add[f.label] = f.ar;
                        });
                    }
                    Object.keys(add).forEach(function (k) { if (AR[k] == null) AR[k] = add[k]; });
                })();

                let saved = null;
                try {
                    saved = localStorage.getItem("siteLang");
                } catch (e) { }
                if (saved === "ar") apply("ar");
                else updateBtn();
            })();
        </script>

        <!-- ===================== GUIDED TUTORIAL / ONBOARDING TOUR ===================== -->
        <script>
            (function () {
                const launcher = document.getElementById("tutLauncher");
                const catcher = document.getElementById("tutCatcher");
                const hi = document.getElementById("tutHighlight");
                const bubble = document.getElementById("tutBubble");
                const arrow = document.getElementById("tutArrow");
                const iconEl = document.getElementById("tutIcon");
                const titleEl = document.getElementById("tutTitle");
                const descEl = document.getElementById("tutDesc");
                const dotsEl = document.getElementById("tutDots");
                const backBtn = document.getElementById("tutBack");
                const nextBtn = document.getElementById("tutNext");
                const closeBtn = document.getElementById("tutClose");
                if (!launcher || !bubble) return;

                /* The price/area filters and the favourite hearts live inside the units
                   table drawer, so the tour opens it for those steps and closes it again
                   afterwards (only if the tour was the one that opened it). On mobile the
                   drawer is permanently docked, so these become harmless no-ops. */
                // The tour now demos the Unit Search panel (+ its results list),
                // not the old units-table drawer.
                let panelOpenedByTour = false;
                let listOpenedByTour = false;
                function openDrawer(step) {
                    let changed = false;
                    const panel = document.getElementById("unitSearchPanel");
                    if (panel && !panel.classList.contains("show")) {
                        if (typeof window.refreshUnitSearchPanel === "function")
                            window.refreshUnitSearchPanel();
                        panel.classList.add("show");
                        panelOpenedByTour = true;
                        changed = true;
                    }
                    if (step && step.list) {
                        const list = document.getElementById("unitListPanel");
                        if (list && !list.classList.contains("show")) {
                            const v = document.getElementById("uspView");
                            if (v) v.click();
                            else list.classList.add("show");
                            listOpenedByTour = true;
                            changed = true;
                        }
                    }
                    return changed;
                }
                function closeDrawerIfOurs() {
                    let changed = false;
                    if (listOpenedByTour) {
                        document.getElementById("unitListPanel")?.classList.remove("show");
                        listOpenedByTour = false;
                        changed = true;
                    }
                    if (panelOpenedByTour) {
                        document.getElementById("unitSearchPanel")?.classList.remove("show");
                        panelOpenedByTour = false;
                        changed = true;
                    }
                    return changed;
                }

                /* Each step: icon, title, desc.
                   target  -> selector or [selectors]; first usable one is highlighted.
                   place   -> preferred bubble side ("bottom" | "top" | "left" | "right").
                   center  -> show a centred bubble with no spotlight.
                   drawer  -> open the units table drawer before showing this step. */
                const STEPS = [
                    {
                        icon: "👋",
                        center: true,
                        title: "Welcome!",
                        desc: "Take a quick tour to learn how to explore the building and find the apartment that's right for you.",
                        titleAr: "مرحبًا بك!",
                        descAr:
                            "خذ جولة سريعة لتتعلّم كيف تستكشف المبنى وتجد الشقة المناسبة لك.",
                    },
                    {
                        icon: "🔄",
                        target: "#frameViewer",
                        center: true,
                        title: "Explore in 360°",
                        desc: "Click and drag — or swipe — left or right to rotate the building and see it from every angle. Click a highlighted floor on the building to see its apartments.",
                        titleAr: "استكشف بزاوية 360°",
                        descAr:
                            "اضغط واسحب — أو مرّر — يمينًا أو يسارًا لتدوير المبنى ورؤيته من كل الزوايا. اضغط على أي طابق مميّز على المبنى لعرض شققه.",
                    },
                    {
                        icon: "🏢",
                        target: ["#ochFloorsBtn", "#floorMenu"],
                        place: "bottom",
                        title: "Pick a prototype",
                        desc: "Choose Admin, Commercial or Clinic to highlight only that kind of unit on the building. Floors are in Unit Search.",
                        titleAr: "اختر نموذجًا",
                        descAr:
                            "اختر إداري أو تجاري أو عيادة لإبراز هذا النوع من الوحدات فقط على المبنى. الطوابق موجودة في بحث الوحدات.",
                    },
                    {
                        icon: "👁️",
                        target: ["#ochEye", "#hideUnitsToggle"],
                        place: "bottom",
                        title: "Show or hide floors",
                        desc: "Turn the coloured floor overlays on the building on or off whenever you want a cleaner view.",
                        titleAr: "إظهار أو إخفاء الطوابق",
                        descAr:
                            "شغّل أو أوقف طبقات الطوابق الملوّنة على المبنى وقتما تريد رؤية أوضح.",
                    },
                    {
                        icon: "🔎",
                        target: ["#unitSearchPanel", "#ochUnits"],
                        place: "right",
                        drawer: true,
                        title: "Find your unit",
                        desc: "Open Unit Search to explore every apartment. It's your one place to filter by surface, availability, type, floor and budget.",
                        titleAr: "ابحث عن وحدتك",
                        descAr:
                            "افتح «بحث الوحدات» لاستكشاف كل الشقق. إنه مكانك الوحيد للتصفية حسب المساحة والتوفر والنوع والطابق والميزانية.",
                    },
                    {
                        icon: "🎚️",
                        target: [".usp-body", "#unitSearchPanel"],
                        place: "right",
                        drawer: true,
                        title: "Filter your search",
                        desc: "Drag the surface and budget sliders and tap availability, type or floor to narrow the results. Use Section View to jump to a floor on the building.",
                        titleAr: "صفِّ بحثك",
                        descAr:
                            "اسحب شريطَي المساحة والميزانية واضغط على التوفر أو النوع أو الطابق لتضييق النتائج. استخدم «عرض القطاع» للانتقال إلى طابق على المبنى.",
                    },
                    {
                        icon: "❤️",
                        target: ["#unitListPanel", "#ochCompare"],
                        place: "right",
                        drawer: true,
                        list: true,
                        title: "Browse & compare",
                        desc: "Tap “View list” to see matching units beside the filters. Open any unit for details, or tap its heart to add it to Compare in the top bar.",
                        titleAr: "تصفّح وقارن",
                        descAr:
                            "اضغط «عرض القائمة» لرؤية الوحدات المطابقة بجانب الفلاتر. افتح أي وحدة للتفاصيل، أو اضغط القلب لإضافتها إلى «مقارنة» في الشريط العلوي.",
                    },
                    {
                        icon: "🖼️",
                        target: ["#ochGallery", "#galleryToggle", "#tableHeadGallery"],
                        place: "right",
                        title: "Photo gallery",
                        desc: "Open the gallery to browse high-quality photos of the building, the amenities and the finishes.",
                        titleAr: "معرض الصور",
                        descAr:
                            "افتح المعرض لتصفّح صور عالية الجودة للمبنى والمرافق والتشطيبات.",
                    },
                    {
                        icon: "💬",
                        target: "#waLauncher",
                        place: "left",
                        title: "Talk to our sales team",
                        desc: "Got a question? Chat with us instantly on WhatsApp for prices, availability and viewings.",
                        titleAr: "تحدّث مع فريق المبيعات",
                        descAr:
                            "لديك سؤال؟ تواصل معنا فورًا عبر واتساب لمعرفة الأسعار والتوفر ومواعيد المعاينة.",
                    },
                    {
                        icon: "🤖",
                        target: "#ufLauncher",
                        place: "top",
                        title: "Smart unit finder",
                        desc: "Tell the assistant your budget and what you're looking for — it will suggest the apartments that match you best.",
                        titleAr: "الباحث الذكي عن الوحدات",
                        descAr:
                            "أخبر المساعد بميزانيتك وما تبحث عنه — وسيقترح عليك الشقق الأنسب لك.",
                    },
                    {
                        icon: "🎉",
                        center: true,
                        title: "You're all set!",
                        desc: "Explore freely and find your dream home. You can replay this tour anytime from the “?” button at the top-left.",
                        titleAr: "أنت جاهز الآن!",
                        descAr:
                            "استكشف بحرّية واعثر على منزل أحلامك. يمكنك إعادة هذه الجولة في أي وقت من زر «؟» في أعلى اليسار.",
                    },
                ];

                // Current tour language, mirrored from the global translation engine.
                const isAr = () => !!(window.i18n && window.i18n.lang === "ar");
                const T = {
                    back: () => (isAr() ? "السابق" : "Back"),
                    next: () => (isAr() ? "التالي" : "Next"),
                    finish: () => (isAr() ? "إنهاء" : "Finish"),
                };

                let idx = 0;
                let active = false;

                function asList(sel) {
                    return Array.isArray(sel) ? sel : [sel];
                }

                /* Exists, is displayed and has a real size (ignores occlusion). Used to
                   decide whether a step is worth showing at all. */
                function existsVisible(sel) {
                    if (!sel) return false;
                    return asList(sel).some((s) => {
                        const el = document.querySelector(s);
                        if (!el) return false;
                        const cs = getComputedStyle(el);
                        if (cs.display === "none" || cs.visibility === "hidden") return false;
                        const r = el.getBoundingClientRect();
                        return r.width >= 4 && r.height >= 4;
                    });
                }

                /* The first target that is on-screen AND not covered by another element.
                   Returns null if every candidate is hidden or occluded. */
                function firstUsable(sel) {
                    if (!sel) return null;
                    for (const s of asList(sel)) {
                        const el = document.querySelector(s);
                        if (el && isUsable(el)) return el;
                    }
                    return null;
                }

                function isUsable(el) {
                    const cs = getComputedStyle(el);
                    if (cs.display === "none" || cs.visibility === "hidden") return false;
                    const r = el.getBoundingClientRect();
                    if (r.width < 4 || r.height < 4) return false;
                    if (r.bottom < 0 || r.top > innerHeight || r.right < 0 || r.left > innerWidth)
                        return false;
                    const cx = Math.min(Math.max(r.left + r.width / 2, 2), innerWidth - 2);
                    const cy = Math.min(Math.max(r.top + r.height / 2, 2), innerHeight - 2);
                    const prevC = catcher.style.pointerEvents;
                    const prevB = bubble.style.pointerEvents;
                    catcher.style.pointerEvents = "none";
                    bubble.style.pointerEvents = "none";
                    const top = document.elementFromPoint(cx, cy);
                    catcher.style.pointerEvents = prevC;
                    bubble.style.pointerEvents = prevB;
                    if (!top) return true;
                    return el.contains(top) || top.contains(el) || top === el;
                }

                function resolvable(step) {
                    if (!step) return false;
                    if (step.center || !step.target) return true;
                    if (step.drawer) return true; // opening the drawer will reveal it
                    return existsVisible(step.target);
                }

                function buildDots() {
                    dotsEl.innerHTML = "";
                    STEPS.forEach((_, i) => {
                        const d = document.createElement("span");
                        d.className = "tut-dot" + (i === idx ? " active" : "");
                        dotsEl.appendChild(d);
                    });
                }

                function render() {
                    const step = STEPS[idx];

                    // Sync the Unit Search panel/list to what this step needs.
                    const changed = step.drawer ? openDrawer(step) : closeDrawerIfOurs();

                    const ar = isAr();
                    iconEl.textContent = step.icon || "•";
                    titleEl.textContent = (ar ? step.titleAr : step.title) || "";
                    descEl.textContent = (ar ? step.descAr : step.desc) || "";
                    buildDots();
                    backBtn.style.visibility = idx === 0 ? "hidden" : "visible";
                    backBtn.textContent = T.back();
                    nextBtn.textContent =
                        idx === STEPS.length - 1 ? T.finish() : T.next();

                    // Fade the spotlight out while the drawer animates, then reposition.
                    if (changed) {
                        hi.classList.remove("show");
                        bubble.classList.remove("show");
                        setTimeout(() => active && positionFor(step), 430);
                    } else {
                        requestAnimationFrame(() => active && positionFor(step));
                    }
                }

                function positionFor(step) {
                    const el = step.center ? null : firstUsable(step.target);
                    const isCenter = step.center || !el;

                    catcher.classList.add("show");
                    catcher.classList.toggle("center", isCenter);
                    bubble.classList.add("show");

                    if (isCenter) {
                        hi.classList.remove("show");
                        arrow.style.display = "none";
                        const bw = bubble.offsetWidth;
                        const bh = bubble.offsetHeight;
                        bubble.style.left = Math.round((innerWidth - bw) / 2) + "px";
                        bubble.style.top = Math.round((innerHeight - bh) / 2) + "px";
                        return;
                    }

                    const r = el.getBoundingClientRect();
                    const pad = 8;
                    hi.classList.add("show");
                    hi.style.left = r.left - pad + "px";
                    hi.style.top = r.top - pad + "px";
                    hi.style.width = r.width + pad * 2 + "px";
                    hi.style.height = r.height + pad * 2 + "px";

                    placeBubble(r, step.place);
                }

                function placeBubble(r, prefer) {
                    const bw = bubble.offsetWidth;
                    const bh = bubble.offsetHeight;
                    const M = 16;
                    const gap = 14;
                    const vw = innerWidth;
                    const vh = innerHeight;
                    const space = {
                        bottom: vh - r.bottom,
                        top: r.top,
                        right: vw - r.right,
                        left: r.left,
                    };
                    const order = [prefer, "bottom", "top", "right", "left"].filter(Boolean);
                    const fits = (p) =>
                        (p === "bottom" && space.bottom >= bh + gap) ||
                        (p === "top" && space.top >= bh + gap) ||
                        (p === "right" && space.right >= bw + gap) ||
                        (p === "left" && space.left >= bw + gap);
                    const place = order.find(fits) || "bottom";

                    const cx = r.left + r.width / 2;
                    const cy = r.top + r.height / 2;
                    let left;
                    let top;
                    if (place === "bottom") {
                        top = r.bottom + gap;
                        left = cx - bw / 2;
                    } else if (place === "top") {
                        top = r.top - gap - bh;
                        left = cx - bw / 2;
                    } else if (place === "right") {
                        left = r.right + gap;
                        top = cy - bh / 2;
                    } else {
                        left = r.left - gap - bw;
                        top = cy - bh / 2;
                    }

                    left = Math.min(Math.max(left, M), vw - bw - M);
                    top = Math.min(Math.max(top, M), vh - bh - M);
                    bubble.style.left = Math.round(left) + "px";
                    bubble.style.top = Math.round(top) + "px";

                    // Point the little arrow back at the target.
                    const A = 7;
                    arrow.style.display = "block";
                    arrow.style.left = "";
                    arrow.style.top = "";
                    if (place === "bottom" || place === "top") {
                        let ax = Math.min(Math.max(cx - left, 18), bw - 18);
                        arrow.style.left = ax - A + "px";
                        arrow.style.top = (place === "bottom" ? -A : bh - A) + "px";
                    } else {
                        let ay = Math.min(Math.max(cy - top, 18), bh - 18);
                        arrow.style.top = ay - A + "px";
                        arrow.style.left = (place === "right" ? -A : bw - A) + "px";
                    }
                }

                // Move to step n, skipping any steps that can't be shown right now.
                function go(n) {
                    const dir = n >= idx ? 1 : -1;
                    let i = n;
                    while (i >= 0 && i < STEPS.length && !resolvable(STEPS[i])) i += dir;
                    if (i < 0 || i >= STEPS.length) {
                        stop();
                        return;
                    }
                    idx = i;
                    render();
                }

                function start() {
                    if (active) return;
                    active = true;
                    idx = 0;
                    launcher.classList.remove("tut-pulse");
                    try {
                        localStorage.setItem("tutSeen", "1");
                    } catch (e) { }
                    render();
                    document.addEventListener("keydown", onKey);
                    window.addEventListener("resize", onResize);
                }

                function stop() {
                    active = false;
                    closeDrawerIfOurs();
                    catcher.classList.remove("show", "center");
                    hi.classList.remove("show");
                    bubble.classList.remove("show");
                    arrow.style.display = "none";
                    document.removeEventListener("keydown", onKey);
                    window.removeEventListener("resize", onResize);
                }

                function onKey(e) {
                    if (!active) return;
                    if (e.key === "Escape") stop();
                    else if (e.key === "ArrowRight") go(idx + 1);
                    else if (e.key === "ArrowLeft") go(idx - 1);
                }

                let resizeT;
                function onResize() {
                    clearTimeout(resizeT);
                    resizeT = setTimeout(() => active && positionFor(STEPS[idx]), 120);
                }

                launcher.addEventListener("click", start);
                closeBtn.addEventListener("click", stop);
                backBtn.addEventListener("click", () => go(idx - 1));
                nextBtn.addEventListener("click", () =>
                    idx >= STEPS.length - 1 ? stop() : go(idx + 1)
                );
                // Block clicks on the dimmed page; navigation is via the bubble buttons.
                catcher.addEventListener("click", (e) => e.stopPropagation());

                // Re-render the open tour when the site language is switched.
                document.addEventListener("i18n:change", () => {
                    if (active) render();
                });

                // Gently pulse the button on a visitor's first ever load.
                try {
                    if (!localStorage.getItem("tutSeen")) launcher.classList.add("tut-pulse");
                } catch (e) { }
            })();
        </script>

        <!-- ============================================================
         LOCATION INTRO MAP — logic (MapLibre GL globe + Esri / NASA
         imagery + OpenFreeMap street names + OSRM routes)
    ============================================================= -->
        <script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js"
            integrity="sha256-RamwepGJzlYFTGIKlHzPQeKR5YyV6bYVM7dAqqZe5cs=" crossorigin=""></script>
        <script>
            (function () {
                "use strict";

                /* ---------------------------------------------------------
                   CONFIG — edit coordinates / labels / links freely.
                   Khawalid 20 sits in Al Ma'athar Ash Shamali, Riyadh — between
                   Panorama Mall and Makkah Al Mukarramah Road, with King Fahd
                   Branch Road to the east (brochure "Landmarks" page). Landmark
                   coordinates come from OpenStreetMap. The project pin is the
                   confirmed plot on Prince Sultan Bin Abdulaziz Rd, between Om Al
                   Woroud Alley and Thamama Ibn Oday (24°40'56.7"N 46°40'09.0"E).
                   `logo` is the picture its map markers carry (see .brand-logo).
                --------------------------------------------------------- */
                // The projects on the map (projects.js) and the one this page is about: its pin is the centre
                // of the project step; the other projects' chips show on the Riyadh step and open their own
                // project (the page reloads into it, straight on that step — openProject).
                const PROJECTS = window.MAAZAR_PROJECTS || {};
                const PROJECT_ID = window.MAAZAR_PROJECT_ID;
                const PROJECT = window.MAAZAR_PROJECT || {};
                const escHtml = function (s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); };
                const pinOf = function (id) {
                    const p = PROJECTS[id] || {};
                    return { id: id, name: p.name || id, logo: p.logo || "01 copy - Copy.png", logoClass: p.logoClass || "brand-logo", lat: p.lat, lng: p.lng };
                };
                const OC = pinOf(PROJECT_ID);
                const OTHER_PROJECTS = Object.keys(PROJECTS).filter(function (id) { return id !== PROJECT_ID && isFinite(PROJECTS[id].lat) && isFinite(PROJECTS[id].lng); }).map(pinOf);
                function openProject(id) {
                    // Into another project: reload with it, skipping the home screen, landing on its project step.
                    window.location.href = window.location.pathname + "?project=" + encodeURIComponent(id) + "&level=3&nohero";
                }

                // Clicking OC enters the existing 360 viewer (same site). To send
                // visitors to an external URL instead, set this to that URL string.
                const OC_LINK = null; // e.g. "https://ocmall.com"

                const ICONS = {
                    pin: '<svg viewBox="0 0 24 24"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>',
                    plane: '<svg viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L11 19v-5.5z"/></svg>',
                    home: '<svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg>',
                    building: '<svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2"/></svg>',
                    calendar: '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>',
                    route: '<svg viewBox="0 0 24 24"><circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h7a3 3 0 003-3V8M16 5H9a3 3 0 00-3 3v8"/></svg>',
                    road: '<svg viewBox="0 0 24 24"><path d="M4 21 9 3h6l5 18"/><path d="M12 6v3M12 12v3M12 18v3"/></svg>',
                    ring: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg>',
                };

                // The places called out on the brochure location map, west → east
                // along the Suez Road. `img` (optional) is the photo shown at the top
                // of the destination card; leave it out to get an icon banner instead.
                // `desc` is the one-line blurb under the distance / time chips.
                const DESTS = (PROJECT.landmarks || []).map(function (d) { return Object.assign({}, d); });

                // Driving only — the card shows the real OSRM driving duration.
                const OSRM = "https://router.project-osrm.org/route/v1/driving/";

                /* ---------------------------------------------------------
                   THE JOURNEY — the visitor arrives looking at the Earth and
                   steps in one click at a time, all on a single map:
                     0 Earth          the globe, a few city names, the country chip
                     1 Saudi Arabia   the Riyadh zone, highlighted
                     2 Riyadh         the city, with the project pin
                     3 Khawalid 20    landmarks, routes and the proximity strip
                   `label` is the name shown in the header control (and its menu),
                   `hint` the line of guidance under the header. Set START_LEVEL
                   to 3 to skip the journey and open straight on the project map.
                --------------------------------------------------------- */
                const LEVELS = [
                    { label: "Earth", hint: "Select Saudi Arabia to begin" },
                    { label: "Saudi Arabia", hint: "Select the highlighted zone" },
                    { label: "Riyadh", hint: "Choose a project" },
                    { label: OC.name, hint: PROJECT.hint || ("Tap a place to see distance & time from " + OC.name) },
                ];
                // ?level=0…3 opens the map on that step (openProject lands on the project step this way).
                const START_LEVEL = (function () {
                    const v = parseInt(new URLSearchParams(window.location.search).get("level"), 10);
                    return v >= 0 && v <= 3 ? v : 0;
                })();

                const EARTH_CENTER = [45.2, 23.6];      // what the globe faces on arrival [lng, lat]
                const COUNTRY_CHIP = [43.4, 23.8];      // where the "Saudi Arabia" chip sits
                const ZONE_LABEL = [46.752, 24.722];  // where the "Riyadh" name sits
                const CITY_VIEW = [[46.585, 24.60], [46.80, 24.80]]; // always in frame at the Riyadh step [sw, ne]

                // City names on the globe — orientation only, never clickable.
                const WORLD_CITIES = [
                    { name: "London", at: [-0.12, 51.5] },
                    { name: "Istanbul", at: [28.98, 41.01] },
                    { name: "Cairo", at: [31.24, 30.04] },
                    { name: "Dubai", at: [55.27, 25.2] },
                    { name: "Mumbai", at: [72.88, 19.08] },
                    { name: "Singapore", at: [103.82, 1.35] },
                    { name: "Tokyo", at: [139.69, 35.68] },
                    { name: "New York", at: [-74.0, 40.71] },
                ];

                // A shade of the brand palette for the map style and the canvases, which
                // cannot read CSS variables themselves: tone(300), tone(950, 0.45).
                // The numbers are the --brand-* tokens of the stylesheet.
                const brandTokens = getComputedStyle(document.documentElement);
                function tone(n, alpha) {
                    const rgb = brandTokens.getPropertyValue("--brand-" + n).trim() || "120, 104, 88";
                    return alpha === undefined ? "rgb(" + rgb + ")" : "rgba(" + rgb + ", " + alpha + ")";
                }

                // Outlines, as flat [lng, lat, lng, lat, …] lists to stay compact:
                //   ZONE      Riyadh's city limits (its 14 sub-municipalities, merged)
                //   DISTRICT  Al Ma'athar Ash Shamali, the project's district
                //   COUNTRY   Saudi Arabia's mainland (Natural Earth 1:50m)
                // ZONE and DISTRICT are simplified from © OpenStreetMap contributors.
                const ZONE = ring([
                    46.4421, 24.5657, 46.4605, 24.5609, 46.5092, 24.5423, 46.6334, 24.503, 46.6533, 24.4895, 46.7767, 24.5118,
                    46.7994, 24.4838, 46.834, 24.5099, 46.8653, 24.5488, 46.8499, 24.5586, 46.8706, 24.5826, 46.8712, 24.5888,
                    46.9128, 24.5965, 46.9024, 24.6484, 46.8995, 24.6555, 46.8572, 24.6546, 46.8553, 24.7176, 46.8692, 24.7267,
                    46.8652, 24.7367, 46.8557, 24.7436, 46.8679, 24.7507, 46.8906, 24.7508, 46.8902, 24.7633, 46.904, 24.7635,
                    46.8936, 24.7692, 46.8783, 24.7815, 46.8892, 24.7964, 46.9051, 24.7758, 46.9042, 24.7744, 46.9403, 24.7784,
                    46.9493, 24.7989, 46.9661, 24.812, 46.9753, 24.8145, 46.9731, 24.8225, 46.9781, 24.8357, 47.0024, 24.8481,
                    47.0212, 24.8656, 47.0433, 24.8707, 47.0556, 24.8806, 47.0623, 24.8799, 47.0533, 24.923, 47.0416, 24.9519,
                    47.0136, 24.942, 47.0103, 24.9415, 47.002, 24.9443, 46.9902, 24.9449, 46.9735, 24.9402, 46.9557, 24.9263,
                    46.94, 24.9198, 46.9137, 24.9033, 46.9033, 24.8948, 46.8927, 24.8913, 46.8866, 24.8877, 46.8781, 24.8789,
                    46.8704, 24.8597, 46.8501, 24.8395, 46.8069, 24.8282, 46.7223, 24.7926, 46.7136, 24.8125, 46.7149, 24.818,
                    46.7213, 24.8294, 46.7086, 24.8206, 46.7003, 24.8193, 46.6795, 24.8541, 46.5842, 24.8138, 46.5804, 24.8105,
                    46.5732, 24.7995, 46.5648, 24.7968, 46.5688, 24.7831, 46.5904, 24.7364, 46.5847, 24.7303, 46.5838, 24.7184,
                    46.5803, 24.7108, 46.5601, 24.6895, 46.5579, 24.6848, 46.5573, 24.6762, 46.5537, 24.6767, 46.5469, 24.6749,
                    46.5305, 24.6786, 46.5257, 24.6746, 46.5118, 24.6751, 46.4932, 24.6695, 46.4718, 24.6446, 46.4621, 24.6253,
                    46.4547, 24.6065, 46.4421, 24.5657,
                ]);
                const DISTRICT = ring(PROJECT.outline && PROJECT.outline.length >= 8 ? PROJECT.outline
                    : [OC.lng - 0.004, OC.lat - 0.004, OC.lng + 0.004, OC.lat - 0.004, OC.lng + 0.004, OC.lat + 0.004, OC.lng - 0.004, OC.lat + 0.004, OC.lng - 0.004, OC.lat - 0.004]); // the project's district (projects.js → outline)
                const COUNTRY = ring([
                    51.98, 19, 49.04, 18.58, 48.17, 18.16, 47.58, 17.45, 47.44, 17.11, 47.14, 16.95, 46.98, 16.95,
                    46.73, 17.27, 46.31, 17.23, 45.54, 17.3, 45.15, 17.43, 44.16, 17.4, 43.92, 17.32, 43.42, 17.52,
                    43.19, 17.36, 43.24, 17.27, 43.16, 17.2, 43.12, 16.94, 43.18, 16.81, 43.17, 16.69, 42.8, 16.37,
                    42.7, 16.74, 42.39, 17.12, 42.3, 17.44, 41.75, 17.88, 41.43, 18.45, 41.23, 18.68, 41.12, 19.08,
                    40.76, 19.75, 40.08, 20.27, 39.88, 20.29, 39.73, 20.39, 39.27, 20.97, 39.09, 21.31, 39.15, 21.52,
                    38.99, 21.88, 39.09, 22.39, 39.06, 22.59, 38.46, 23.71, 37.92, 24.18, 37.54, 24.29, 37.18, 24.82,
                    37.27, 24.96, 37.15, 25.29, 36.92, 25.64, 36.76, 25.75, 36.68, 26.04, 36.52, 26.1, 36.25, 26.59,
                    35.58, 27.43, 35.18, 28.04, 34.72, 28.13, 34.62, 28.06, 34.78, 28.51, 34.95, 29.35, 36.07, 29.2,
                    36.48, 29.5, 36.75, 29.87, 37.47, 30, 37.63, 30.31, 37.98, 30.5, 36.96, 31.49, 38.96, 32, 39.14, 32.13,
                    40.37, 31.94, 42.08, 31.08, 44.69, 29.2, 46.36, 29.06, 46.53, 29.1, 47.43, 28.99, 47.67, 28.53,
                    48.44, 28.54, 48.63, 28.13, 48.81, 27.9, 48.8, 27.72, 49.24, 27.49, 49.17, 27.44, 49.41, 27.18,
                    49.54, 27.15, 49.72, 26.96, 49.98, 26.83, 50.15, 26.66, 50.01, 26.68, 50.03, 26.53, 50.19, 26.41,
                    50.22, 26.31, 50.15, 26.1, 50.03, 26.11, 50.24, 25.62, 50.46, 25.42, 50.56, 25.09, 50.93, 24.59,
                    51.41, 24.57, 51.31, 24.34, 51.57, 24.29, 51.59, 24.08, 52.56, 22.93, 55.1, 22.62, 55.19, 22.7, 55.64, 22,
                    54.98, 20, 51.98, 19,
                ]);
                function ring(flat) {
                    const out = [];
                    for (let i = 0; i < flat.length; i += 2) out.push([flat[i], flat[i + 1]]);
                    return out;
                }
                function boundsOf(points) {
                    const b = [[Infinity, Infinity], [-Infinity, -Infinity]];
                    points.forEach(function (p) {
                        b[0][0] = Math.min(b[0][0], p[0]); b[0][1] = Math.min(b[0][1], p[1]);
                        b[1][0] = Math.max(b[1][0], p[0]); b[1][1] = Math.max(b[1][1], p[1]);
                    });
                    return b;
                }

                // Map data — every source is keyless.
                //   satellite     Esri World Imagery
                //   blueMarble    NASA Blue Marble: the face of the globe, melting into
                //                 the sharper Esri imagery on the way down
                //   streets       TileJSON of OpenMapTiles-schema vector tiles: the white
                //                 road lines + the street / district names (a MapTiler
                //                 ".../tiles/v3/tiles.json?key=…" URL works here unchanged)
                //   glyphs        the fonts those names are set in
                //   rtlText       shapes Arabic street names (fetched only when one shows)
                //   labelsBackup  raster roads + names, used if `streets` can't be reached
                const TILES = {
                    satellite: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    blueMarble: "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/BlueMarble_ShadedRelief_Bathymetry/default/GoogleMapsCompatible_Level8/{z}/{y}/{x}.jpeg",
                    streets: "https://tiles.openfreemap.org/planet",
                    glyphs: "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
                    rtlText: "https://unpkg.com/@mapbox/mapbox-gl-rtl-text@0.3.0/dist/mapbox-gl-rtl-text.js",
                    labelsBackup: [
                        "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}",
                        "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}",
                    ],
                };

                /* ---------------------------------------------------------
                   DRIFTING CLOUDS — soft, translucent clouds that slide slowly
                   across the satellite imagery (as on the reference site).
                   Everything is generated in code (no image assets): a handful
                   of cloud sprites are built once from fractal noise, then drawn
                   each frame on a single canvas that sits inside the map, between
                   the imagery and the pins. Shown at the last step only.
                --------------------------------------------------------- */
                const CLOUDS = {
                    enabled: true,        // false = no cloud layer at all
                    count: null,          // null = from the viewport size (≈5 on phones … 11 on desktops)
                    sprites: 6,           // distinct cloud shapes (each is also drawn mirrored)
                    wind: 0.011,          // drift per second, as a fraction of the longer viewport side
                    slope: 0.10,          // downward drift per px travelled (0 = perfectly horizontal)
                    opacity: [0.45, 0.85],
                    size: [0.26, 0.60],   // cloud width as a fraction of the longer viewport side
                    shadow: 0.12,         // faint ground shadow strength (0 = none)
                };

                // One cloud sprite as straight-alpha RGBA bytes (w*h*4), deterministic per seed.
                function makeCloudSprite(w, h, seed) {
                    // seeded PRNG (mulberry32) for the lobe layout
                    var s = seed | 0;
                    function rnd() {
                        s = (s + 0x6d2b79f5) | 0;
                        var t = Math.imul(s ^ (s >>> 15), 1 | s);
                        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
                        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
                    }
                    // hashed-lattice value noise
                    function hash(ix, iy, k) {
                        var n = (ix * 374761393 + iy * 668265263 + k * 1442695041) | 0;
                        n = Math.imul(n ^ (n >>> 13), 1274126177);
                        n ^= n >>> 16;
                        return (n >>> 0) / 4294967296;
                    }
                    function vnoise(x, y, k) {
                        var ix = Math.floor(x), iy = Math.floor(y);
                        var fx = x - ix, fy = y - iy;
                        fx = fx * fx * (3 - 2 * fx); fy = fy * fy * (3 - 2 * fy);
                        var a = hash(ix, iy, k), b = hash(ix + 1, iy, k), c = hash(ix, iy + 1, k), d = hash(ix + 1, iy + 1, k);
                        return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy;
                    }
                    // fractal noise, remapped so the bulk of values sit in ~[0,1]
                    function fbm(x, y, k, oct, gain) {
                        var sum = 0, amp = 1, tot = 0;
                        for (var o = 0; o < oct; o++) {
                            sum += vnoise(x, y, k + o * 97) * amp; tot += amp;
                            x = x * 2.02 + 7.3; y = y * 2.02 + 3.1; amp *= gain;
                        }
                        return (sum / tot - 0.5) * 2.4 + 0.5;
                    }
                    function sstep(e0, e1, v) {
                        v = (v - e0) / (e1 - e0); v = v < 0 ? 0 : v > 1 ? 1 : v;
                        return v * v * (3 - 2 * v);
                    }

                    // cloud envelope: a few soft elliptical lobes clustered around the centre
                    var lobes = [], nl = 3 + Math.floor(rnd() * 3);
                    for (var i = 0; i < nl; i++) {
                        lobes.push({
                            cx: w * (0.30 + 0.40 * rnd()), cy: h * (0.36 + 0.28 * rnd()),
                            rx: w * (0.16 + 0.14 * rnd()), ry: h * (0.20 + 0.16 * rnd()),
                        });
                    }
                    var k = seed * 31 + 11;
                    var cell = 0.30 * h;             // base noise cell size in px
                    var warp = 0.25 * h;             // silhouette distortion
                    var N = new Float32Array(w * h); // detail noise
                    var E = new Float32Array(w * h); // smooth low-frequency noise (haze envelope)
                    var M = new Float32Array(w * h); // lobe mask
                    var x, y, p;
                    for (y = 0; y < h; y++) {
                        for (x = 0; x < w; x++) {
                            p = y * w + x;
                            N[p] = fbm(x / cell, y / cell, k, 4, 0.5);
                            E[p] = fbm(x / (cell * 1.6) + 3.7, y / (cell * 1.6) + 1.9, k + 300, 3, 0.55);
                            var wx = x + (fbm(x / (cell * 2.6), y / (cell * 2.6), k + 500, 2, 0.5) - 0.5) * warp;
                            var wy = y + (fbm(x / (cell * 2.6), y / (cell * 2.6), k + 900, 2, 0.5) - 0.5) * warp;
                            var m = 0;
                            for (i = 0; i < nl; i++) {
                                var L = lobes[i], dx = (wx - L.cx) / L.rx, dy = (wy - L.cy) / L.ry;
                                var g = 1 - (dx * dx + dy * dy);
                                if (g > 0) m += g * g;
                            }
                            // fade to nothing before the sprite border so scaled sprites never show a hard edge
                            var bx = x < w - x ? x : w - x, by = y < h - y ? y : h - y;
                            m *= sstep(0, 0.10 * w, bx) * sstep(0, 0.14 * h, by);
                            M[p] = m > 1 ? 1 : m;
                        }
                    }
                    var out = new Uint8ClampedArray(w * h * 4);
                    for (y = 0; y < h; y++) {
                        for (x = 0; x < w; x++) {
                            p = y * w + x;
                            var m2 = M[p];
                            if (m2 <= 0) continue;
                            var nn = N[p], ee = E[p];
                            // broad translucent haze: low-frequency noise contours, faded by the mask
                            var haze = sstep(0.35, 1.05, ee * (0.45 + 0.55 * m2)) * 0.55;
                            // brighter cores: detail noise, denser towards the middle of the cloud
                            var core = sstep(0.42, 0.98, nn * (0.35 + 0.65 * m2));
                            var a = 1 - (1 - haze) * (1 - core);
                            a *= sstep(0, 0.5, m2);
                            if (a <= 0.003) continue;
                            // lit from above: brighter where density grows downwards (tops of puffs)
                            var up = y > 1 ? N[p - 2 * w] : nn, dn = y < h - 2 ? N[p + 2 * w] : nn;
                            var shade = 0.5 + (dn - up) * 0.9;
                            shade = shade < 0 ? 0 : shade > 1 ? 1 : shade;
                            var lum = 0.88 + 0.12 * shade;
                            lum = lum + 0.05 * core; if (lum > 1) lum = 1;
                            var o = p * 4;
                            out[o] = Math.round(255 * lum);
                            out[o + 1] = Math.round(255 * (lum * 0.985 + 0.015));
                            out[o + 2] = 255;
                            out[o + 3] = Math.round(255 * a);
                        }
                    }
                    return out;
                }

                // The animated layer. Returns { start, stop } so the map can pause the
                // clouds whenever they are not on screen (other steps, 360 viewer).
                function makeCloudLayer(map) {
                    if (!CLOUDS.enabled) return { start: function () { }, stop: function () { } };
                    const SW = 256, SH = 128; // sprite pixels — drawn scaled up, clouds are soft anyway
                    const reduceMotion = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
                    const canvas = document.createElement("canvas");
                    canvas.className = "loc-clouds";
                    // straight after the map's own canvas: above the imagery, below every pin
                    map.getCanvasContainer().insertBefore(canvas, map.getCanvas().nextSibling);
                    const ctx = canvas.getContext("2d");
                    const sprites = [], shadows = [], clouds = [];
                    let W = 0, H = 0, dpr = 1, raf = 0, running = false, last = 0;

                    function idle(fn) {
                        if (window.requestIdleCallback) window.requestIdleCallback(fn, { timeout: 400 });
                        else setTimeout(fn, 30);
                    }
                    // Sprites are built one per idle slot so the map itself paints first;
                    // clouds fade in as their sprite becomes available.
                    function buildSprite(i) {
                        const c = document.createElement("canvas");
                        c.width = SW; c.height = SH;
                        const g = c.getContext("2d");
                        const img = g.createImageData(SW, SH);
                        img.data.set(makeCloudSprite(SW, SH, i + 1));
                        g.putImageData(img, 0, 0);
                        sprites.push(c);
                        if (CLOUDS.shadow > 0) {
                            const sc = document.createElement("canvas");
                            sc.width = SW; sc.height = SH;
                            const sg = sc.getContext("2d");
                            sg.drawImage(c, 0, 0);
                            sg.globalCompositeOperation = "source-in"; // keep the alpha, recolour dark
                            sg.fillStyle = tone(950);
                            sg.fillRect(0, 0, SW, SH);
                            shadows.push(sc);
                        }
                        if (reduceMotion) draw(0);
                        if (sprites.length < CLOUDS.sprites) idle(function () { buildSprite(i + 1); });
                    }

                    function rand(a, b) { return a + Math.random() * (b - a); }
                    function spawn(c, initial) {
                        const size = Math.max(W, H);
                        c.sprite = Math.floor(Math.random() * CLOUDS.sprites);
                        c.flip = Math.random() < 0.5;
                        c.w = size * rand(CLOUDS.size[0], CLOUDS.size[1]);
                        c.h = c.w * SH / SW;
                        c.op = rand(CLOUDS.opacity[0], CLOUDS.opacity[1]);
                        c.v = rand(0.6, 1.4);            // per-cloud speed → a little parallax
                        c.a = reduceMotion ? 1 : 0;      // fades in on first draw
                        c.y = rand(-0.05, 0.95) * H;
                        c.x = initial ? rand(-c.w / 2, W + c.w / 2) : -c.w / 2 - rand(0, W * 0.5);
                    }
                    function resize() {
                        const box = map.getContainer();
                        if (!box.clientWidth || !box.clientHeight) return; // overlay hidden — keep the old state
                        const ow = W, oh = H;
                        W = box.clientWidth; H = box.clientHeight;
                        dpr = Math.min(window.devicePixelRatio || 1, 1.25);
                        canvas.width = Math.round(W * dpr);
                        canvas.height = Math.round(H * dpr);
                        canvas.style.width = W + "px";
                        canvas.style.height = H + "px";
                        const n = CLOUDS.count || Math.min(12, Math.round(4 + (W * H) / 300000));
                        if (ow && oh) {
                            const k = Math.max(W, H) / Math.max(ow, oh);
                            clouds.forEach(function (c) { c.x *= W / ow; c.y *= H / oh; c.w *= k; c.h *= k; });
                        }
                        while (clouds.length < n) { const c = {}; spawn(c, true); clouds.push(c); }
                        clouds.length = n;
                        if (reduceMotion) draw(0);
                    }

                    function blit(list, c, k, ox, oy) {
                        const img = list[c.sprite % list.length];
                        if (!img) return;
                        ctx.globalAlpha = c.op * c.a * k;
                        const x = c.x - c.w / 2 + ox, y = c.y - c.h / 2 + oy;
                        if (c.flip) {
                            ctx.save();
                            ctx.translate(x + c.w, y);
                            ctx.scale(-1, 1);
                            ctx.drawImage(img, 0, 0, c.w, c.h);
                            ctx.restore();
                        } else {
                            ctx.drawImage(img, x, y, c.w, c.h);
                        }
                    }
                    function draw(dt) {
                        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                        ctx.clearRect(0, 0, W, H);
                        if (!sprites.length) return;
                        const wind = Math.max(W, H) * CLOUDS.wind;
                        clouds.forEach(function (c) {
                            const dx = wind * c.v * dt;
                            c.x += dx; c.y += dx * CLOUDS.slope;
                            if (c.x - c.w / 2 > W || c.y - c.h / 2 > H) spawn(c, false); // left the screen → re-enter from the left
                            if (c.a < 1) c.a = Math.min(1, c.a + dt * 0.4);            // ~2.5 s fade-in
                        });
                        // shadows first, so a cloud is never darkened by its neighbour's shadow
                        if (CLOUDS.shadow > 0) clouds.forEach(function (c) { blit(shadows, c, CLOUDS.shadow, c.w * 0.05, c.h * 0.16); });
                        clouds.forEach(function (c) { blit(sprites, c, 1, 0, 0); });
                        ctx.globalAlpha = 1;
                    }
                    function tick(now) {
                        if (!running) return;
                        const dt = Math.min(0.1, (now - last) / 1000) || 0;
                        last = now;
                        draw(dt);
                        raf = requestAnimationFrame(tick);
                    }
                    function start() {
                        resize();
                        if (reduceMotion || running) return; // reduced motion: clouds stay still
                        running = true;
                        last = performance.now();
                        raf = requestAnimationFrame(tick);
                    }
                    function stop() {
                        running = false;
                        if (raf) cancelAnimationFrame(raf);
                        raf = 0;
                    }

                    map.on("resize", resize);
                    idle(function () { buildSprite(0); });
                    return { start: start, stop: stop };
                }

                /* ---------------------------------------------------------
                   The highlighted outlines. Each belongs to a step and fades
                   with it (not with the zoom: a phone and a desktop reach the
                   same step at quite different zooms). One opacity per step:
                                                Earth  Saudi  Riyadh  Khawalid 20
                --------------------------------------------------------- */
                const OUTLINES = {
                    "country-fill": ["fill-opacity", [0.2, 0, 0, 0]],
                    "country-line": ["line-opacity", [0.95, 0, 0, 0]],
                    "zone-mask": ["fill-opacity", [0, 0.46, 0, 0]], // dims everything around the zone
                    "zone-fill": ["fill-opacity", [0, 0.27, 0, 0]],
                    "zone-glow": ["line-opacity", [0, 0.7, 0.4, 0]],
                    "zone-line": ["line-opacity", [0, 1, 0.9, 0]],
                    "district-fill": ["fill-opacity", [0, 0, 0.46, 0]],
                    "district-line": ["line-opacity", [0, 0, 1, 0]],
                };

                /* ---------------------------------------------------------
                   The map style: satellite imagery, the outlines above (each
                   with a "-hover" twin that lights up under the pointer) and
                   the route. Street lines and names join once their tiles
                   answer (addStreets).
                --------------------------------------------------------- */
                function mapStyle() {
                    const hover = ["boolean", ["feature-state", "hover"], false];
                    const at = function (id) { return OUTLINES[id][1][START_LEVEL]; };
                    const lit = function (id, source) {
                        return { id: id, type: "fill", source: source, paint: { "fill-color": tone(100), "fill-opacity": ["case", hover, 0.16, 0] } };
                    };
                    const zoomed = function () { return ["interpolate", ["linear"], ["zoom"]].concat(Array.prototype.slice.call(arguments)); };
                    const poly = function (rings) {
                        return { type: "geojson", data: { type: "Feature", id: 1, properties: {}, geometry: { type: "Polygon", coordinates: rings } } };
                    };
                    const empty = function () { return { type: "geojson", data: { type: "FeatureCollection", features: [] } }; };
                    const round = { "line-cap": "round", "line-join": "round" };
                    return {
                        version: 8,
                        projection: { type: "globe" },
                        glyphs: TILES.glyphs,
                        // a thin blue rim on the globe, lit from the sun's side (top right)
                        sky: { "atmosphere-blend": zoomed(0, 0.45, 4.5, 0.45, 6.5, 0) },
                        light: { anchor: "viewport", position: [1.5, 60, 78] },
                        sources: {
                            satellite: { type: "raster", tiles: [TILES.satellite], tileSize: 256, maxzoom: 19 },
                            "blue-marble": { type: "raster", tiles: [TILES.blueMarble], tileSize: 256, maxzoom: 8 },
                            country: poly([COUNTRY]),
                            zone: poly([ZONE]),
                            // everything around the zone, dimmed so the zone reads as the bright area
                            "zone-mask": poly([[[28, 8], [66, 8], [66, 40], [28, 40], [28, 8]], ZONE]),
                            district: poly([DISTRICT]),
                            route: empty(),
                            "route-leads": empty(),
                            "route-nodes": empty(),
                        },
                        layers: [
                            { id: "satellite", type: "raster", source: "satellite" },
                            {
                                id: "blue-marble", type: "raster", source: "blue-marble", maxzoom: 6.5,
                                paint: { "raster-opacity": zoomed(4, 1, 6, 0) }
                            },

                            {
                                id: "country-fill", type: "fill", source: "country",
                                paint: { "fill-color": tone(200), "fill-opacity": at("country-fill") }
                            },
                            lit("country-hover", "country"),
                            {
                                id: "country-line", type: "line", source: "country", layout: round,
                                paint: { "line-color": tone(100), "line-width": 1.4, "line-opacity": at("country-line") }
                            },

                            {
                                id: "zone-mask", type: "fill", source: "zone-mask",
                                paint: { "fill-color": tone(975), "fill-opacity": at("zone-mask") }
                            },
                            {
                                id: "zone-fill", type: "fill", source: "zone",
                                paint: { "fill-color": tone(400), "fill-opacity": at("zone-fill") }
                            },
                            lit("zone-hover", "zone"),
                            {
                                id: "district-fill", type: "fill", source: "district",
                                paint: { "fill-color": tone(300), "fill-opacity": at("district-fill") }
                            },
                            lit("district-hover", "district"),
                            // street lines are inserted here, under the outlines (see addStreets)
                            {
                                id: "zone-glow", type: "line", source: "zone", layout: round,
                                paint: { "line-color": tone(500), "line-width": 9, "line-blur": 7, "line-opacity": at("zone-glow") }
                            },
                            {
                                id: "zone-line", type: "line", source: "zone", layout: round,
                                paint: { "line-color": tone(150), "line-width": zoomed(7, 1.4, 10, 2.4), "line-opacity": at("zone-line") }
                            },
                            {
                                id: "district-line", type: "line", source: "district", layout: round,
                                paint: { "line-color": tone(100), "line-width": zoomed(10, 1.4, 12.5, 2.4), "line-opacity": at("district-line") }
                            },

                            // White route over a dark halo, dotted lead-ins and small node dots
                            // (start, end and a few evenly spaced turns) like a printed itinerary.
                            {
                                id: "route-casing", type: "line", source: "route", layout: round,
                                paint: { "line-color": tone(950), "line-width": 8, "line-opacity": 0.45 }
                            },
                            {
                                id: "route-line", type: "line", source: "route", layout: round,
                                paint: { "line-color": "#ffffff", "line-width": 3.5, "line-opacity": 0.98 }
                            },
                            {
                                id: "route-leads", type: "line", source: "route-leads", layout: { "line-cap": "round" },
                                paint: { "line-color": "#ffffff", "line-width": 2, "line-opacity": 0.85, "line-dasharray": [1, 3.5] }
                            },
                            {
                                id: "route-nodes", type: "circle", source: "route-nodes",
                                paint: { "circle-radius": 4.5, "circle-color": "#ffffff", "circle-stroke-color": tone(950), "circle-stroke-width": 2 }
                            },
                        ],
                    };
                }

                // Street / place names follow the site language; where a name has no
                // translation the local (Arabic) one is used.
                function nameField(lang) {
                    return lang === "ar"
                        ? ["coalesce", ["get", "name:ar"], ["get", "name"]]
                        : ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]];
                }
                function siteLang() {
                    return window.i18n && window.i18n.lang === "ar" ? "ar" : "en";
                }

                // White road lines + names, drawn from the vector tiles. Thin and quiet
                // from far away; bigger roads show first, side streets join as you zoom.
                function streetLayers() {
                    const zoomed = function () { return ["interpolate", ["linear"], ["zoom"]].concat(Array.prototype.slice.call(arguments)); };
                    const classIs = function (list) { return ["match", ["get", "class"], list, true, false]; };
                    const MAJOR = ["motorway", "trunk", "primary"], MID = ["secondary", "tertiary"], MINOR = ["minor"];
                    // Not street names: bus-line codes, placeholder names and motorway exit numbers.
                    const named = ["all"].concat(["BRT", "road_", "Exit", "مخرج"].map(function (junk) {
                        return ["!", ["in", junk, ["coalesce", ["get", "name"], ""]]];
                    }));
                    const halo = { "text-halo-color": tone(975, 0.92), "text-halo-width": 1.7, "text-halo-blur": 0.3 };
                    const line = function (id, classes, minzoom, opacity, width) {
                        return {
                            id: id, type: "line", source: "streets", "source-layer": "transportation", minzoom: minzoom, filter: classIs(classes),
                            layout: { "line-cap": "round", "line-join": "round" },
                            paint: { "line-color": "#ffffff", "line-opacity": opacity, "line-width": width }
                        };
                    };
                    const roadName = function (id, classes, minzoom, size, color) {
                        return {
                            id: id, type: "symbol", source: "streets", "source-layer": "transportation_name", minzoom: minzoom, filter: ["all", classIs(classes), named],
                            layout: {
                                "symbol-placement": "line", "symbol-spacing": 300, "text-field": nameField(siteLang()), "text-font": ["Noto Sans Bold"],
                                "text-size": size, "text-max-angle": 50, "text-padding": 4, "text-letter-spacing": 0.02
                            },
                            paint: Object.assign({ "text-color": color }, halo)
                        };
                    };
                    const place = function (id, classes, minzoom, maxzoom, layout, color) {
                        return {
                            id: id, type: "symbol", source: "streets", "source-layer": "place", minzoom: minzoom, maxzoom: maxzoom, filter: classIs(classes),
                            layout: Object.assign({
                                "text-field": nameField(siteLang()), "text-font": ["Noto Sans Regular"], "text-padding": 6,
                                "symbol-sort-key": ["coalesce", ["get", "rank"], 99]
                            }, layout),
                            paint: Object.assign({ "text-color": color }, halo)
                        };
                    };
                    return {
                        lines: [
                            line("street-minor", MINOR, 13.4, 0.3, zoomed(13.4, 0.3, 16, 2.2, 19, 6)),
                            line("street-mid", MID, 10.2, 0.42, zoomed(10.2, 0.4, 13, 1.3, 16, 3.6, 19, 8)),
                            line("street-major", MAJOR, 5.5, zoomed(6, 0.25, 9, 0.5, 14, 0.58), zoomed(6, 0.4, 9, 0.9, 12, 1.8, 15, 4, 19, 10)),
                        ],
                        // later layers are placed first, so the biggest roads get their names before anything else
                        labels: [
                            place("place-area", ["suburb", "quarter", "neighbourhood"], 11.6, 24,
                                { "text-size": zoomed(11.6, 9.5, 15, 12.5), "text-transform": "uppercase", "text-letter-spacing": 0.12 }, tone(100, 0.86)),
                            place("place-town", ["town", "village"], 7.6, 12.5, { "text-size": zoomed(7.6, 11, 12, 13.5) }, "rgba(255, 255, 255, 0.92)"),
                            roadName("street-name-minor", MINOR, 14.2, zoomed(14.2, 11, 17, 14.5), "rgba(255, 255, 255, 0.92)"),
                            roadName("street-name-mid", MID, 11.6, zoomed(11.6, 11.5, 13, 13.5, 16, 17.5), "#ffffff"),
                            roadName("street-name-major", MAJOR, 8.5, zoomed(8.5, 12, 11, 15, 13, 17, 16, 21), "#ffffff"),
                        ],
                    };
                }

                /* ---------------------------------------------------------
                   Boot.
                --------------------------------------------------------- */
                function start() {
                    const overlay = document.getElementById("locOverlay");
                    const hint = document.getElementById("locHint");
                    const reduceMotion = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
                    let clouds = { start: function () { }, stop: function () { } };

                    // The "Minutes from everywhere" strip — this project's figures (projects.js → prox).
                    (function () {
                        const list = document.querySelector("#locProx .loc-prox-list");
                        if (!list || !PROJECT.prox || !PROJECT.prox.length) return;
                        list.innerHTML = PROJECT.prox.map(function (p) {
                            return '<li><span class="loc-prox-val">' + escHtml(p.min) + "</span> " + escHtml(p.en) + "</li>";
                        }).join("");
                    })();
                    let level = START_LEVEL;   // current step, 0…3
                    let reopen = null;         // set by boot(): readies the map when the overlay comes back

                    // ----- enter the 360 viewer -----
                    // Wired before the map exists, so "Explore the project" keeps working
                    // even if the map library or WebGL is unavailable.
                    let entered = false;
                    // Hide the location overlay (don't destroy the map, so the Location
                    // launcher can re-open it later). First time also reveals the app
                    // launchers via the site-entered flag.
                    function enterSite() {
                        if (OC_LINK && !entered) { window.location.href = OC_LINK; return; }
                        if (!entered) {
                            entered = true;
                            document.body.classList.add("site-entered");
                        }
                        overlay.classList.add("loc-hidden");
                        setTimeout(function () {
                            if (overlay.classList.contains("loc-hidden")) {
                                overlay.style.display = "none";
                                clouds.stop();
                            }
                        }, 650);
                    }

                    // Re-open the location / directions map from the Location launcher —
                    // straight on the project step; Back leads out to the city and the globe.
                    function showLocation() {
                        overlay.style.display = "";
                        void overlay.offsetWidth; // force reflow so the fade-in transitions
                        overlay.classList.remove("loc-hidden");
                        setTimeout(function () { if (reopen) reopen(); }, 80);
                    }

                    document.getElementById("locEnterBtn").addEventListener("click", enterSite);
                    var locLauncherBtn = document.getElementById("locLauncher");
                    if (locLauncherBtn) locLauncherBtn.addEventListener("click", showLocation);

                    // Language chip: the site-wide toggle, reachable before the viewer opens.
                    const langBtn = document.getElementById("locLang");
                    function syncLangChip() { langBtn.textContent = siteLang() === "ar" ? "EN" : "AR"; }
                    langBtn.addEventListener("click", function () { if (window.i18n) window.i18n.toggle(); });
                    document.addEventListener("i18n:change", syncLangChip);
                    syncLangChip();

                    function fail(err) {
                        if (err) console.warn("[map] unavailable:", err && err.message ? err.message : err);
                        overlay.classList.add("loc-nomap", "loc-ready");
                    }
                    // The library is a blocking script just above; give a slow CDN a few seconds.
                    (function waitForLib(tries) {
                        if (window.maplibregl) { try { boot(); } catch (e) { fail(e); } return; }
                        if (tries <= 0) { fail("map library did not load"); return; }
                        setTimeout(function () { waitForLib(tries - 1); }, 150);
                    })(40);

                    function boot() {
                        const mapEl = document.getElementById("locMap");
                        const map = new maplibregl.Map({
                            container: mapEl,
                            style: mapStyle(),
                            center: EARTH_CENTER,
                            zoom: 1.5,
                            attributionControl: false, // credited in .loc-attrib
                            dragRotate: false,
                            pitchWithRotate: false,
                            touchPitch: false,
                            pixelRatio: Math.min(window.devicePixelRatio || 1, 2),
                        });
                        map.touchZoomRotate.disableRotation();
                        map.keyboard.disableRotation();
                        // A tile that fails to load is not fatal — the imagery under it keeps showing.
                        map.on("error", function (e) { console.debug("[map]", e && e.error ? e.error.message : e); });

                        // ----- drifting clouds + edge vignette (inside the map, under the pins) -----
                        clouds = makeCloudLayer(map);
                        const vignette = document.createElement("div");
                        vignette.className = "loc-vignette";
                        map.getCanvasContainer().appendChild(vignette);

                        // ----- the globe's size -----
                        // MapLibre draws the globe so that its scale at the centre matches
                        // Mercator there (radius = world size / 2π / cos φ) and views it in
                        // perspective, so a given zoom means a different size at each latitude
                        // and on each screen. These turn "this many pixels wide" into a zoom.
                        const headerEl = overlay.querySelector(".loc-header"), proxEl = document.getElementById("locProx");
                        function size() { return { w: mapEl.clientWidth || 1, h: mapEl.clientHeight || 1 }; }
                        function globe() {
                            const s = size();
                            // as big as the screen allows, but clear of the header and the gesture cue on short ones
                            const apparent = Math.max(60, Math.min(s.h * 0.4, s.w * 0.45, (s.h - headerEl.offsetHeight - 64) * 0.54));
                            const fov = (map.getVerticalFieldOfView ? map.getVerticalFieldOfView() : 36.87) * Math.PI / 180;
                            const d = 0.5 * s.h / Math.tan(fov / 2);       // camera → map centre, px
                            const sin = Math.sin(Math.atan(apparent / d));
                            const r = d * sin / (1 - sin);                 // true radius, px
                            return { r: r, apparent: apparent, horizon: r / (d + r) };
                        }
                        function globeZoom(lat) {
                            return Math.log2(globe().r * 2 * Math.PI * Math.cos(lat * Math.PI / 180) / 512);
                        }

                        // ----- stars behind the globe -----
                        function paintStars() {
                            const c = document.getElementById("locStars");
                            const w = overlay.clientWidth, h = overlay.clientHeight;
                            if (!c || !w || !h) return;
                            const dpr = Math.min(window.devicePixelRatio || 1, 2);
                            c.width = Math.round(w * dpr); c.height = Math.round(h * dpr);
                            const g = c.getContext("2d");
                            g.setTransform(dpr, 0, 0, dpr, 0, 0);
                            let seed = 20250903; // same sky on every visit
                            const rnd = function () { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed / 4294967296; };
                            const n = Math.round(Math.min(900, (w * h) / 2400));
                            for (let i = 0; i < n; i++) {
                                const x = rnd() * w, y = rnd() * h, m = rnd();
                                g.globalAlpha = 0.16 + rnd() * (m > 0.9 ? 0.8 : 0.45);
                                g.fillStyle = m > 0.97 ? "#cfe0ff" : m < 0.03 ? "#ffe6c4" : "#ffffff";
                                g.beginPath();
                                g.arc(x, y, m > 0.985 ? 1.4 : m > 0.9 ? 1 : 0.6, 0, 6.2832);
                                g.fill();
                            }
                        }

                        // ----- markers -----
                        // lv = the step the marker belongs to (CSS fades it in on arrival).
                        function marker(lngLat, lv, html, label) {
                            const el = document.createElement("div");
                            el.className = "loc-mk";
                            el.dataset.lv = String(lv);
                            if (label) el.setAttribute("aria-label", label); else el.setAttribute("aria-hidden", "true");
                            el.innerHTML = html;
                            new maplibregl.Marker({ element: el, anchor: "top-left" }).setLngLat(lngLat).addTo(map);
                            return el;
                        }
                        // A marker tap must not also count as a tap on the map underneath.
                        function onTap(el, fn) {
                            el.addEventListener("click", function (e) { e.stopPropagation(); fn(e); });
                        }
                        const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
                        const logoOf = function (p) { return '<span class="' + (p.logoClass || "brand-logo") + '"><img src="' + encodeURI(p.logo) + '" alt="" draggable="false" /></span>'; };
                        const ocLogo = logoOf(OC);

                        // Earth: city names + the country chip (hidden while on the far side)
                        const globeMarks = WORLD_CITIES.map(function (c) {
                            const el = marker(c.at, 0, '<span class="loc-city"><i></i><span>' + c.name + "</span></span>");
                            // a name right beside the chip is dropped while the globe is small (see .loc-near)
                            if (Math.hypot((c.at[0] - COUNTRY_CHIP[0]) * 0.9, c.at[1] - COUNTRY_CHIP[1]) < 14) el.classList.add("loc-near");
                            return { at: c.at, el: el };
                        });
                        const countryEl = marker(COUNTRY_CHIP, 0,
                            '<button class="loc-country" type="button"><span>' + LEVELS[1].label + "</span>" + arrow + "</button>", LEVELS[1].label);
                        onTap(countryEl.firstElementChild, function () { goLevel(1); });
                        globeMarks.push({ at: COUNTRY_CHIP, el: countryEl });

                        // Saudi Arabia: the zone's name
                        const zoneEl = marker(ZONE_LABEL, 1,
                            '<button class="loc-zone" type="button"><b>' + LEVELS[2].label + "</b><small>Tap to explore</small></button>", LEVELS[2].label);
                        onTap(zoneEl.firstElementChild, function () { goLevel(2); });

                        // Riyadh: one chip per project (its logo, its name above), a dot on its plot. This project's
                        // chip leads on to its map step; another project's reloads the page into that project.
                        const projChip = function (p, cls) {
                            return '<button class="loc-proj ' + cls + '" type="button"><span class="loc-proj-chip">' + logoOf(p) +
                                '<span class="loc-proj-name">' + escHtml(p.name) + '</span></span><span class="loc-proj-stem"></span><span class="loc-proj-dot"></span></button>';
                        };
                        const projEl = marker([OC.lng, OC.lat], 2, projChip(OC, "loc-proj-current"), OC.name);
                        onTap(projEl.firstElementChild, function () { goLevel(3); });
                        OTHER_PROJECTS.forEach(function (p) {
                            const el = marker([p.lng, p.lat], 2, projChip(p, "loc-proj-other"), p.name);
                            onTap(el.firstElementChild, function () { openProject(p.id); });
                        });

                        // Khawalid 20: destination markers — round icon badge + slate label chip
                        const allPoints = [[OC.lng, OC.lat]];
                        const pins = []; // every step-3 pin: where it is + its element (see pinsView)
                        DESTS.forEach(function (d) {
                            const el = marker([d.lng, d.lat], 3,
                                '<div class="loc-pin" data-id="' + d.id + '"><span class="loc-pin-ico">' +
                                (ICONS[d.icon] || ICONS.pin) + '</span><span class="loc-pin-txt">' + d.name + "</span></div>", d.en);
                            onTap(el.firstElementChild, function () { selectDest(d); });
                            d._pin = el.firstElementChild;
                            pins.push({ lng: d.lng, lat: d.lat, el: d._pin });
                            allPoints.push([d.lng, d.lat]);
                        });
                        // …and the OC anchor marker: the logo tile the routes start from
                        const ocEl = marker([OC.lng, OC.lat], 3,
                            '<div class="loc-pin loc-oc"><span class="loc-pin-ico">' + ocLogo + "</span></div>", OC.name);
                        ocEl.classList.add("loc-mk-oc");
                        onTap(ocEl.firstElementChild, enterSite);
                        pins.push({ lng: OC.lng, lat: OC.lat, el: ocEl.firstElementChild });

                        // ----- framing -----
                        const ZONE_BOUNDS = boundsOf(ZONE);
                        const HOME_BOUNDS = boundsOf(allPoints);
                        // A frame's padding, scaled down where the screen is too small for it.
                        function pad(top, right, bottom, left) {
                            const s = size();
                            const ky = Math.min(1, (s.h * 0.6) / (top + bottom)), kx = Math.min(1, (s.w * 0.6) / (left + right));
                            return { top: top * ky, bottom: bottom * ky, left: left * kx, right: right * kx };
                        }
                        // Keep pins clear of the brand/enter bar (top), the popup card (top)
                        // and the proximity panel (bottom) whenever we fit the view.
                        function below() { return headerEl.offsetHeight + 4; }                             // the header: one row, two on phones
                        function above() { return proxEl.offsetHeight ? proxEl.offsetHeight + 46 : 62; }    // the facts strip — or, on short screens, the hint
                        function docked() { return size().h < 560; }                                        // short screen: the card docks right (CSS)
                        function routePad() {                                                               // route view: room for the card
                            return docked() ? pad(below() + 10, 344, 24, 40) : pad(below() + 250, 90, above(), 40);
                        }
                        function homePad() { return pad(below() + 22, 72, above(), 20); }                   // overview: header + facts strip

                        // A pin is a badge on its place plus a label beside it. On a narrow screen
                        // the labels of the eastern pins hang to the left (.loc-flip), so the two
                        // groups of pins face each other instead of running off the right edge.
                        function layoutPins() {
                            const narrow = size().w < 640, mid = (HOME_BOUNDS[0][0] + HOME_BOUNDS[1][0]) / 2;
                            pins.forEach(function (p) { p.el.classList.toggle("loc-flip", narrow && p.lng > mid); });
                        }
                        // The closest view in which every pin — badge and label, not just the
                        // point — fits inside the padding. (Web-Mercator maths: the map is flat
                        // for all practical purposes at this scale.)
                        function pinsView(padding) {
                            const s = size(), rad = Math.PI / 180;
                            const w = s.w - padding.left - padding.right, h = s.h - padding.top - padding.bottom;
                            if (w < 80 || h < 80) return null;
                            const boxes = pins.map(function (p) {
                                const sin = Math.sin(p.lat * rad), half = p.el.firstElementChild.offsetWidth / 2;
                                const wide = p.el.offsetWidth, tall = p.el.offsetHeight / 2, flip = p.el.classList.contains("loc-flip");
                                return {
                                    x: (p.lng + 180) / 360, y: 0.5 - Math.log((1 + sin) / (1 - sin)) / (4 * Math.PI),
                                    l: flip ? half - wide : -half, r: flip ? half : wide - half, t: -tall, b: tall
                                };
                            });
                            const extent = function (world) { // px box around all pins when the whole map is `world` px across
                                const e = { x0: Infinity, x1: -Infinity, y0: Infinity, y1: -Infinity };
                                boxes.forEach(function (b) {
                                    e.x0 = Math.min(e.x0, b.x * world + b.l); e.x1 = Math.max(e.x1, b.x * world + b.r);
                                    e.y0 = Math.min(e.y0, b.y * world + b.t); e.y1 = Math.max(e.y1, b.y * world + b.b);
                                });
                                return e;
                            };
                            let lo = 512 * Math.pow(2, 8), hi = 512 * Math.pow(2, 15.5);
                            let e = extent(lo);
                            if (e.x1 - e.x0 > w || e.y1 - e.y0 > h) return null;
                            for (let i = 0; i < 32; i++) {
                                const mid = Math.sqrt(lo * hi);
                                e = extent(mid);
                                if (e.x1 - e.x0 <= w && e.y1 - e.y0 <= h) lo = mid; else hi = mid;
                            }
                            e = extent(lo);
                            // the middle of that box goes to the middle of the padded area
                            const cx = (e.x0 + e.x1) / 2 - (padding.left - padding.right) / 2;
                            const cy = (e.y0 + e.y1) / 2 - (padding.top - padding.bottom) / 2;
                            return {
                                center: [cx / lo * 360 - 180, Math.atan(Math.sinh(Math.PI * (1 - 2 * cy / lo))) / rad],
                                zoom: Math.log2(lo / 512),
                            };
                        }
                        function frame(bounds, padding, fallbackZoom) {
                            let cam = null;
                            // maxZoom: or the answer is capped by the zoom range of the step we are leaving
                            try { cam = map.cameraForBounds(bounds, { padding: padding, maxZoom: 22 }); } catch (e) { }
                            if (cam && cam.center && isFinite(cam.zoom)) return { center: cam.center, zoom: cam.zoom };
                            return { center: [(bounds[0][0] + bounds[1][0]) / 2, (bounds[0][1] + bounds[1][1]) / 2], zoom: fallbackZoom };
                        }
                        // Where the camera rests at each step.
                        function viewFor(lv) {
                            const s = size();
                            if (lv === 0) return { center: EARTH_CENTER, zoom: globeZoom(EARTH_CENTER[1]) };
                            const side = Math.max(24, s.w * 0.14);
                            if (lv === 1) return frame(ZONE_BOUNDS, pad(s.h * 0.26, side, s.h * 0.2, side), 9.2);
                            if (lv === 2) return frame(CITY_VIEW, pad(below() + 16, 24, 40, 24), 11);
                            return pinsView(homePad()) || frame(HOME_BOUNDS, homePad(), 12.8);
                        }
                        // How far the visitor may zoom away from a step's resting view.
                        function setZoomRange(lv, view) {
                            map.setMinZoom(null); map.setMaxZoom(null);
                            if (lv === 0 || !view) return;
                            map.setMinZoom(view.zoom - [0, 1.6, 1.3, 2.2][lv]);
                            map.setMaxZoom(lv === 3 ? 19 : view.zoom + [0, 2.2, 3.6][lv]);
                        }

                        // ----- gestures -----
                        // The app can be CSS-rotated 90° (landscape on an upright phone, see the
                        // orientation controller, which sets body.ui-rotated). MapLibre reads raw
                        // screen coordinates, so its drag would pan sideways: it is switched off
                        // there and a one-finger drag is remapped by hand (rotatedPan below);
                        // pinch keeps zooming on the centre.
                        let rotated = document.body.classList.contains("ui-rotated");
                        let flying = false;
                        function setGestures(on) {
                            const free = on && level > 0; // the Earth step has its own drag-to-rotate
                            ["scrollZoom", "boxZoom", "doubleClickZoom", "keyboard"].forEach(function (h) { map[h][free ? "enable" : "disable"](); });
                            map.dragPan[free && !rotated ? "enable" : "disable"]();
                            if (free) map.touchZoomRotate.enable(rotated ? { around: "center" } : undefined);
                            else map.touchZoomRotate.disable();
                            map.touchZoomRotate.disableRotation();
                        }
                        function setRotated(on) {
                            rotated = !!on;
                            if (!flying) setGestures(true);
                        }
                        // Screen delta → delta inside the (possibly rotated) app box.
                        function appDelta(dx, dy) { return rotated ? [dy, -dx] : [dx, dy]; }
                        // Map-space point of a map mouse event, whatever the rotation.
                        function pointOf(e) {
                            const oe = e.originalEvent;
                            return rotated && oe ? [oe.clientY, window.innerWidth - oe.clientX] : e.point;
                        }

                        // ----- stepping between levels -----
                        const navEl = document.getElementById("locNav");
                        const backBtn = document.getElementById("locBack");
                        const levelBtn = document.getElementById("locLevelBtn");
                        const levelName = document.getElementById("locLevelName");
                        const levelMenu = document.getElementById("locLevelMenu");
                        LEVELS.forEach(function (lv, i) {
                            const li = document.createElement("li");
                            const b = document.createElement("button");
                            b.type = "button";
                            b.textContent = lv.label;
                            b.addEventListener("click", function () { openMenu(false); goLevel(i); });
                            li.appendChild(b);
                            levelMenu.appendChild(li);
                        });
                        function openMenu(open) {
                            navEl.classList.toggle("open", open);
                            levelBtn.setAttribute("aria-expanded", open ? "true" : "false");
                        }
                        levelBtn.addEventListener("click", function () { openMenu(!navEl.classList.contains("open")); });
                        document.addEventListener("click", function (e) { if (!navEl.contains(e.target)) openMenu(false); });
                        document.addEventListener("keydown", function (e) { if (e.key === "Escape") openMenu(false); });
                        backBtn.addEventListener("click", function () { openMenu(false); if (level > 0) goLevel(level - 1); });

                        function syncChrome() {
                            overlay.dataset.level = String(level);
                            levelName.textContent = LEVELS[level].label;
                            hint.textContent = LEVELS[level].hint;
                            hint.style.opacity = "";
                            backBtn.disabled = level === 0;
                            Array.prototype.forEach.call(levelMenu.querySelectorAll("button"), function (b, i) {
                                if (i === level) b.setAttribute("aria-current", "true"); else b.removeAttribute("aria-current");
                            });
                            sizeGlobe();
                        }
                        function sizeGlobe() {
                            const r = globe().apparent;
                            overlay.style.setProperty("--globe-r", r.toFixed(1) + "px");
                            overlay.classList.toggle("loc-small-globe", r < 240); // see .loc-near
                        }

                        // Hide the Earth step's markers as they near the horizon (a name on the
                        // very edge would hang out over space) and while they are behind it.
                        function hideFarSide() {
                            if (level !== 0) return;
                            const c = map.getCenter(), rad = Math.PI / 180, edge = Math.max(globe().horizon + 0.04, 0.6);
                            globeMarks.forEach(function (m) {
                                const cos = Math.sin(c.lat * rad) * Math.sin(m.at[1] * rad) +
                                    Math.cos(c.lat * rad) * Math.cos(m.at[1] * rad) * Math.cos((m.at[0] - c.lng) * rad);
                                m.el.classList.toggle("loc-far", cos < edge);
                            });
                        }
                        map.on("move", hideFarSide);

                        // Fade the outlines to the given step: what leaves goes as the camera
                        // sets off, what arrives shows up as it settles.
                        const shown = {};
                        Object.keys(OUTLINES).forEach(function (id) { shown[id] = OUTLINES[id][1][START_LEVEL]; });
                        function showOutlines(lv, ms) {
                            Object.keys(OUTLINES).forEach(function (id) {
                                const prop = OUTLINES[id][0], to = OUTLINES[id][1][lv];
                                if (shown[id] === to) return;
                                const fade = !ms ? { duration: 0, delay: 0 }
                                    : to > shown[id] ? { duration: ms * 0.35, delay: ms * 0.6 }
                                        : { duration: Math.min(900, ms * 0.3), delay: 0 };
                                try {
                                    map.setPaintProperty(id, prop + "-transition", fade);
                                    map.setPaintProperty(id, prop, to);
                                    shown[id] = to;
                                } catch (e) { } // style still loading: synced on "style.load" below
                            });
                        }
                        map.once("style.load", function () { showOutlines(level, 0); });

                        // Flight time between two steps, ms (anything else: by distance).
                        const FLIGHT = { "0>1": 4600, "1>2": 2000, "2>3": 2200, "3>2": 1600, "2>1": 1600, "1>0": 3200 };
                        const easeInOut = function (t) { return 0.5 - Math.cos(Math.PI * t) / 2; };
                        let flight = 0, landTimer = 0;

                        function goLevel(next, opts) {
                            opts = opts || {};
                            if (flying || next < 0 || next >= LEVELS.length || (next === level && !opts.force)) return;
                            const from = level, view = viewFor(next);
                            closeCard();
                            clearHover();
                            level = next;
                            syncChrome();
                            clouds.stop();
                            setZoomRange(0);     // open the range for the trip; the step's own range is set on landing
                            setGestures(false);
                            const land = function () {
                                clearTimeout(landTimer);
                                flying = false;
                                overlay.classList.remove("loc-flying");
                                setZoomRange(level, view);
                                setGestures(true);
                                hideFarSide();
                                if (level === 3 && overlay.style.display !== "none") clouds.start();
                                map.once("idle", function () { if (!flying && level === next) warm(next + 1); });
                            };
                            if (opts.instant || reduceMotion) { showOutlines(level, 0); map.jumpTo(view); land(); return; }
                            const id = ++flight;
                            const ms = FLIGHT[from + ">" + next] || 1400 + 1100 * Math.abs(next - from);
                            showOutlines(level, ms);
                            const done = function () { if (id === flight && flying) land(); };
                            flying = true;
                            overlay.classList.add("loc-flying");
                            map.flyTo({ center: view.center, zoom: view.zoom, duration: ms, easing: easeInOut, essential: true });
                            // listen only now: flyTo first ends any move already under way, and that "moveend" is not ours
                            map.once("moveend", done);
                            landTimer = setTimeout(done, ms + 1500); // never get stuck mid-air
                        }

                        // ----- warm the next step -----
                        // Once a step has settled, fetch the satellite tiles of the next one in
                        // the background (they land in the browser cache), so the camera arrives
                        // on a sharp picture instead of a blurry one that sharpens afterwards.
                        const warmed = {};
                        function warm(lv) {
                            if (lv >= LEVELS.length || warmed[lv] || (navigator.connection && navigator.connection.saveData)) return;
                            warmed[lv] = true;
                            const v = viewFor(lv), s = size(), c = maplibregl.LngLat.convert(v.center);
                            const world = 512 * Math.pow(2, v.zoom);              // px across the whole map at that zoom
                            const z = Math.min(19, Math.floor(v.zoom) + 1);       // the tile level MapLibre shows there (256 px tiles)
                            const n = Math.pow(2, z), tile = world / n;
                            const sin = Math.sin(c.lat * Math.PI / 180);
                            const x = (c.lng + 180) / 360 * world;
                            const y = (0.5 - Math.log((1 + sin) / (1 - sin)) / (4 * Math.PI)) * world;
                            const urls = [];
                            for (let tx = Math.floor((x - s.w / 2) / tile); tx <= Math.floor((x + s.w / 2) / tile); tx++) {
                                for (let ty = Math.floor((y - s.h / 2) / tile); ty <= Math.floor((y + s.h / 2) / tile); ty++) {
                                    if (ty >= 0 && ty < n) urls.push(TILES.satellite.replace("{z}", z).replace("{x}", ((tx % n) + n) % n).replace("{y}", ty));
                                }
                            }
                            urls.slice(0, 48).forEach(function (u) { fetch(u, { priority: "low" }).catch(function () { }); });
                        }

                        // ----- the highlighted outlines are buttons too -----
                        const HIT = [
                            { layer: "country-fill", source: "country" },
                            { layer: "zone-fill", source: "zone" },
                            { layer: "district-fill", source: "district" },
                        ];
                        function hits(point) {
                            const h = HIT[level];
                            if (!h || !map.getLayer(h.layer)) return false;
                            try { return map.queryRenderedFeatures(point, { layers: [h.layer] }).length > 0; } catch (e) { return false; }
                        }
                        let hovered = null;
                        function setHover(source) {
                            if (hovered === source) return;
                            try {
                                if (hovered) map.setFeatureState({ source: hovered, id: 1 }, { hover: false });
                                if (source) map.setFeatureState({ source: source, id: 1 }, { hover: true });
                            } catch (e) { }
                            hovered = source;
                            map.getCanvas().style.cursor = source ? "pointer" : "";
                        }
                        function clearHover() { setHover(null); }
                        map.on("click", function (e) {
                            if (!flying && hits(pointOf(e))) goLevel(level + 1);
                        });
                        map.on("mousemove", function (e) {
                            if (flying) return;
                            const t = e.originalEvent && e.originalEvent.target;
                            if (t && t.closest && t.closest(".loc-mk")) return; // markers light their outline themselves
                            setHover(hits(e.point) ? HIT[level].source : null);
                        });
                        map.on("mouseout", clearHover);
                        [[countryEl, "country"], [zoneEl, "zone"], [projEl, "district"]].forEach(function (pair) {
                            pair[0].addEventListener("mouseenter", function () { if (!flying) setHover(pair[1]); });
                            pair[0].addEventListener("mouseleave", clearHover);
                        });

                        // ----- Earth: drag to turn the globe -----
                        // Our own handler rather than the map's: the globe keeps its size,
                        // can't be tipped over the poles, coasts a little, and works rotated.
                        (function globeDrag() {
                            const el = map.getCanvasContainer();
                            let active = false, pid = null, lx = 0, ly = 0, lt = 0, vx = 0, vy = 0, coasting = 0;
                            function turn(dx, dy) {
                                const c = map.getCenter(), r = globe().r, deg = 180 / Math.PI;
                                const lat = Math.max(-58, Math.min(68, c.lat + (dy / r) * deg));
                                const lng = c.lng - (dx / (r * Math.cos(c.lat * Math.PI / 180))) * deg;
                                map.jumpTo({ center: [lng, lat], zoom: globeZoom(lat) });
                            }
                            el.addEventListener("pointerdown", function (e) {
                                if (level !== 0 || flying || (e.pointerType === "mouse" && e.button !== 0)) return;
                                if (e.target.closest && e.target.closest(".loc-country")) return; // the chip is a button
                                active = true; pid = e.pointerId;
                                lx = e.clientX; ly = e.clientY; lt = performance.now(); vx = vy = 0;
                                cancelAnimationFrame(coasting);
                                try { el.setPointerCapture(pid); } catch (err) { }
                                el.classList.add("loc-grabbing");
                            });
                            el.addEventListener("pointermove", function (e) {
                                if (!active || e.pointerId !== pid) return;
                                const d = appDelta(e.clientX - lx, e.clientY - ly), now = performance.now(), dt = Math.max(1, now - lt);
                                lx = e.clientX; ly = e.clientY; lt = now;
                                vx = 0.6 * vx + 0.4 * (d[0] / dt); vy = 0.6 * vy + 0.4 * (d[1] / dt);
                                turn(d[0], d[1]);
                            });
                            function release(e) {
                                if (!active || e.pointerId !== pid) return;
                                active = false;
                                el.classList.remove("loc-grabbing");
                                try { el.releasePointerCapture(pid); } catch (err) { }
                                if (reduceMotion || performance.now() - lt > 90) return; // the finger rested first: no throw
                                let last = performance.now();
                                coasting = requestAnimationFrame(function coast(now) {
                                    const dt = Math.min(40, now - last); last = now;
                                    const k = Math.pow(0.94, dt / 16.7);
                                    vx *= k; vy *= k;
                                    if (level !== 0 || flying || active || Math.abs(vx) + Math.abs(vy) < 0.012) return;
                                    turn(vx * dt, vy * dt);
                                    coasting = requestAnimationFrame(coast);
                                });
                            }
                            el.addEventListener("pointerup", release);
                            el.addEventListener("pointercancel", release);
                        })();

                        // ----- rotated app: one-finger drag pans the map by hand -----
                        // appRoot's transform is rotate(90deg) translateY(-100%), so a content
                        // point (lx,ly) maps to screen (W-ly, lx). A finger move of screen
                        // (dx,dy) therefore shifts the touched content by (dy,-dx); panBy moves
                        // the view opposite that, so panBy([-dy, dx]) keeps the point under the
                        // finger — the correct, natural drag direction.
                        (function rotatedPan() {
                            let active = false, lastX = 0, lastY = 0;
                            mapEl.addEventListener("touchstart", function (e) {
                                active = rotated && level > 0 && !flying && e.touches.length === 1;
                                if (active) { lastX = e.touches[0].clientX; lastY = e.touches[0].clientY; }
                            }, { passive: true });
                            window.addEventListener("touchmove", function (e) {
                                if (!active || !rotated) return;
                                if (e.touches.length !== 1) { active = false; return; }
                                const dx = e.touches[0].clientX - lastX, dy = e.touches[0].clientY - lastY;
                                lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
                                map.panBy([-dy, dx], { animate: false });
                            }, { passive: true });
                            window.addEventListener("touchend", function () { active = false; });
                            window.addEventListener("touchcancel", function () { active = false; });
                        })();

                        // ----- right-edge controls -----
                        document.getElementById("locZoomIn").addEventListener("click", function () { if (!flying) map.zoomIn(); });
                        document.getElementById("locZoomOut").addEventListener("click", function () { if (!flying) map.zoomOut(); });
                        document.getElementById("locReset").addEventListener("click", function () {
                            if (flying) return;
                            closeCard();
                            const view = viewFor(level); // framed afresh: the screen may have changed since we landed
                            setZoomRange(level, view);
                            map.easeTo(Object.assign({ duration: reduceMotion ? 0 : 800 }, view));
                        });

                        // ----- street lines + names -----
                        let labelIds = [];
                        function addStreets() {
                            const ctl = window.AbortController ? new AbortController() : null;
                            const timer = setTimeout(function () { if (ctl) ctl.abort(); }, 8000);
                            fetch(TILES.streets, ctl ? { signal: ctl.signal } : undefined)
                                .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
                                .then(function (tj) {
                                    clearTimeout(timer);
                                    if (!tj.tiles || !tj.tiles.length) throw new Error("no tiles in TileJSON");
                                    // Arabic names need shaping; the plugin is only fetched when one is drawn.
                                    try {
                                        if (maplibregl.getRTLTextPluginStatus() === "unavailable") {
                                            const p = maplibregl.setRTLTextPlugin(TILES.rtlText, true);
                                            if (p && p.catch) p.catch(function () { });
                                        }
                                    } catch (e) { }
                                    map.addSource("streets", { type: "vector", tiles: tj.tiles, minzoom: tj.minzoom || 0, maxzoom: tj.maxzoom || 14 });
                                    const s = streetLayers();
                                    s.lines.forEach(function (l) { map.addLayer(l, "zone-glow"); });
                                    s.labels.forEach(function (l) { map.addLayer(l); });
                                    labelIds = s.labels.map(function (l) { return l.id; });
                                })
                                .catch(function (err) {
                                    clearTimeout(timer);
                                    console.warn("[map] street names:", err && err.message);
                                    if (map.getSource("streets")) return; // the tiles are in; only a layer was refused
                                    TILES.labelsBackup.forEach(function (url, i) {
                                        map.addSource("labels-backup-" + i, { type: "raster", tiles: [url], tileSize: 256, maxzoom: 18 });
                                        map.addLayer({ id: "labels-backup-" + i, type: "raster", source: "labels-backup-" + i, minzoom: 7 }, "zone-glow");
                                    });
                                });
                        }
                        map.once("style.load", addStreets);
                        document.addEventListener("i18n:change", function () {
                            labelIds.forEach(function (id) {
                                if (map.getLayer(id)) map.setLayoutProperty(id, "text-field", nameField(siteLang()));
                            });
                        });

                        // ----- routing state -----
                        let current = null;        // selected destination
                        let lastRoute = null;      // { distance(m), duration(s) }
                        let popup = null;          // destination card

                        function setData(source, features) {
                            const s = map.getSource(source);
                            if (s) s.setData({ type: "FeatureCollection", features: features });
                        }
                        function lineFeature(coords) {
                            return { type: "Feature", properties: {}, geometry: { type: "LineString", coordinates: coords } };
                        }
                        function clearRoute() {
                            setData("route", []);
                            setData("route-leads", []);
                            setData("route-nodes", []);
                        }

                        function setActivePin(d) {
                            document.querySelectorAll("#locMap .loc-pin").forEach(function (el) { el.classList.remove("loc-active"); });
                            if (d && d._pin) d._pin.classList.add("loc-active");
                        }

                        function haversine(a, b) {
                            const R = 6371000, toRad = Math.PI / 180;
                            const dLat = (b.lat - a.lat) * toRad, dLng = (b.lng - a.lng) * toRad;
                            const la1 = a.lat * toRad, la2 = b.lat * toRad;
                            const h = Math.sin(dLat / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin(dLng / 2) ** 2;
                            return 2 * R * Math.asin(Math.sqrt(h));
                        }

                        function fmtKm(m) { return (m / 1000).toFixed(1) + " km"; }
                        function fmtMin(s) {
                            const min = Math.max(1, Math.round(s / 60));
                            if (min < 60) return min + " min";
                            const h = Math.floor(min / 60), r = min % 60;
                            return h + " h" + (r ? " " + r + "m" : "");
                        }

                        // Re-render the card with the fetched distance / time. The stats are
                        // baked into the HTML (not patched into the DOM) so the card is always
                        // rebuilt from one place.
                        function renderStats() {
                            if (!lastRoute || !current || !popup) return;
                            popup.setHTML(cardHtml(current));
                        }

                        // Frame the route (or, before it arrives, the two ends), leaving room
                        // for the card.
                        function fitRoute(coords, dest) {
                            const b = boundsOf(coords.concat([[OC.lng, OC.lat], [dest.lng, dest.lat]]));
                            map.fitBounds(b, { padding: routePad(), duration: reduceMotion ? 0 : 800, maxZoom: 16 });
                        }

                        // coords: [lng, lat] pairs along the road.
                        function drawRoute(coords, dest) {
                            setData("route", [lineFeature(coords)]);
                            // OSRM snaps both ends to the nearest road, so tie the pins to the
                            // road with dotted lead-ins.
                            setData("route-leads", [
                                lineFeature([[OC.lng, OC.lat], coords[0]]),
                                lineFeature([coords[coords.length - 1], [dest.lng, dest.lat]]),
                            ]);
                            const nodes = [], NODES = Math.min(6, coords.length);
                            for (let i = 0; i < NODES; i++) {
                                const idx = Math.round((coords.length - 1) * (i / Math.max(1, NODES - 1)));
                                nodes.push({ type: "Feature", properties: {}, geometry: { type: "Point", coordinates: coords[idx] } });
                            }
                            setData("route-nodes", nodes);
                            fitRoute(coords, dest);
                        }

                        // Destination card, anchored above the pin as a map popup.
                        function cardHtml(d) {
                            const ready = !!(lastRoute && current === d);
                            const banner = d.img
                                ? '<img class="loc-pop-img" src="' + d.img + '" alt="" />'
                                : '<div class="loc-pop-img loc-pop-img-ph">' + (ICONS[d.icon] || ICONS.pin) + "</div>";
                            return (
                                '<div class="loc-pop-card">' + banner +
                                '<div class="loc-pop-body">' +
                                '<div class="loc-pop-ico">' + (ICONS[d.icon] || ICONS.pin) + "</div>" +
                                '<div class="loc-pop-main">' +
                                '<div class="loc-pop-title">' + d.name + "<small>" + d.en + "</small></div>" +
                                '<div class="loc-pop-chips">' +
                                '<span class="loc-pop-chip"><svg viewBox="0 0 24 24"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg><b class="' + (ready ? "" : "loc-loading") + '">' + (ready ? fmtKm(lastRoute.distance) : "…") + "</b></span>" +
                                '<span class="loc-pop-chip"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><b class="' + (ready ? "" : "loc-loading") + '">' + (ready ? fmtMin(lastRoute.duration) : "…") + "</b></span>" +
                                "</div>" +
                                "</div>" +
                                "</div>" +
                                (d.desc ? '<p class="loc-pop-desc">' + d.desc + "</p>" : "") +
                                "</div>"
                            );
                        }

                        function closeCard() {
                            if (popup && popup.isOpen()) popup.remove(); // fires "close" → the route goes too
                        }

                        function selectDest(d) {
                            if (level !== 3 || flying) return;
                            current = d;
                            lastRoute = null; // stats belong to the previous destination
                            setActivePin(d);
                            clearRoute();
                            if (!popup) {
                                popup = new maplibregl.Popup({
                                    className: "loc-pop", closeButton: true, closeOnClick: true, focusAfterOpen: false,
                                    anchor: "bottom", offset: 26, maxWidth: "300px",
                                });
                                // Closing the card (× or tapping the map) clears the route too.
                                popup.on("close", function () {
                                    clearRoute();
                                    setActivePin(null);
                                    current = null;
                                    overlay.classList.remove("loc-card-open");
                                    if (hint) hint.style.opacity = "";
                                });
                            }
                            popup.setLngLat([d.lng, d.lat]).setHTML(cardHtml(d));
                            if (!popup.isOpen()) popup.addTo(map); // (re-adding an open popup would fire "close")
                            overlay.classList.add("loc-card-open");
                            if (hint) hint.style.opacity = "0";
                            fitRoute([], d); // the card must be in view while the route is on its way

                            const url = OSRM + OC.lng + "," + OC.lat + ";" + d.lng + "," + d.lat +
                                "?overview=full&geometries=geojson";

                            fetch(url)
                                .then(function (r) { return r.json(); })
                                .then(function (json) {
                                    if (current !== d) return; // a newer click won
                                    if (!json.routes || !json.routes.length) throw new Error("no route");
                                    const route = json.routes[0];
                                    lastRoute = { distance: route.distance, duration: route.duration };
                                    drawRoute(route.geometry.coordinates, d);
                                    renderStats();
                                })
                                .catch(function () {
                                    if (current !== d) return;
                                    // Fallback: straight line + estimated road distance.
                                    const straight = haversine(OC, d);
                                    lastRoute = { distance: straight * 1.3, duration: (straight * 1.3 / 1000) / 50 * 3600 };
                                    drawRoute([[OC.lng, OC.lat], [d.lng, d.lat]], d);
                                    renderStats();
                                });
                        }

                        // ----- sizing -----
                        map.on("resize", function () {
                            if (!mapEl.clientWidth) return; // overlay hidden behind the 360 viewer
                            paintStars();
                            sizeGlobe();
                            layoutPins();
                            if (level === 0 && !flying) map.jumpTo({ zoom: globeZoom(map.getCenter().lat) }); // same globe, new screen
                        });
                        window.addEventListener("resize", function () {
                            // the orientation controller announces a rotated / upright app with a resize event
                            setRotated(document.body.classList.contains("ui-rotated"));
                            setTimeout(function () { map.resize(); }, 200);
                        });
                        setTimeout(function () { map.resize(); }, 300);

                        // The Location launcher brings the overlay back on the project step.
                        reopen = function () {
                            try { map.resize(); } catch (e) { }
                            if (flying) return;
                            if (level !== 3) goLevel(3, { instant: true });
                            else clouds.start();
                        };

                        // ----- first view -----
                        paintStars();
                        layoutPins();
                        goLevel(START_LEVEL, { instant: true, force: true });
                        // Fade the map in once its first tiles are on screen (or after a moment, regardless).
                        const ready = function () { overlay.classList.add("loc-ready"); };
                        map.once("idle", ready);
                        setTimeout(ready, 2500);

                        // Handy from the console: maazarMap.goLevel(2), maazarMap.map.getZoom() …
                        window.maazarMap = { map: map, goLevel: goLevel };
                    }
                }

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", start);
                } else {
                    start();
                }
            })();
        </script>
    </div>
    <!-- /#appRoot -->

    <!-- ============================================================
         ORIENTATION CONTROLLER — landscape / portrait for small screens
         Shows the chooser on every load. On selection it goes fullscreen and
         locks the native screen orientation (Android); if that's unavailable
         (e.g. iOS) it falls back to rotating #appRoot 90deg via CSS.
    ============================================================= -->
    <script>
        (function () {
            var SMALL_MAX = 600; // shorter viewport side (px) treated as a phone

            var body = document.body;
            var chooser = document.getElementById("orientChooser");
            var toggleBtn = document.getElementById("orientToggle");
            var toggleLabel = document.getElementById("orientToggleLabel");

            var mode = null;        // 'portrait' | 'landscape' | null (not chosen)
            var selfResize = false; // guard so our synthetic resize doesn't recurse

            function shorterSide() {
                return Math.min(window.innerWidth, window.innerHeight);
            }
            function isSmallScreen() {
                var coarse =
                    window.matchMedia && window.matchMedia("(pointer: coarse)").matches;
                return !!coarse && shorterSide() <= SMALL_MAX;
            }
            function physicalOrientation() {
                return window.innerHeight >= window.innerWidth ? "portrait" : "landscape";
            }

            // Force the 360 canvas (and other resize-driven layout) to recompute for
            // the new layout box after we toggle rotation. Reuse the existing window
            // "resize" listeners, guarded so we don't re-enter apply().
            function syncLayout() {
                requestAnimationFrame(function () {
                    selfResize = true;
                    try {
                        window.dispatchEvent(new Event("resize"));
                    } catch (e) { }
                    selfResize = false;
                });
            }

            function apply() {
                var small = isSmallScreen();
                body.classList.toggle("small-ui", small);

                if (!small) {
                    // Desktop / large screens: never rotate, never show the meta UI.
                    body.classList.remove(
                        "ui-rotated",
                        "ui-mode-portrait",
                        "ui-mode-landscape"
                    );
                    chooser.classList.remove("show");
                    syncLayout();
                    return;
                }

                if (!mode) {
                    // No choice yet: show the chooser, keep the app upright behind it.
                    chooser.classList.add("show");
                    body.classList.remove("ui-rotated");
                    syncLayout();
                    return;
                }

                chooser.classList.remove("show");
                body.classList.toggle("ui-mode-portrait", mode === "portrait");
                body.classList.toggle("ui-mode-landscape", mode === "landscape");

                // CSS-rotate when landscape is wanted on an upright phone.
                var rotated =
                    mode === "landscape" && physicalOrientation() === "portrait";
                body.classList.toggle("ui-rotated", rotated);

                // The location map reads raw (rotated) screen coords too: it picks the
                // new state up from the resize event syncLayout() dispatches below and
                // swaps to its own remapped drag (see the map script).

                if (toggleLabel) {
                    toggleLabel.textContent =
                        mode === "portrait" ? "Landscape" : "Portrait";
                }
                syncLayout();
            }

            function setMode(next) {
                mode = next;
                apply();
            }

            // Wire up the chooser buttons.
            if (chooser) {
                var opts = chooser.querySelectorAll(".orient-opt");
                for (var i = 0; i < opts.length; i++) {
                    (function (btn) {
                        btn.addEventListener("click", function () {
                            setMode(btn.getAttribute("data-mode"));
                        });
                    })(opts[i]);
                }
            }

            // The toggle flips between the two modes.
            if (toggleBtn) {
                toggleBtn.addEventListener("click", function () {
                    setMode(mode === "landscape" ? "portrait" : "landscape");
                });
            }

            // Note: the choice is intentionally NOT remembered — the chooser is
            // shown on every page load.

            // Re-evaluate on device rotation / viewport changes (ignore our own).
            window.addEventListener("resize", function () {
                if (selfResize) return;
                apply();
            });
            window.addEventListener("orientationchange", apply);

            apply();
        })();
    </script>

    <!-- ===================== ELEGANT HEADER — wiring ===================== -->
    <script>
        (function () {
            var header = document.getElementById("ocHeader");
            if (!header) return;

            // Keep header touches away from the window-level panorama drag handlers
            // so a tap is never swallowed by preventDefault (notably in landscape).
            ["touchstart", "mousedown", "pointerdown"].forEach(function (evt) {
                header.addEventListener(evt, function (e) { e.stopPropagation(); }, { passive: true });
            });

            function click(sel) {
                var el = document.querySelector(sel);
                if (el) el.click();
            }
            function clickFloor(scene) {
                var b = document.querySelector('#floorMenu .floor-menu-btn[data-scene="' + scene + '"]');
                if (b) b.click();
            }
            var burger = document.getElementById("ochBurger");
            function setMenu(open) {
                header.classList.toggle("open", open);
                // Toggling this body class fades out the floating launchers so the
                // open menu stays clean (see the mobile stylesheet).
                document.body.classList.toggle("header-menu-open", open);
                if (burger) burger.setAttribute("aria-expanded", open ? "true" : "false");
                if (!open) { header.classList.remove("open"); }
            }
            function closeMobile() { setMenu(false); }

            /* ---- Mobile hamburger ---- */
            if (burger) {
                burger.addEventListener("click", function (e) {
                    e.stopPropagation();
                    setMenu(!header.classList.contains("open"));
                });
            }
            document.addEventListener("click", function (e) {
                if (!header.contains(e.target)) closeMobile();
            });

            /* ---- Floors dropdown ---- */
            var floors = document.getElementById("ochFloors");
            var floorsBtn = document.getElementById("ochFloorsBtn");
            if (floorsBtn) {
                floorsBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    var open = floors.classList.toggle("open");
                    floorsBtn.setAttribute("aria-expanded", open ? "true" : "false");
                });
            }
            document.addEventListener("click", function (e) {
                if (floors && !floors.contains(e.target)) floors.classList.remove("open");
            });
            /* Prototype items set the unit-type filter (single select). The
               Unit Search panel owns the filter state; we just drive it. */
            document.querySelectorAll("#ochFloors .och-dd-item").forEach(function (it) {
                it.addEventListener("click", function () {
                    if (typeof window.setUnitTypeFilter === "function") window.setUnitTypeFilter(it.dataset.type || "");
                    floors.classList.remove("open");
                    closeMobile();
                });
            });

            /* The highlight is already painted by the filter — this just takes you
               to the view where it reads. enter() no-ops if 3D is already open. */
            var proto3D = document.getElementById("ochProto3D");
            if (proto3D) proto3D.addEventListener("click", function () {
                floors.classList.remove("open");
                closeMobile();
                if (window.viewer3D && !window.viewer3D.active) window.viewer3D.enter();
                else if (!window.viewer3D) click("#mode3DToggle");
            });

            /* Mirror the current type filter into the Prototype label + items.
               Called from the Unit Search panel whenever its state syncs. */
            window.syncHeaderPrototype = function () {
                var types = (typeof TABLE_FILTERS !== "undefined" && TABLE_FILTERS.types) || [];
                var lbl = document.getElementById("ochFloorsLabel");
                if (floorsBtn) floorsBtn.classList.toggle("active", types.length > 0);
                document.querySelectorAll("#ochFloors .och-dd-item").forEach(function (it) {
                    var t = it.dataset.type || "";
                    it.classList.toggle("active", t === "" ? types.length === 0 : types.indexOf(t) !== -1);
                });
                if (lbl) lbl.textContent = types.length === 1 ? types[0] : "Prototype";
            };

            /* ---- Simple nav actions (reuse the existing launchers) ---- */
            function on(id, fn) {
                var el = document.getElementById(id);
                if (el) el.addEventListener("click", function () { fn(); closeMobile(); });
            }
            on("ochUnits", function () {
                if (typeof window.toggleUnitSearch === "function") window.toggleUnitSearch();
                else click("#unitsTableToggle");
            });
            on("ochCompare", function () { click("#compareToggle"); });
            on("ochGallery", function () { click("#galleryToggle"); });
            on("ochLang", function () { click("#langToggle"); });
            on("ochTut", function () { click("#tutLauncher"); });
            on("ochOrient", function () { click("#orientToggle"); });
            on("ochEye", function () { click("#hideUnitsToggle"); });
            on("och3D", function () { click("#mode3DToggle"); });

            /* ---- Mirror the hide-units / 3D state into the header buttons.
               The original pills stay the source of truth; we just watch their
               class list and reflect it (icon swap, tint, label, aria). ---- */
            function mirrorToggle(srcId, btnId, lblId, stateClass, onText, offText) {
                var src = document.getElementById(srcId);
                var btn = document.getElementById(btnId);
                if (!src || !btn) return;
                var lbl = document.getElementById(lblId);
                function sync() {
                    var on = src.classList.contains(stateClass);
                    btn.classList.toggle(stateClass, on);
                    btn.setAttribute("aria-pressed", on ? "true" : "false");
                    var text = on ? onText : offText;
                    if (typeof text === "function") text = text(src);
                    btn.title = text;
                    if (lbl) lbl.textContent = text;
                }
                new MutationObserver(sync).observe(src, {
                    attributes: true, attributeFilter: ["class", "data-noun"],
                });
                sync();
            }
            // The pill says what the 3D overlay carries (data-noun: units or floors).
            function overlayNoun(src) { return src.dataset.noun === "floors" ? "floors" : "units"; }
            mirrorToggle("hideUnitsToggle", "ochEye", "ochEyeLabel", "is-hidden",
                function (src) { return "Show " + overlayNoun(src); }, function (src) { return "Hide " + overlayNoun(src); });
            mirrorToggle("mode3DToggle", "och3D", "och3DLabel", "active", "Exit 3D", "3D View");

            // "Surrounding" re-opens the existing project-location map launcher.
            on("ochSurround", function () { click("#locLauncher"); });

            // Home — return to the exterior view and close any open panels.
            function closeIfOpen(panelSel, closeSel) {
                var p = document.querySelector(panelSel);
                if (p && (p.classList.contains("show") || p.classList.contains("open"))) {
                    var c = document.querySelector(closeSel);
                    if (c) c.click();
                }
            }
            on("ochHome", function () {
                closeIfOpen("#unitsTableDrawer", "#closeUnitsTable");
                closeIfOpen("#compareDrawer", "#closeCompare");
                closeIfOpen("#galleryOverlay", "#galleryCloseX");
                clickFloor("exterior");
            });

            /* ---- View-mode segment (Day / Night) ---- */
            document.querySelectorAll(".och-seg-btn").forEach(function (b) {
                b.addEventListener("click", function () { clickFloor(b.dataset.scene); });
            });

            /* ---- Keep active states in sync with the real scene state ---- */
            function syncActive() {
                var active = document.querySelector("#floorMenu .floor-menu-btn.active");
                var scene = active ? active.dataset.scene : null;
                // Prototype (type filter) state is synced separately — see syncHeaderPrototype.

                document.querySelectorAll(".och-seg-btn").forEach(function (b) {
                    b.classList.toggle("active", b.dataset.scene === scene);
                });

                var home = document.getElementById("ochHome");
                if (home) home.classList.toggle("active", scene === "exterior");
            }
            var fm = document.getElementById("floorMenu");
            if (fm) {
                new MutationObserver(syncActive).observe(fm, {
                    attributes: true, subtree: true, attributeFilter: ["class"],
                });
            }
            setTimeout(syncActive, 600);
            setTimeout(syncActive, 1800);

            /* ---- Compare count badge mirror ---- */
            function syncCompare() {
                var src = document.getElementById("compareCount");
                var n = src ? parseInt(src.textContent, 10) || 0 : 0;
                var badge = document.getElementById("ochCompareCount");
                if (badge) {
                    badge.textContent = n;
                    badge.setAttribute("data-empty", n > 0 ? "0" : "1");
                }
            }
            var cc = document.getElementById("compareCount");
            if (cc) {
                new MutationObserver(syncCompare).observe(cc, {
                    childList: true, characterData: true, subtree: true,
                });
            }
            syncCompare();

            /* ---- Mirror the language toggle label into the header button ---- */
            function syncLang() {
                var src = document.getElementById("langToggleLabel");
                var dst = document.getElementById("ochLangLabel");
                if (src && dst) dst.textContent = src.textContent;
            }
            var lt = document.getElementById("langToggleLabel");
            if (lt) {
                new MutationObserver(syncLang).observe(lt, {
                    childList: true, characterData: true, subtree: true,
                });
            }
            syncLang();
        })();
    </script>

    <!-- ===================== UNIT SEARCH PANEL — wiring ===================== -->
    <script>
        (function () {
            var panel = document.getElementById("unitSearchPanel");
            var listPanel = document.getElementById("unitListPanel");
            if (!panel) return;

            // Keep panel gestures away from the panorama drag handlers.
            ["touchstart", "mousedown", "pointerdown"].forEach(function (evt) {
                panel.addEventListener(evt, function (e) { e.stopPropagation(); }, { passive: true });
                if (listPanel) listPanel.addEventListener(evt, function (e) { e.stopPropagation(); }, { passive: true });
            });

            function byId(id) { return document.getElementById(id); }
            function esc(s) {
                return String(s == null ? "" : s)
                    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
            }

            // [normalizedFloorKey, shortLabel, sceneKey]
            // Al Maazar: basement (parking), ground, first, second, roof. No
            // per-floor orbits are rendered yet, so every floor stays on the
            // exterior scene; swap the third column once floor scenes exist.
            // …this project's floors (projects.js), bottom-up.
            var FLOORS = ((window.MAAZAR_PROJECT && window.MAAZAR_PROJECT.floors) || []).map(function (f) { return [String(f.key), f.label || f.name || String(f.key), "exterior"]; });
            if (!FLOORS.length) FLOORS = [
                ["LG", "Basement", "exterior"],
                ["GF", "Ground", "exterior"],
                ["1", "1st", "exterior"],
                ["2", "2nd", "exterior"],
                ["RF", "Roof", "exterior"],
            ];
            function sceneForFloor(key) {
                for (var i = 0; i < FLOORS.length; i++) if (FLOORS[i][0] === key) return FLOORS[i][2];
                return "exterior";
            }
            // Where a floor leads from the CURRENT scene. On a floor plan (a still scene) a floor with a
            // plan of its own opens that plan, any other floor — or "all" — goes back to the building view;
            // on the building the chips stay filters (sceneForFloor: the exterior orbit).
            function sceneForFloorNow(key) {
                var S = (typeof SCENES !== "undefined") ? SCENES : null;
                var cur = S && typeof currentScene !== "undefined" ? S[currentScene] : null;
                var plan = key && S && typeof floorSceneFor === "function" ? floorSceneFor(key) : "";
                if (cur && cur.still) {
                    return plan || (typeof window.buildingScene === "function" ? window.buildingScene() : "exterior");
                }
                // A plan that says so (projects.js scenes.<x>.openFromFilter — the basement, which has no volume on the
                // building to click) opens from the building view too; the other floors' chips stay filters there.
                if (plan && S[plan] && S[plan].openFromFilter) return plan;
                return key === "" ? "exterior" : sceneForFloor(key);
            }

            function TF() { return (typeof TABLE_FILTERS !== "undefined") ? TABLE_FILTERS : {}; }
            function UNITS() { return (typeof allUnits !== "undefined" && Array.isArray(allUnits)) ? allUnits : []; }
            function areaOf(u) {
                if (typeof getAreaNumber === "function") return getAreaNumber(u);
                return Number(String(u.area || "").replace(/[^\d.]/g, "")) || 0;
            }
            function money(v) {
                if (typeof formatPriceShort === "function") return formatPriceShort(v);
                v = Number(v) || 0;
                if (v >= 1e6) return (v / 1e6).toFixed(v % 1e6 ? 1 : 0) + "M";
                if (v >= 1e3) return Math.round(v / 1e3) + "K";
                return String(Math.round(v));
            }
            function filtered() {
                return (typeof getFilteredTableUnits === "function") ? getFilteredTableUnits() : UNITS();
            }

            /* ---------- prototype scope ----------
               The prototype (type) filter is the outer scope: every other filter —
               floors, availability, surface, budget — only ranges over the units of
               the selected prototype. No prototype selected = the whole project. */
            function scopeUnits() {
                var types = TF().types || [];
                if (!types.length) return UNITS();
                return UNITS().filter(function (u) {
                    return types.indexOf(String(u.type || "").trim()) !== -1;
                });
            }

            /* Called whenever the prototype changes: drop selections the new scope
               can't honour, forget the old surface/budget range, and rebuild the
               chips + slider bounds around the new set. */
            function rescope() {
                var tf = TF(), scope = scopeUnits();
                var floorIn = {}, statusIn = {};
                scope.forEach(function (u) {
                    floorIn[u.floor] = true;
                    statusIn[String(u.status || "")] = true;
                });
                if (tf.floor && !floorIn[tf.floor]) { tf.floor = ""; goScene("exterior"); }
                if (tf.statuses && tf.statuses.length) {
                    tf.statuses = tf.statuses.filter(function (st) { return statusIn[st]; });
                }
                // The new prototype has its own min/max, so the sliders start wide open — and its own
                // rooms & features chips, so that selection starts empty too.
                tf.minArea = ""; tf.maxArea = ""; tf.minPrice = ""; tf.maxPrice = "";
                tf.features = {};
                buildDynamic();
            }

            var boundsReady = false, chipsSig = "", scopeSig = "", raf = null;

            // Heavy work (3D repaint + optional table rebuild) coalesced to one frame.
            function commitHeavy() {
                if (raf) return;
                raf = requestAnimationFrame(function () {
                    raf = null;
                    if (typeof applyThreeUnitsFromSheet === "function") applyThreeUnitsFromSheet();
                    if (typeof renderUnitsTable === "function") renderUnitsTable(); // self-guards when drawer closed
                });
            }
            function applyFilters() { syncStates(); updateCount(); commitHeavy(); }
            function updateCount() {
                var n = filtered().length;
                var a = byId("uspCount"); if (a) a.textContent = n;
                var b = byId("ulpCount"); if (b) b.textContent = n;
            }

            /* ---------- dual-range controllers (start + end thumbs) ---------- */
            function setupDual(cfg) {
                function pct(inp) {
                    var mn = +inp.min, mx = +inp.max;
                    return mx > mn ? ((+inp.value - mn) / (mx - mn)) * 100 : 0;
                }
                function refreshUI() {
                    cfg.fill.style.left = pct(cfg.minI) + "%";
                    cfg.fill.style.right = (100 - pct(cfg.maxI)) + "%";
                    if (cfg.minV) cfg.minV.textContent = cfg.fmt(+cfg.minI.value);
                    if (cfg.maxV) cfg.maxV.textContent = cfg.fmt(+cfg.maxI.value);
                }
                function onMin(kind) {
                    if (+cfg.minI.value > +cfg.maxI.value) cfg.minI.value = cfg.maxI.value;
                    TF()[cfg.keyMin] = (+cfg.minI.value <= +cfg.minI.min) ? "" : String(cfg.minI.value);
                    refreshUI();
                    if (kind === "change") applyFilters(); else updateCount();
                }
                function onMax(kind) {
                    if (+cfg.maxI.value < +cfg.minI.value) cfg.maxI.value = cfg.minI.value;
                    TF()[cfg.keyMax] = (+cfg.maxI.value >= +cfg.maxI.max) ? "" : String(cfg.maxI.value);
                    refreshUI();
                    if (kind === "change") applyFilters(); else updateCount();
                }
                cfg.minI.addEventListener("input", function () { onMin("input"); });
                cfg.minI.addEventListener("change", function () { onMin("change"); });
                cfg.maxI.addEventListener("input", function () { onMax("input"); });
                cfg.maxI.addEventListener("change", function () { onMax("change"); });
                [cfg.minI, cfg.maxI].forEach(function (inp) {
                    inp.addEventListener("pointerdown", function () {
                        cfg.minI.style.zIndex = 3; cfg.maxI.style.zIndex = 3; inp.style.zIndex = 5;
                    });
                });
                cfg.refreshUI = refreshUI;
                cfg.setBounds = function (mn, mx) {
                    if (mx <= mn) mx = mn + 1;
                    [cfg.minI, cfg.maxI].forEach(function (inp) {
                        // "any" so a thumb can sit on an exact data value (e.g. 25.5 m²)
                        // instead of being rounded to a synthetic step.
                        inp.min = mn; inp.max = mx; inp.step = "any";
                    });
                    if (!TF()[cfg.keyMin]) cfg.minI.value = mn;
                    if (!TF()[cfg.keyMax]) cfg.maxI.value = mx;
                    if (cfg.sMin) cfg.sMin.textContent = cfg.fmt(mn);
                    if (cfg.sMax) cfg.sMax.textContent = cfg.fmt(mx);
                    refreshUI();
                };

                /* ---- Steppers: walk a thumb through the real data values ----
                   cfg.values is the sorted, de-duplicated list of areas / prices
                   present in the sheet, so each click lands on an actual unit's
                   number rather than an arbitrary slider position. */
                cfg.values = [];
                cfg.setValues = function (arr) {
                    cfg.values = arr.slice().sort(function (a, b) { return a - b; })
                        .filter(function (v, i, a) { return i === 0 || v !== a[i - 1]; });
                };
                function stepThumb(which, dir) {
                    if (!cfg.values.length) return;
                    var isMin = which === "min";
                    var inp = isMin ? cfg.minI : cfg.maxI;
                    var cur = +inp.value, next = null;
                    // Hard stop: min can't pass the max thumb and vice versa.
                    var lo = isMin ? +inp.min : +cfg.minI.value;
                    var hi = isMin ? +cfg.maxI.value : +inp.max;
                    if (dir > 0) {
                        for (var i = 0; i < cfg.values.length; i++) {
                            if (cfg.values[i] > cur + 1e-9 && cfg.values[i] <= hi) { next = cfg.values[i]; break; }
                        }
                    } else {
                        for (var j = cfg.values.length - 1; j >= 0; j--) {
                            if (cfg.values[j] < cur - 1e-9 && cfg.values[j] >= lo) { next = cfg.values[j]; break; }
                        }
                    }
                    if (next == null) return;
                    inp.value = next;
                    if (isMin) onMin("change"); else onMax("change");
                }
                var row = cfg.minI.closest(".usp-range");
                if (row) {
                    row.querySelectorAll(".usp-step").forEach(function (grp) {
                        grp.querySelectorAll(".usp-step-btn").forEach(function (b) {
                            b.addEventListener("click", function () { stepThumb(grp.dataset.thumb, +b.dataset.dir); });
                        });
                    });
                }
                return cfg;
            }

            var areaDual = setupDual({
                minI: byId("uspAreaMin"), maxI: byId("uspAreaMax"), fill: byId("uspAreaFill"),
                minV: byId("uspAreaMinV"), maxV: byId("uspAreaMaxV"),
                sMin: byId("uspAreaScaleMin"), sMax: byId("uspAreaScaleMax"),
                keyMin: "minArea", keyMax: "maxArea",
                fmt: function (v) { return String(Math.round(v)); },
            });
            var budgetDual = setupDual({
                minI: byId("uspBudgetMin"), maxI: byId("uspBudgetMax"), fill: byId("uspBudgetFill"),
                minV: byId("uspBudgetMinV"), maxV: byId("uspBudgetMaxV"),
                sMin: byId("uspBudgetScaleMin"), sMax: byId("uspBudgetScaleMax"),
                keyMin: "minPrice", keyMax: "maxPrice",
                fmt: money,
            });

            /* ---------- rooms & features chips (UNIT_FEATURES — SQL section 9) ----------
               Built from the data of the current scope: a Facing / count group lists the values its
               units have (counts from 1 up, when there is more than one — or one value next to units
               without), and a yes / no feature becomes a chip of the "Features" group when some units
               have it and some do not (a chip every unit passes would filter nothing). A project whose
               rows carry none of these (Khawalid 20) gets no such section at all. */
            var featureSig = "";
            function buildFeatureSections(scope) {
                var wrap = byId("uspFeatureSecs");
                if (!wrap || typeof UNIT_FEATURES === "undefined") return;
                var groups = [], flags = [];
                UNIT_FEATURES.forEach(function (f) {
                    var vals = {}, yes = 0, no = 0;
                    scope.forEach(function (u) {
                        var v = u.features ? u.features[f.key] : null;
                        if (v === null || v === undefined) return;
                        if (f.kind === "bool") { if (v) yes++; else no++; }
                        else if (f.kind === "count") { if (v >= 1) vals[String(v)] = 1; else no++; }
                        else vals[String(v)] = 1;
                    });
                    if (f.kind === "bool") { if (yes && no) flags.push(f); return; }
                    var keys = Object.keys(vals);
                    if (f.kind === "choice") keys.sort(function (a, b) { return (f.values || []).indexOf(a) - (f.values || []).indexOf(b); });
                    else keys.sort(function (a, b) { return Number(a) - Number(b); });
                    if (keys.length >= 2 || (keys.length === 1 && no)) groups.push({ f: f, values: keys });
                });
                var sig = groups.map(function (g) { return g.f.key + ":" + g.values.join(","); }).join("|") + "##" + flags.map(function (f) { return f.key; }).join(",");
                if (sig === featureSig) return;
                featureSig = sig;
                var html = groups.map(function (g) {
                    return '<section class="usp-sec"><div class="usp-sec-h">' + esc(g.f.label) + '</div><div class="usp-chips">' +
                        g.values.map(function (v) {
                            return '<button type="button" class="usp-chip" data-fkey="' + esc(g.f.key) + '" data-fval="' + esc(v) + '">' + esc(v) + "</button>";
                        }).join("") + "</div></section>";
                }).join("");
                if (flags.length) {
                    html += '<section class="usp-sec"><div class="usp-sec-h">Features</div><div class="usp-chips">' +
                        flags.map(function (f) {
                            return '<button type="button" class="usp-chip" data-fkey="' + esc(f.key) + '" data-fhas="1">' + esc(f.label) + "</button>";
                        }).join("") + "</div></section>";
                }
                wrap.innerHTML = html;
            }

            /* ---------- build dynamic chips + slider bounds ---------- */
            function buildDynamic() {
                var us = UNITS();
                if (!us.length) return;
                var tf = TF();
                var scope = scopeUnits();
                if (!scope.length) scope = us;

                // Type chips always list every prototype — that's how you switch scope.
                var types = [];
                us.forEach(function (u) {
                    var t = String(u.type || "").trim();
                    if (t && t !== "—" && types.indexOf(t) === -1) types.push(t);
                });
                // "1 Bedroom, 2 Bedrooms, 3 Bedrooms" — not the order rows happen to arrive in.
                types.sort(function (a, b) {
                    var na = parseInt(a, 10), nb = parseInt(b, 10);
                    if (!isNaN(na) && !isNaN(nb) && na !== nb) return na - nb;
                    return a.localeCompare(b);
                });

                // Floor chips, though, only the floors this prototype actually occupies.
                var present = {};
                scope.forEach(function (u) { present[u.floor] = true; });
                var floors = FLOORS.filter(function (f) { return present[f[0]]; });
                if (!floors.length) floors = FLOORS.slice();

                var sig = types.join("|") + "##" + floors.map(function (f) { return f[0]; }).join("|");
                if (sig !== chipsSig) {
                    chipsSig = sig;
                    var typeSec = byId("uspTypeSec"), typeWrap = byId("uspTypes");
                    if (types.length) {
                        typeSec.style.display = "";
                        typeWrap.innerHTML = types.map(function (t) {
                            return '<button type="button" class="usp-chip" data-type="' + esc(t) + '">' + esc(t) + "</button>";
                        }).join("");
                    } else { typeSec.style.display = "none"; }

                    byId("uspFloors").innerHTML =
                        '<button type="button" class="usp-chip" data-floor="">All</button>' +
                        floors.map(function (f) {
                            return '<button type="button" class="usp-chip" data-floor="' + f[0] + '">' + f[1] + "</button>";
                        }).join("");
                }
                buildFeatureSections(scope);

                // Availability options the current prototype simply doesn't have.
                var statusIn = {};
                scope.forEach(function (u) { statusIn[String(u.status || "")] = true; });
                document.querySelectorAll("#uspAvail .usp-chip").forEach(function (b) {
                    b.classList.toggle("empty", !statusIn[b.dataset.status]);
                });

                // No prices in the sheet yet → no Budget filter at all (an unbounded
                // 0 – 100 slider would silently hide every unit the moment it moved).
                var priced = scope.some(function (u) { return Number(u.priceRaw) > 0; });
                var budgetSec = byId("uspBudgetSec");
                if (budgetSec) budgetSec.style.display = priced ? "" : "none";
                if (!priced && (tf.minPrice || tf.maxPrice)) {
                    tf.minPrice = ""; tf.maxPrice = "";
                    commitHeavy(); // a stale budget was still hiding units in the 3D overlay
                }

                // Slider bounds + stepper values follow the scope, so "25 – 589 m²"
                // becomes the Admin span the moment Admin is picked.
                var bsig = (tf.types || []).slice().sort().join("|") + "##" + us.length + "##" + (priced ? "p" : "");
                if (bsig !== scopeSig) {
                    var areas = scope.map(areaOf).filter(function (v) { return v > 0; });
                    var prices = scope.map(function (u) { return Number(u.priceRaw) || 0; }).filter(function (v) { return v > 0; });
                    if (areas.length || prices.length) {
                        scopeSig = bsig;
                        if (areas.length) {
                            areaDual.setBounds(Math.floor(Math.min.apply(null, areas)), Math.ceil(Math.max.apply(null, areas)));
                            areaDual.setValues(areas);
                        }
                        if (prices.length) {
                            budgetDual.setBounds(Math.floor(Math.min.apply(null, prices)), Math.ceil(Math.max.apply(null, prices)));
                            budgetDual.setValues(prices);
                        }
                        boundsReady = true;
                    }
                }
            }

            function syncStates() {
                var tf = TF();
                document.querySelectorAll("#uspAvail .usp-chip").forEach(function (b) {
                    b.classList.toggle("active", (tf.statuses || []).indexOf(b.dataset.status) !== -1);
                });
                document.querySelectorAll("#uspTypes .usp-chip").forEach(function (b) {
                    b.classList.toggle("active", (tf.types || []).indexOf(b.dataset.type) !== -1);
                });
                document.querySelectorAll("#uspFloors .usp-chip").forEach(function (b) {
                    b.classList.toggle("active", (tf.floor || "") === b.dataset.floor);
                });
                var fsel = tf.features || {};
                document.querySelectorAll("#uspFeatureSecs .usp-chip").forEach(function (b) {
                    var sel = fsel[b.dataset.fkey];
                    b.classList.toggle("active", b.dataset.fhas ? sel === true : (Array.isArray(sel) && sel.indexOf(b.dataset.fval) !== -1));
                });
                // The units table's own Floor / Status selects show the same state.
                var tfl = byId("tableFloorFilter"); if (tfl) tfl.value = tf.floor || "";
                var tst = byId("tableStatusFilter"); if (tst) tst.value = (tf.statuses || []).length === 1 ? tf.statuses[0] : "";
                // The header's Prototype dropdown mirrors the same type filter.
                if (typeof window.syncHeaderPrototype === "function") window.syncHeaderPrototype();
                if (boundsReady) {
                    areaDual.minI.value = tf.minArea ? tf.minArea : areaDual.minI.min;
                    areaDual.maxI.value = tf.maxArea ? tf.maxArea : areaDual.maxI.max;
                    areaDual.refreshUI();
                    budgetDual.minI.value = tf.minPrice ? tf.minPrice : budgetDual.minI.min;
                    budgetDual.maxI.value = tf.maxPrice ? tf.maxPrice : budgetDual.maxI.max;
                    budgetDual.refreshUI();
                }
            }

            // Called by renderUnitsTable() so the panel always mirrors the real state.
            window.refreshUnitSearchPanel = function () {
                buildDynamic();
                syncStates();
                updateCount();
                if (isListOpen()) renderList();
            };

            /* ---------- scene switching (Floor chips double as the section view) ---------- */
            function goScene(sceneKey) {
                if (typeof currentScene !== "undefined" && sceneKey === currentScene) return; // already there
                // Only a real per-floor orbit needs a scene change. While every floor
                // maps to the exterior orbit, keep the Day / Night the visitor chose
                // instead of snapping back to Day (which also wiped the floor filter).
                var S = (typeof SCENES !== "undefined") ? SCENES : null;
                var target = S ? S[sceneKey] : null;
                var cur = S && typeof currentScene !== "undefined" ? S[currentScene] : null;
                if (!S || (target && cur && !target.unitFloor && !cur.unitFloor)) return;
                if (typeof setScene === "function") setScene(sceneKey);
                else {
                    var mb = document.querySelector('#floorMenu .floor-menu-btn[data-scene="' + sceneKey + '"]');
                    if (mb) mb.click();
                }
            }

            byId("uspAvail").addEventListener("click", function (e) {
                var b = e.target.closest(".usp-chip"); if (!b) return;
                // A status with no units can't be picked — but if the table's own
                // Status select put it on, a click here must still take it off.
                if (b.classList.contains("empty") && !b.classList.contains("active")) return;
                var tf = TF(); if (!tf.statuses) tf.statuses = [];
                var i = tf.statuses.indexOf(b.dataset.status);
                if (i === -1) tf.statuses.push(b.dataset.status); else tf.statuses.splice(i, 1);
                b.classList.toggle("active");
                applyFilters();
            });
            byId("uspTypes").addEventListener("click", function (e) {
                var b = e.target.closest(".usp-chip"); if (!b) return;
                var tf = TF(); if (!tf.types) tf.types = [];
                var i = tf.types.indexOf(b.dataset.type);
                if (i === -1) tf.types.push(b.dataset.type); else tf.types.splice(i, 1);
                b.classList.toggle("active");
                rescope();
                applyFilters();
            });
            byId("uspFloors").addEventListener("click", function (e) {
                var b = e.target.closest(".usp-chip"); if (!b) return;
                var key = b.dataset.floor || "";
                TF().floor = key;
                goScene(sceneForFloorNow(key));
                applyFilters();
            });
            // Rooms & features: a value chip toggles its value in the group's list, a Features chip toggles the requirement.
            byId("uspFeatureSecs").addEventListener("click", function (e) {
                var b = e.target.closest(".usp-chip"); if (!b) return;
                var tf = TF(); if (!tf.features) tf.features = {};
                var key = b.dataset.fkey;
                if (b.dataset.fhas) {
                    if (tf.features[key] === true) delete tf.features[key]; else tf.features[key] = true;
                } else {
                    var arr = Array.isArray(tf.features[key]) ? tf.features[key] : [];
                    var i = arr.indexOf(b.dataset.fval);
                    if (i === -1) arr.push(b.dataset.fval); else arr.splice(i, 1);
                    if (arr.length) tf.features[key] = arr; else delete tf.features[key];
                }
                applyFilters();
            });

            /* Single-select type filter, driven by the header's Prototype menu.
               "" clears it. Matches the sheet value case-insensitively so the
               hard-coded menu labels survive minor spelling differences. */
            window.setUnitTypeFilter = function (type) {
                var tf = TF();
                var want = String(type || "").trim().toLowerCase();
                var hit = "";
                if (want) {
                    UNITS().some(function (u) {
                        var t = String(u.type || "").trim();
                        if (t.toLowerCase() === want) { hit = t; return true; }
                        return false;
                    });
                    if (!hit) hit = String(type).trim();
                }
                tf.types = hit ? [hit] : [];
                rescope();
                applyFilters();
            };

            /* ---------- results list ---------- */
            function isListOpen() { return listPanel && listPanel.classList.contains("show"); }
            function renderList() {
                if (!listPanel) return;
                var rows = filtered();
                var cnt = byId("ulpCount"); if (cnt) cnt.textContent = rows.length;
                var body = byId("ulpBody"); if (!body) return;
                if (!rows.length) { body.innerHTML = '<div class="ulp-empty">No units match your filters.</div>'; return; }
                var CAP = 140;
                var shown = rows.slice(0, CAP);
                var canCompare = (typeof isUnitCompared === "function");
                var html = shown.map(function (u) {
                    var st = String(u.status || "");
                    var isC = canCompare && isUnitCompared(u.id);
                    return '<div class="ulp-row" data-id="' + esc(u.id) + '">' +
                        '<div class="ulp-name">' + esc(u.name) + '</div>' +
                        '<div class="ulp-right">' +
                        '<span class="ulp-badge ' + esc(st) + '">' + esc(u.availability || st || "—") + '</span>' +
                        (typeof isAmenityUnit === "function" && isAmenityUnit(u) ? '' : '<button class="ulp-heart' + (isC ? " active" : "") + '" type="button" data-heart="' + esc(u.id) + '">' + (isC ? "♥" : "♡") + '</button>') +
                        '</div>' +
                        '<div class="ulp-meta">' +
                        '<span>Floor <b>' + esc(u.floorRaw || u.floor || "—") + '</b></span>' +
                        '<span>Area <b>' + esc(u.area || "—") + '</b></span>' +
                        (typeof isAmenityUnit === "function" && isAmenityUnit(u) ? '' : '<span>Price <b>' + esc(u.price || "—") + '</b></span>') +
                        (u.type && u.type !== "—" ? '<span>Type <b>' + esc(u.type) + '</b></span>' : '') +
                        '</div>' +
                        '</div>';
                }).join("");
                if (rows.length > CAP) html += '<div class="ulp-more">Showing ' + CAP + ' of ' + rows.length + ' — refine filters to narrow down.</div>';
                body.innerHTML = html;
            }
            if (listPanel) {
                byId("ulpBody").addEventListener("click", function (e) {
                    var heart = e.target.closest(".ulp-heart");
                    if (heart) {
                        e.stopPropagation();
                        if (typeof toggleCompareUnit === "function") toggleCompareUnit(heart.dataset.heart, e);
                        renderList();
                        return;
                    }
                    var row = e.target.closest(".ulp-row");
                    if (row && typeof openUnitSideMenuFromTable === "function") openUnitSideMenuFromTable(row.dataset.id);
                });
                byId("ulpClose").addEventListener("click", function () { listPanel.classList.remove("show"); });
            }

            /* ---------- footer + open/close ---------- */
            byId("uspReset").addEventListener("click", function () {
                var tf = TF();
                tf.statuses = []; tf.types = []; tf.floor = "";
                tf.minArea = ""; tf.maxArea = ""; tf.minPrice = ""; tf.maxPrice = "";
                tf.search = ""; tf.status = ""; tf.features = {};
                // …and the table drawer's own controls, which share this state.
                var ts = byId("tableSearch"); if (ts) ts.value = "";
                var tfl = byId("tableFloorFilter"); if (tfl) tfl.value = "";
                var tst = byId("tableStatusFilter"); if (tst) tst.value = "";
                if (typeof RANGE_FILTERS !== "undefined") {
                    if (RANGE_FILTERS.area) RANGE_FILTERS.area.reset();
                    if (RANGE_FILTERS.price) RANGE_FILTERS.price.reset();
                }
                buildDynamic(); // back to the full all-prototypes bounds
                if (boundsReady) {
                    areaDual.minI.value = areaDual.minI.min; areaDual.maxI.value = areaDual.maxI.max; areaDual.refreshUI();
                    budgetDual.minI.value = budgetDual.minI.min; budgetDual.maxI.value = budgetDual.maxI.max; budgetDual.refreshUI();
                }
                goScene("exterior");
                applyFilters();
            });

            byId("uspView").addEventListener("click", function () {
                if (!listPanel) { var t = document.querySelector("#unitsTableToggle"); if (t) t.click(); return; }
                renderList();
                listPanel.classList.add("show");
            });
            byId("uspClose").addEventListener("click", closePanel);

            function openPanel() {
                // Desktop only (see openUnitsTable): the units drawer goes away first.
                var phone = window.matchMedia && window.matchMedia("(max-width: 700px)").matches;
                var drawer = document.getElementById("unitsTableDrawer");
                if (!phone && drawer && drawer.classList.contains("show") && typeof closeUnitsTable === "function") closeUnitsTable();
                if (window.refreshUnitSearchPanel) window.refreshUnitSearchPanel();
                panel.classList.add("show");
            }
            function closePanel() {
                panel.classList.remove("show");
                if (listPanel) listPanel.classList.remove("show");
            }
            window.toggleUnitSearch = function () {
                if (panel.classList.contains("show")) closePanel(); else openPanel();
            };
            /* A floor picked on the building itself (the floor volumes of the 3D
               overlay): the same state as the Floor chips, then straight to that
               floor's units — the panel with its list beside it. */
            window.showFloorUnits = function (key) {
                TF().floor = key || "";
                goScene(sceneForFloorNow(key)); // on a floor plan: that floor's plan, or the building view
                applyFilters();
                openPanel();
                if (listPanel) { renderList(); listPanel.classList.add("show"); }
            };
            window.closeUnitSearch = closePanel;
            window.isUnitSearchOpen = function () { return panel.classList.contains("show"); };

            if (window.refreshUnitSearchPanel) window.refreshUnitSearchPanel();
        })();
    </script>
    <script>
        /* =========================================================
           HOME SCREEN (intro hero) — markup at the top of #appRoot.
           Settings come from the site_settings table (admin → Home screen):
           video / poster / logo URLs, the texts in both languages and a few
           switches. Anything missing falls back to the defaults below (and to
           HERO_VIDEO / HERO_LOGO in config.js for the media), so the screen
           also works before the SQL file has been run. EXPLORE fades it out
           and leaves the location map, which booted underneath meanwhile.
           Skip it with  ?nohero  in the URL. Live edits from the dashboard
           arrive through window.introHero.refresh() (see LIVE UPDATES).
           The rows are also shared with the rest of the page — window.siteSettings
           and the "site:settings" event — for the floor overlay (FLOOR_LOOK).
        ========================================================= */
        (function () {
            var hero = document.getElementById("introHero");
            if (!hero) return;
            var media = document.getElementById("ihMedia");
            var video = document.getElementById("ihVideo");
            var poster = document.getElementById("ihPoster");
            var logoBox = document.getElementById("ihLogo");
            var logoImg = document.getElementById("ihLogoImg");
            var logoInline = document.getElementById("ihLogoInline");
            var logoInlineImg = document.getElementById("ihLogoInlineImg");
            var elTagline = document.getElementById("ihTagline");
            var elTitle1 = document.getElementById("ihTitle1");
            var elTitle2 = document.getElementById("ihTitle2");
            var elSub = document.getElementById("ihSub");
            var elBtn = document.getElementById("ihExplore");
            var elLang = document.getElementById("ihLang");

            var done = false; // dismissed (or switched off)
            var reduceMotion = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);

            // ----- leave: fade out, release the video, let the map take over -----
            function enter() {
                if (done) return;
                done = true;
                hero.classList.add("ih-leaving");
                document.body.classList.remove("hero-open");
                try { document.dispatchEvent(new CustomEvent("hero:done")); } catch (e) { }
                setTimeout(function () {
                    hero.classList.add("ih-off");
                    try { video.pause(); video.removeAttribute("src"); video.load(); } catch (e) { }
                }, reduceMotion ? 0 : 850);
            }
            // Wired first, so the visitor can always get past this screen.
            elBtn.addEventListener("click", enter);
            if (/(^|[?&])(nohero(=[^&]*)?|hero=0)(&|$)/.test(location.search)) { hero.classList.add("ih-off"); done = true; return; }
            document.body.classList.add("hero-open");

            var MZ = window.MAAZAR_CONFIG || {};
            var SB_URL = String(MZ.SUPABASE_URL || "").replace(/\/+$/, "");
            var SB_KEY = MZ.SUPABASE_ANON_KEY || "";
            var DEFAULTS = {
                hero_enabled: "true",
                hero_video: MZ.HERO_VIDEO ? encodeURI(MZ.HERO_VIDEO) : "",
                hero_poster: MZ.HERO_POSTER ? encodeURI(MZ.HERO_POSTER) : "",
                hero_logo: MZ.HERO_LOGO ? encodeURI(MZ.HERO_LOGO) : "",
                hero_logo_style: "auto",   // auto | dark | original | white
                hero_bg: "#786858",        // the colour the video is tinted towards (the brand colour); text flips to dark on a light one
                hero_layout: "corners",    // corners (text left, button right) | center | bottom (centred, lower part)
                hero_logo_pos: "header",   // header (top corner) | content (with the text and the button)
                hero_wash: "100",
                hero_tagline: "RESIDENTIAL",
                hero_tagline_ar: "مجمّع سكني",
                hero_title_1: "LIVE.",
                hero_title_1_ar: "عِش.",
                hero_title_2: "THRIVE.",
                hero_title_2_ar: "ازدهر.",
                hero_subtitle: "YOUR EVERYDAY *LUXURY* DESTINATION.",
                hero_subtitle_ar: "وجهتك اليومية *للرفاهية*.",
                hero_button: "EXPLORE",
                hero_button_ar: "استكشف",
            };
            var settings = {}; // rows from Supabase, key -> value
            var current = { video: null, poster: null, logo: null };

            function has(key) { return Object.prototype.hasOwnProperty.call(settings, key); }
            function val(key) {
                return has(key) ? String(settings[key] == null ? "" : settings[key]).trim() : (DEFAULTS[key] || "");
            }
            // The rows, as fetched, for the rest of the page (the floor overlay reads floors_*).
            function publish() {
                window.siteSettings = settings;
                try { document.dispatchEvent(new CustomEvent("site:settings", { detail: settings })); } catch (e) { }
            }
            // "#rgb" / "#rrggbb" (with or without the #) -> [r, g, b], else null
            function parseHex(s) {
                var m = String(s || "").trim().match(/^#?([0-9a-f]{6}|[0-9a-f]{3})$/i);
                if (!m) return null;
                var h = m[1].length === 3 ? m[1].replace(/./g, function (c) { return c + c; }) : m[1];
                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
            }
            function isAr() { return !!(window.i18n && window.i18n.lang === "ar"); }
            // Arabic text, falling back to the English value the editor typed,
            // and to the built-in Arabic only when neither was set.
            function text(key) {
                if (isAr()) {
                    var ar = has(key + "_ar") ? String(settings[key + "_ar"] == null ? "" : settings[key + "_ar"]).trim() : "";
                    if (ar) return ar;
                    if (has(key)) return val(key);
                    return DEFAULTS[key + "_ar"] || DEFAULTS[key] || "";
                }
                return val(key);
            }
            // "*word*" -> accent colour (text is escaped first)
            function rich(s) {
                var esc = String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
                return esc.replace(/\*([^*]+)\*/g, '<span class="ih-accent">$1</span>');
            }

            function renderTexts() {
                elTagline.textContent = text("hero_tagline");
                elTitle1.innerHTML = rich(text("hero_title_1"));
                elTitle2.innerHTML = rich(text("hero_title_2"));
                elSub.innerHTML = rich(text("hero_subtitle"));
                elBtn.textContent = text("hero_button") || "EXPLORE";
                elLang.textContent = isAr() ? "EN" : "AR";
            }

            function applyMedia() {
                var p = val("hero_poster"), l = val("hero_logo"), v = val("hero_video");
                if (p !== current.poster) {
                    current.poster = p;
                    if (p) { poster.src = p; poster.hidden = false; } else { poster.removeAttribute("src"); poster.hidden = true; }
                }
                if (l !== current.logo) {
                    current.logo = l;
                    if (l) { logoImg.src = l; logoInlineImg.src = l; } else { logoImg.removeAttribute("src"); logoInlineImg.removeAttribute("src"); }
                }
                var style = val("hero_logo_style");
                style = /^(auto|dark|original|white)$/.test(style) ? style : "auto";
                logoBox.className = "ih-logo" + (l ? " has-logo" : "") + " logo-" + style;
                logoInline.className = "ih-logo-inline" + (l ? " has-logo" : "") + " logo-" + style;
                hero.classList.toggle("ih-logo-content", val("hero_logo_pos") === "content");
                // background colour: the video is tinted towards it; text turns light on a dark one
                var bg = parseHex(val("hero_bg")) || parseHex(DEFAULTS.hero_bg);
                var dark = 0.2126 * bg[0] + 0.7152 * bg[1] + 0.0722 * bg[2] < 140;
                // ink and accent: shades of the brand palette (the --brand-* tokens) that read on that background
                var ink = dark ? "var(--brand-50)" : "var(--brand-900)";
                var accent = dark ? "var(--brand-200)" : "var(--brand-500)";
                hero.style.setProperty("--ih-bg", "rgb(" + bg.join(", ") + ")");
                hero.style.setProperty("--ih-bg-rgb", bg.join(", "));
                hero.style.setProperty("--ih-ink", "rgb(" + ink + ")");
                hero.style.setProperty("--ih-ink-rgb", ink);
                hero.style.setProperty("--ih-accent", "rgb(" + accent + ")");
                hero.style.setProperty("--ih-accent-rgb", accent);
                hero.classList.toggle("ih-dark", dark);
                var layout = val("hero_layout");
                hero.classList.toggle("ih-center", layout === "center");
                hero.classList.toggle("ih-bottom", layout === "bottom");
                var wash = parseFloat(val("hero_wash"));
                if (isNaN(wash)) wash = 100;
                hero.style.setProperty("--ih-wash", String(Math.min(100, Math.max(0, wash)) / 100));

                if (done) return; // the video is only (re)loaded while the screen is up
                if (v === current.video) return;
                // A late answer from Supabase must not restart a fallback video that
                // is already playing fine; it does replace one that failed to load.
                if (current.video && media.classList.contains("ih-playing") && !video.error) return;
                current.video = v;
                media.classList.remove("ih-playing");
                if (v) {
                    video.muted = true;
                    video.src = v;
                    video.load();
                    if (!reduceMotion) {
                        video.autoplay = true;
                        var pr = video.play();
                        if (pr && pr.catch) pr.catch(function () { /* autoplay blocked: poster / first frame stays */ });
                    }
                } else {
                    video.removeAttribute("src");
                    video.load();
                }
            }
            video.addEventListener("playing", function () { media.classList.add("ih-playing"); });
            video.addEventListener("error", function () { media.classList.remove("ih-playing"); });

            function applyAll() {
                if (val("hero_enabled") === "false") {
                    if (!done) { done = true; hero.classList.add("ih-off"); document.body.classList.remove("hero-open"); }
                    return;
                }
                renderTexts();
                applyMedia();
                if (!hero.classList.contains("ih-ready")) {
                    // two frames so the first styles are applied before the transitions start
                    requestAnimationFrame(function () { requestAnimationFrame(function () { hero.classList.add("ih-ready"); }); });
                }
            }

            function fetchSettings() {
                if (!SB_URL || !SB_KEY) return Promise.resolve(null);
                return fetch(SB_URL + "/rest/v1/site_settings?select=key,value", {
                    headers: { apikey: SB_KEY, Authorization: "Bearer " + SB_KEY },
                    cache: "no-store",
                })
                    .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
                    .then(function (rows) {
                        var o = {};
                        (rows || []).forEach(function (r) { if (r && r.key) o[r.key] = r.value == null ? "" : String(r.value); });
                        return o;
                    })
                    .catch(function (e) {
                        console.info("[home] site_settings unavailable — using the built-in defaults (" + (e && e.message ? e.message : e) + ")");
                        return null;
                    });
            }

            // Language: the hero keeps its own strings (the dictionary walker skips it)
            document.addEventListener("i18n:change", function () { if (!done) renderTexts(); });
            elLang.addEventListener("click", function () { if (window.i18n) window.i18n.toggle(); });

            // First paint: wait briefly for the settings so the fallback video is
            // not started and then swapped; after that, show whatever we have.
            var applied = false;
            function applyOnce(rows) {
                if (rows) { settings = rows; publish(); }
                if (applied && !rows) return;
                applied = true;
                try { applyAll(); } catch (e) { console.warn("[home]", e); enter(); }
            }
            var timer = setTimeout(function () { applyOnce(null); }, 1500);
            fetchSettings().then(function (rows) { clearTimeout(timer); applyOnce(rows); });

            window.introHero = {
                enter: enter,
                refresh: function () { fetchSettings().then(function (rows) { if (rows) { settings = rows; publish(); try { applyAll(); } catch (e) { console.warn("[home]", e); } } }); },
            };
        })();
    </script>
</body>

</html>