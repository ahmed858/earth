        <script>
            // Zoning overlay — open from the launcher, close via ✕ / Back / backdrop / Esc
            (function () {
                var launcher = document.getElementById("znLauncher");
                var overlay = document.getElementById("zoningOverlay");
                if (!launcher || !overlay) return;
                var lastFocus = null;

                function openZoning() {
                    lastFocus = document.activeElement;
                    overlay.classList.add("zn-open");
                    overlay.setAttribute("aria-hidden", "false");
                    document.addEventListener("keydown", onKey);
                    var back = overlay.querySelector(".zn-back");
                    if (back) back.focus();
                }
                function closeZoning() {
                    overlay.classList.remove("zn-open");
                    overlay.setAttribute("aria-hidden", "true");
                    document.removeEventListener("keydown", onKey);
                    if (lastFocus && lastFocus.focus) lastFocus.focus();
                }
                function onKey(e) {
                    if (e.key === "Escape" || e.key === "Esc") closeZoning();
                }

                launcher.addEventListener("click", openZoning);
                var closers = overlay.querySelectorAll("[data-zn-close]");
                for (var i = 0; i < closers.length; i++) {
                    closers[i].addEventListener("click", closeZoning);
                }

                // Action buttons: jump the 360 viewer to a scene, then close the panel.
                // Prefer the floor-menu button (it also closes the units table); fall
                // back to the global setScene(), then any element wired to that scene.
                function znGoScene(sceneKey) {
                    var btn = document.querySelector('#floorMenu .floor-menu-btn[data-scene="' + sceneKey + '"]');
                    if (btn) { btn.click(); return; }
                    if (typeof window.setScene === "function") { window.setScene(sceneKey); return; }
                    var alt = document.querySelector('[data-scene="' + sceneKey + '"]');
                    if (alt) alt.click();
                }
                var sceneBtns = overlay.querySelectorAll("[data-zn-scene]");
                for (var j = 0; j < sceneBtns.length; j++) {
                    sceneBtns[j].addEventListener("click", function () {
                        znGoScene(this.getAttribute("data-zn-scene"));
                        closeZoning();
                    });
                }
            })();
        </script>

        <script>
            (function () {
                // ⚠️ REPLACE with the sales WhatsApp number: country code first, digits
                // only — no +, spaces or dashes. KSA example: 966 + number → "9665XXXXXXXX".
                const WHATSAPP_NUMBER = (window.MAAZAR_CONFIG && window.MAAZAR_CONFIG.WHATSAPP_NUMBER) || "";

                const PROJECT_TITLE = (window.MAAZAR_PROJECT && (window.MAAZAR_PROJECT.title || window.MAAZAR_PROJECT.name)) || "Khawalid 20 Residential";
                const GENERAL_MSG = "Hello, I would like to inquire about available units at " + PROJECT_TITLE + ".";

                const launcher = document.getElementById("waLauncher");
                const panel = document.getElementById("waPanel");
                const closeBtn = document.getElementById("waClose");
                const bubble = document.getElementById("waBubble");
                const timeEl = document.getElementById("waTime");
                const openBtn = document.getElementById("waOpenBtn");
                const copyBtn = document.getElementById("waCopyBtn");
                if (!launcher || !panel) return;

                let currentMsg = GENERAL_MSG;

                function setMessage(msg) {
                    currentMsg = msg;
                    if (bubble) bubble.textContent = msg;
                    if (timeEl)
                        timeEl.textContent = new Date().toLocaleTimeString([], {
                            hour: "2-digit",
                            minute: "2-digit",
                        });
                }

                function buildUnitMsg(u) {
                    const floor = u.floorRaw || u.floor || "—";
                    const price = Number(u.priceRaw) > 0 ? u.price || "—" : "On request";
                    return [
                        "Hello, I'm interested in the following unit at " + PROJECT_TITLE + ":",
                        "",
                        "🏢 " + PROJECT_TITLE + " — Unit Details",
                        "",
                        "📋 Unit: " + (u.name || "—"),
                        "🏷️ Type: " + (u.type || "—"),
                        "✅ Status: " + (u.availability || u.status || "—"),
                        "📐 Area: " + (u.area || "—"),
                        "🏬 Floor: " + floor,
                        "💰 Price: " + price,
                        "",
                        "Please provide more information.",
                    ].join("\n");
                }

                function openPanel() {
                    panel.classList.add("wa-open");
                    launcher.classList.add("wa-hidden");
                }
                function closePanel() {
                    panel.classList.remove("wa-open");
                    launcher.classList.remove("wa-hidden");
                }

                function openWhatsApp() {
                    const url =
                        "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(currentMsg);
                    window.open(url, "_blank", "noopener");
                }

                async function copyMsg() {
                    const flash = (txt) => {
                        if (!copyBtn) return;
                        const b = copyBtn.querySelector("b");
                        const old = b.textContent;
                        b.textContent = txt;
                        setTimeout(() => (b.textContent = old), 1500);
                    };
                    try {
                        await navigator.clipboard.writeText(currentMsg);
                        flash("Copied!");
                    } catch (_) {
                        const ta = document.createElement("textarea");
                        ta.value = currentMsg;
                        ta.style.position = "fixed";
                        ta.style.opacity = "0";
                        document.body.appendChild(ta);
                        ta.select();
                        try {
                            document.execCommand("copy");
                            flash("Copied!");
                        } catch (e) { }
                        ta.remove();
                    }
                }

                launcher.addEventListener("click", () => {
                    setMessage(GENERAL_MSG);
                    openPanel();
                });
                closeBtn && closeBtn.addEventListener("click", closePanel);
                openBtn && openBtn.addEventListener("click", openWhatsApp);
                copyBtn && copyBtn.addEventListener("click", copyMsg);

                // Open the panel pre-filled with a specific unit's details.
                window.openWaForUnit = function (unit) {
                    if (!unit) return;
                    setMessage(buildUnitMsg(unit));
                    openPanel();
                };

                // "Contact Sales on WhatsApp" button inside the unit detail panel.
                const sideBtn = document.getElementById("sideWhatsApp");
                if (sideBtn) {
                    sideBtn.addEventListener("click", () => {
                        try {
                            if (typeof currentUnit !== "undefined" && currentUnit) {
                                if (typeof closeUnitSideMenu === "function") closeUnitSideMenu();
                                window.openWaForUnit(currentUnit);
                            } else {
                                setMessage(GENERAL_MSG);
                                openPanel();
                            }
                        } catch (e) {
                            console.error(e);
                        }
                    });
                }

                setMessage(GENERAL_MSG);
            })();
        </script>

        <!-- ===================== ARABIC TRANSLATION ENGINE ===================== -->
        <script>
            /* The project's texts and logos (projects.js). The markup above is written for the default
               project (Khawalid 20); this swaps in the project this page shows, and hides the switches
               for scenes it does not have (the header's Day / Night segment, the zoning panel's buttons). */
            (function () {
                var P = window.MAAZAR_PROJECT;
                if (!P) return;
                var name = P.name || "";
                var el = document.getElementById("ufAssistantName");
                if (el && name) el.textContent = name + " Assistant";
                el = document.getElementById("waSubName");
                if (el && name) el.textContent = name + " · Typically replies instantly";
                document.querySelectorAll("[data-project-logo]").forEach(function (span) {
                    if (P.logoClass) span.className = P.logoClass;
                    var img = span.querySelector("img");
                    if (img && P.logo) { img.src = encodeURI(P.logo); img.alt = name; }
                });
                var scenes = (typeof SCENES !== "undefined" && SCENES) || {};
                document.querySelectorAll("[data-scene], [data-zn-scene]").forEach(function (b) {
                    var k = b.getAttribute("data-scene") || b.getAttribute("data-zn-scene");
                    if (k && !scenes[k]) b.style.display = "none";
                });
                if (Object.keys(scenes).length < 2) document.body.classList.add("one-scene");
            })();
        </script>
        <script>
            (function () {
                /* English -> Arabic dictionary for every static UI label. Dynamic data
                   (unit names, prices, sheet values) is intentionally left untouched. */
                const AR = {
                    // Top controls / floating buttons
                    Tutorial: "الدليل",
                    Units: "الوحدات",
                    "Hide Units": "إخفاء الوحدات",
                    "Show Units": "إظهار الوحدات",
                    "Hide Floors": "إخفاء الطوابق",
                    "Show Floors": "إظهار الطوابق",
                    Gallery: "المعرض",
                    // Units table
                    "Excel Sheet": "جدول البيانات",
                    "Units Table": "جدول الوحدات",
                    "Reset Filters": "إعادة ضبط الفلاتر",
                    Floor: "الطابق",
                    Status: "الحالة",
                    "All Floors": "كل الطوابق",
                    "All Status": "كل الحالات",
                    Available: "متاحة",
